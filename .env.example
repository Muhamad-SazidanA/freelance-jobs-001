# ==============================================================================
# SolusiAplikasi.Id - Environment Configuration Example
# ==============================================================================

# Site URL (Single domain, NO subdomain)
SITE_URL=https://solusiaplikasi.id

# WordPress Installation located at /solution/
WP_URL=https://solusiaplikasi.id/solution
WP_GRAPHQL_URL=https://solusiaplikasi.id/solution/graphql
WP_BUILD_TOKEN=your_wp_graphql_secret_build_token
USE_MOCK_DATA=true

# WordPress REST API for Form Submissions (Leads) at /solution/wp-json/...
PUBLIC_WP_REST_API_URL=https://solusiaplikasi.id/solution/wp-json/solusi/v1/lead

# WordPress Admin Security (Hidden WP-Admin Secret Key)
WP_ADMIN_SECRET_KEY=your_secret_admin_access_token

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Analytics & Tracking
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GTM_ID=GTM-XXXXXXX
PUBLIC_META_PIXEL_ID=

# WhatsApp Business Direct Link
PUBLIC_WHATSAPP_NUMBER=6282110009519
PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Halo PT Solusi Aplikasi Integrasi (SAI), saya tertarik dengan solusi IT dan layanan Anda. Mohon info lebih lanjut."

# Cloudflare API (Used during CI/CD deploy for Cache Purge)
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_cache_purge_token

# FTPS Credentials (Used in GitHub Actions Secrets)
# FTP_SERVER=ftp.origin.solusiaplikasi.id
# FTP_USERNAME=deploy@solusiaplikasi.id
# FTP_PASSWORD=your_ftps_deploy_password
