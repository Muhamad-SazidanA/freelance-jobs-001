---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AnalyticsDashboardView from '@/components/admin/AnalyticsDashboardView';
import { resolveAdminPage } from '@/lib/admin-page';
import { getAdminLandingPages, getAdminPosts } from '@/lib/cms';

export const prerender = false;

const ctx = resolveAdminPage(Astro);
if (ctx instanceof Response) {
  return ctx;
}

const [{ posts }, { pages: landingPages }] = await Promise.all([getAdminPosts(), getAdminLandingPages()]);
---

<AdminLayout
  title="Dashboard Admin | SolusiAplikasi.id"
  description="Dashboard analitik konten & kampanye PT Solusi Aplikasi Integrasi."
>
  <AnalyticsDashboardView
    client:load
    user={ctx.session}
    posts={posts}
    landingPages={landingPages}
    dbConfigured={ctx.dbConfigured}
  />
</AdminLayout>
