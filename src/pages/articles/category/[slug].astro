---
import PageLayout from '@/layouts/PageLayout.astro';
import { getAllPosts } from '@/content/loaders/wp-graphql-loader';
import type { Post } from '@/types/content';
import { generateBreadcrumbSchema } from '@/lib/schema-ld';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const categoriesMap = new Map<string, { category: { id: string; name: string; slug: string }; posts: Post[] }>();

  posts.forEach((post) => {
    post.categories?.forEach((cat) => {
      if (!categoriesMap.has(cat.slug)) {
        categoriesMap.set(cat.slug, {
          category: cat,
          posts: [post],
        });
      } else {
        categoriesMap.get(cat.slug)!.posts.push(post);
      }
    });
  });

  return Array.from(categoriesMap.values()).map(({ category, posts: catPosts }) => ({
    params: { slug: category.slug },
    props: { category, posts: catPosts },
  }));
}

interface Props {
  category: { id: string; name: string; slug: string };
  posts: Post[];
}

const { category, posts } = Astro.props as Props;

const breadcrumbs = [
  { name: 'Articles', url: '/articles' },
  { name: `Kategori: ${category.name}`, url: `/articles/category/${category.slug}` },
];

const schema = [generateBreadcrumbSchema(breadcrumbs)];
---

<PageLayout
  title={`Kategori: ${category.name} | SolusiAplikasi.id`}
  description={`Kumpulan artikel dan panduan teknis dengan kategori ${category.name}.`}
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="mb-10">
      <span class="text-xs font-semibold text-sky-600 uppercase tracking-wider">Kategori Artikel</span>
      <h1 class="text-3xl font-extrabold text-slate-900 mt-1">{category.name}</h1>
      <p class="text-sm text-slate-600 mt-2">Menampilkan {posts.length} artikel terbit.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post: Post) => (
        <article class="flex flex-col border border-slate-200 rounded-lg overflow-hidden bg-white hover:shadow-lg transition-shadow">
          <a href={`/articles/${post.slug}`} class="block aspect-video overflow-hidden bg-slate-100">
            <img
              src={post.featuredImage.url}
              alt={post.featuredImage.alt}
              class="w-full h-full object-cover"
              loading="eager" decoding="async"
            />
          </a>

          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h2 class="text-lg font-bold text-slate-900 mb-2 leading-snug">
                <a href={`/articles/${post.slug}`} class="hover:text-sky-600 transition-colors">
                  {post.title}
                </a>
              </h2>
              <p class="text-sm text-slate-600 line-clamp-3 mb-4">{post.excerpt}</p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
              <span>{post.author.name}</span>
              <time datetime={post.publishedAt}>
                {new Date(post.publishedAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12">
      <a href="/articles" class="text-xs font-semibold text-sky-600 hover:underline">
        &larr; Kembali ke Semua Artikel
      </a>
    </div>
  </div>
</PageLayout>
