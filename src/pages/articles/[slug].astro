---
import ArticleDetailView from '@/components/articles/ArticleDetailView.astro';
import { getPostBySlug, getPublishedPosts, legacyMockToRecord } from '@/lib/cms';
import mockPosts from '@/content/mock/posts.json';
import type { Post as LegacyPost } from '@/types/content';

export const prerender = false;

const slug = Astro.params.slug || '';
let { post, fromDb } = await getPostBySlug(slug, false);

if (!post) {
  const mockList = mockPosts as unknown as LegacyPost[];
  const mockIdx = mockList.findIndex((item) => item.slug === slug);
  if (mockIdx !== -1) {
    post = legacyMockToRecord(mockList[mockIdx], mockIdx);
    fromDb = false;
  }
}

if (!post) {
  Astro.response.status = 404;
}

const { posts: publishedPool } = await getPublishedPosts(10);
const relatedPosts = post
  ? publishedPool.filter((item) => item.slug !== post.slug).slice(0, 3)
  : [];
---

{post ? (
  <ArticleDetailView
    post={post}
    relatedPosts={relatedPosts}
    isPreview={false}
    fromDb={fromDb}
  />
) : (
  <html lang="id">
    <head>
      <meta charset="utf-8" />
      <title>Artikel Tidak Ditemukan | SolusiAplikasi.id</title>
    </head>
    <body style="font-family:system-ui,sans-serif;display:grid;place-items:center;min-height:100vh;background:#f8fafc;margin:0">
      <div style="text-align:center;padding:2rem">
        <h1 style="font-size:2rem;color:#0f172a;margin-bottom:.5rem">404 &bull; Artikel Tidak Ditemukan</h1>
        <p style="color:#64748b;margin-bottom:1.5rem">Artikel yang Anda cari tidak tersedia atau masih berstatus draft.</p>
        <a href="/articles" style="padding:.75rem 1.25rem;background:#006cb7;color:#fff;border-radius:.75rem;text-decoration:none;font-weight:700">Lihat Semua Artikel</a>
      </div>
    </body>
  </html>
)}
