---
import PageLayout from '@/layouts/PageLayout.astro';
import ContactForm from '@/components/forms/ContactForm';
import { generateBreadcrumbSchema } from '@/lib/schema-ld';

const breadcrumbs = [
  { name: 'Request Demo', url: '/request-demo' },
];

const schema = [generateBreadcrumbSchema(breadcrumbs)];
---

<PageLayout
  title="Request Demo & Diskusikan Solusi Anda | SolusiAplikasi.id"
  description="Siap mengotomatisasi bisnis Anda dengan kekuatan AI? Diskusikan solusi Hyperautomation, AI OCR, RPA, dan integrasi enterprise bersama tim kami."
  schema={schema}
>
  <section class="relative bg-white py-10 sm:py-14 md:py-16 lg:py-20 overflow-hidden">
    <!-- Top-right ambient blue radial glow matching Figma design -->
    <div class="absolute -top-24 right-0 w-[550px] h-[550px] bg-radial from-blue-100/50 via-blue-50/20 to-transparent blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-start">
        
        <!-- Left Column: Heading, Subtitle & Office Map Card -->
        <div class="lg:col-span-6 flex flex-col justify-between space-y-6 sm:space-y-8">
          <div>
            <h1 class="text-3xl sm:text-4xl lg:text-[40px] xl:text-[44px] font-extrabold text-[#0066FF] tracking-tight leading-[1.18] mb-4 sm:mb-5">
              Siap Mengotomatisasi Bisnis Anda dengan Kekuatan AI?
            </h1>
            <p class="text-sm sm:text-base text-[#0066FF] font-medium leading-relaxed max-w-xl">
              Kami menghadirkan solusi Hyperautomation, AI/ML, dan Data Transformation terbaik dari mitra teknologi global, untuk membantu bisnis Anda tumbuh lebih cepat dan efisien.
            </p>
          </div>

          <!-- Location Map Snapshot Card matching Image 1 -->
          <div class="w-full rounded-2xl sm:rounded-3xl overflow-hidden border border-slate-200/90 shadow-md bg-slate-50 relative group aspect-[4/3] sm:aspect-[16/11]">
            <iframe
              src="https://maps.google.com/maps?q=United+Teknologi+Integrasi+PT,+Jl.+Siantar+No.18,+Cideng,+Gambir,+Jakarta+Pusat&t=&z=16&ie=UTF8&iwloc=&output=embed"
              class="w-full h-full border-0"
              loading="eager" decoding="async"
              referrerpolicy="no-referrer-when-downgrade"
              title="Peta Lokasi Kantor PT Solusi Aplikasi Integrasi / UTI"
            ></iframe>

            <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 bg-white/95 backdrop-blur-sm border border-slate-200/80 rounded-xl p-3 sm:p-3.5 shadow-md flex items-center justify-between gap-3">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#0066FF] flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <p class="text-xs font-bold text-slate-900 truncate">PT Solusi Aplikasi Integrasi / UTI</p>
                  <p class="text-[11px] text-slate-500 truncate">Jl. Siantar No.18, Cideng, Gambir, Jakarta Pusat</p>
                </div>
              </div>
              <a
                href="https://maps.google.com/?q=Jl.+Siantar+No.18,+Cideng,+Gambir,+Jakarta+Pusat"
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 px-2.5 py-1.5 text-[11px] font-semibold text-[#0066FF] bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors"
              >
                Buka Peta &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Form Card matching Image 1 -->
        <div class="lg:col-span-6">
          <ContactForm client:load formType="demo" />
        </div>

      </div>
    </div>
  </section>
</PageLayout>
