---
import PageLayout from '@/layouts/PageLayout.astro';
import { generateBreadcrumbSchema } from '@/lib/schema-ld';

const breadcrumbs = [
  { name: 'Request Demo', url: '/request-demo' },
];

const schema = [generateBreadcrumbSchema(breadcrumbs)];
---

<PageLayout
  title="Request Demo & Konsultasi Solusi Otomasi | SolusiAplikasi.id"
  description="Jadwalkan sesi demo gratis bersama konsultan PT Solusi Aplikasi Integrasi (SAI). Diskusikan solusi AI OCR, RPA, DMS, dan otomatisasi alur kerja enterprise Anda."
  schema={schema}
>
  <!-- =========================================================================
       HERO & FORM SECTION: ROYAL BLUE SPLIT (MATCHING CTA REFERENCE)
       ========================================================================= -->
  <section class="relative w-full overflow-hidden">
    <!-- Upper Spacer: White area where the top of the card floats into -->
    <div class="bg-white h-8 sm:h-12 md:h-16 lg:h-20"></div>

    <!-- Blue Body Section: Solid Royal Blue matching reference (#3a5ae8) -->
    <div class="bg-[#3a5ae8] text-white pt-6 md:pt-4 pb-14 sm:pb-20 lg:pb-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

          <!-- Left Column: Copywriting & Value Propositions -->
          <div class="lg:col-span-6 text-left pt-2 md:pt-6 lg:pt-8 pb-4 lg:pb-8">
            <!-- Pill Badge -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-blue-100 text-xs font-semibold uppercase tracking-wider mb-4 backdrop-blur-sm shadow-xs">
              <span class="w-2 h-2 rounded-full bg-sky-300 animate-pulse"></span>
              <span>Jadwalkan Demo Gratis</span>
            </div>

            <!-- Main Heading -->
            <h1 class="text-2xl sm:text-3xl lg:text-[38px] xl:text-[40px] font-bold text-white tracking-tight leading-[1.2] mb-3 sm:mb-4">
              <span class="sm:block">Optimalkan Bisnis Anda dengan</span>
              <span class="sm:block">Digital Automation</span>
            </h1>

            <!-- Subtitle -->
            <p class="text-xs sm:text-sm lg:text-[15px] text-blue-100/95 leading-relaxed max-w-lg mb-6 sm:mb-8 font-normal">
              Konsultasikan alur kerja perusahaan Anda dengan tim ahli SAI. Kami siap menganalisis proses bisnis dan mendemonstrasikan implementasi solusi terbaik secara langsung.
            </p>

            <!-- 3 Value Checkpoints -->
            <div class="space-y-3.5 pt-1">
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-lg bg-white/15 border border-white/25 flex items-center justify-center shrink-0 mt-0.5 text-sky-200">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs sm:text-sm font-bold text-white leading-snug">Demo Langsung Sesuai Dokumen Anda</h4>
                  <p class="text-[11px] sm:text-xs text-blue-100/85 leading-relaxed">Uji akurasi ekstraksi langsung pada format faktur, invoice, atau PO riil milik perusahaan Anda.</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-lg bg-white/15 border border-white/25 flex items-center justify-center shrink-0 mt-0.5 text-sky-200">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs sm:text-sm font-bold text-white leading-snug">Analisis Kebutuhan &amp; Estimasi ROI</h4>
                  <p class="text-[11px] sm:text-xs text-blue-100/85 leading-relaxed">Dapatkan simulasi penghematan waktu operasional hingga 90% serta efisiensi biaya kerja.</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-lg bg-white/15 border border-white/25 flex items-center justify-center shrink-0 mt-0.5 text-sky-200">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs sm:text-sm font-bold text-white leading-snug">Integrasi Fleksibel &amp; Standar Keamanan</h4>
                  <p class="text-[11px] sm:text-xs text-blue-100/85 leading-relaxed">Mendukung koneksi ke SAP, Oracle, ERP lokal, cloud maupun on-premise sesuai ISO 27001.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Elevated White Form Card matching CTA Reference -->
          <div class="lg:col-span-6 -mt-8 sm:-mt-12 md:-mt-16 lg:-mt-20 flex justify-center lg:justify-end relative z-10">
            <div class="w-full max-w-[480px] bg-white rounded-xl sm:rounded-2xl shadow-2xl border border-slate-100/90 p-5 sm:p-6 lg:p-7 text-slate-800">
              <!-- Card Header -->
              <h2 class="text-base sm:text-lg font-bold text-[#3a5ae8] mb-1 tracking-tight">
                Diskusikan Kebutuhan anda
              </h2>
              <p class="text-[11px] text-slate-500 mb-3.5">
                Isi formulir di bawah ini untuk menjadwalkan sesi demo gratis bersama konsultan SAI.
              </p>

              <!-- Consultation Form -->
              <form id="request-demo-page-form" class="space-y-3">
                <!-- Honeypot for Bot Protection -->
                <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

                <!-- Row 1: Nama & Email -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label for="rd-name" class="block text-[11px] font-semibold text-slate-700 mb-1">
                      Nama
                    </label>
                    <input
                      id="rd-name"
                      type="text"
                      name="name"
                      placeholder="Nama lengkap Anda"
                      class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-[#fbfcfd] focus:bg-white text-xs sm:text-[13px] text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-[#3a5ae8] focus:ring-1 focus:ring-[#3a5ae8] transition-all"
                    />
                  </div>

                  <div>
                    <label for="rd-email" class="block text-[11px] font-semibold text-slate-700 mb-1">
                      Email <span class="text-red-500">*</span>
                    </label>
                    <input
                      id="rd-email"
                      type="email"
                      name="email"
                      required
                      placeholder="anda@perusahaan.com"
                      class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-[#fbfcfd] focus:bg-white text-xs sm:text-[13px] text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-[#3a5ae8] focus:ring-1 focus:ring-[#3a5ae8] transition-all"
                    />
                  </div>
                </div>

                <!-- Row 2: WhatsApp (+62 Flag) & Nama Perusahaan -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label for="rd-phone" class="block text-[11px] font-semibold text-slate-700 mb-1">
                      Nomor WhatsApp <span class="text-red-500">*</span>
                    </label>
                    <div class="flex items-center rounded-lg border border-slate-200 bg-[#fbfcfd] focus-within:bg-white focus-within:border-[#3a5ae8] focus-within:ring-1 focus-within:ring-[#3a5ae8] transition-all overflow-hidden">
                      <div class="flex items-center gap-1.5 pl-2.5 pr-2 py-2 bg-slate-50 border-r border-slate-200 select-none shrink-0">
                        <!-- Indonesia Flag Icon 🇮🇩 -->
                        <svg class="w-3.5 h-2.5 rounded-2xs border border-slate-300 shadow-2xs" viewBox="0 0 24 16" fill="none" aria-hidden="true">
                          <rect width="24" height="8" fill="#e11d48"/>
                          <rect y="8" width="24" height="8" fill="#ffffff"/>
                        </svg>
                        <span class="text-[11px] font-medium text-slate-700">+62</span>
                        <svg class="w-2 h-2 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <input
                        id="rd-phone"
                        type="tel"
                        name="phone"
                        required
                        placeholder="8123456789"
                        class="w-full px-2.5 py-2 text-xs sm:text-[13px] text-slate-800 placeholder:text-slate-400 focus:outline-none bg-transparent"
                      />
                    </div>
                  </div>

                  <div>
                    <label for="rd-company" class="block text-[11px] font-semibold text-slate-700 mb-1">
                      Nama Perusahaan <span class="text-red-500">*</span>
                    </label>
                    <input
                      id="rd-company"
                      type="text"
                      name="company"
                      required
                      placeholder="Nama perusahaan Anda"
                      class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-[#fbfcfd] focus:bg-white text-xs sm:text-[13px] text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-[#3a5ae8] focus:ring-1 focus:ring-[#3a5ae8] transition-all"
                    />
                  </div>
                </div>

                <!-- Row 3: Solusi Dibutuhkan -->
                <div>
                  <label for="rd-product" class="block text-[11px] font-semibold text-slate-700 mb-1">
                    Solusi Dibutuhkan <span class="text-red-500">*</span>
                  </label>
                  <div class="relative">
                    <select
                      id="rd-product"
                      name="product"
                      required
                      class="w-full appearance-none px-3 py-2 pr-8 rounded-lg border border-slate-200 bg-[#fbfcfd] focus:bg-white text-xs sm:text-[13px] text-slate-700 focus:outline-none focus:border-[#3a5ae8] focus:ring-1 focus:ring-[#3a5ae8] transition-all cursor-pointer"
                    >
                      <option value="" disabled selected>Pilih solusi yang dibutuhkan</option>
                      <option value="nanonets">Intelligent Document Processing (Nanonets)</option>
                      <option value="cyclone">Robotic Process Automation (Cyclone)</option>
                      <option value="docuflo">Document Management System (DocuFlo)</option>
                      <option value="syclus">Account Payable Automation (Syclus)</option>
                      <option value="spensify">Expense Management System (Spensify)</option>
                      <option value="multi">Konsultasi Solusi Multi-Platform</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-slate-400">
                      <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                      </svg>
                    </div>
                  </div>
                </div>

                <!-- Row 4: Kebutuhan Textarea -->
                <div>
                  <label for="rd-message" class="block text-[11px] font-semibold text-slate-700 mb-1">
                    Kebutuhan
                  </label>
                  <textarea
                    id="rd-message"
                    name="message"
                    rows="2"
                    placeholder="Jelaskan kebutuhan Anda, tantangan yang dihadapi, dan gambaran operasional bisnis Anda."
                    class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-[#fbfcfd] focus:bg-white text-xs sm:text-[13px] text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-[#3a5ae8] focus:ring-1 focus:ring-[#3a5ae8] transition-all resize-none min-h-[58px]"
                  ></textarea>
                </div>

                <!-- Status Alert Feedback -->
                <div id="rd-status-box" class="hidden p-2.5 rounded-lg text-xs leading-relaxed" role="alert"></div>

                <!-- Submit Button -->
                <div class="pt-1">
                  <button
                    type="submit"
                    id="rd-submit-btn"
                    class="w-full py-2.5 sm:py-3 px-5 rounded-lg sm:rounded-xl bg-[#3a5ae8] hover:bg-[#2e4ecf] active:bg-[#2541b3] text-white font-semibold text-xs sm:text-sm shadow-md shadow-blue-600/25 transition-all duration-200 cursor-pointer text-center"
                  >
                    Kirim
                  </button>
                </div>
              </form>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       OFFICE INFO & ULTRA-FAST LAZY MAP SECTION
       ========================================================================= -->
  <section class="bg-slate-50/70 border-t border-slate-100 py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Title Header -->
      <div class="max-w-xl text-left mb-8 sm:mb-10">
        <p class="text-xs font-semibold tracking-wider uppercase text-[#0866D3] mb-1.5">
          Lokasi Kantor Kami
        </p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight">
          Kunjungi Kantor PT Solusi Aplikasi Integrasi
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
          Tim konsultan kami siap menyambut dan mendiskusikan alur transformasi digital bisnis Anda secara langsung.
        </p>
      </div>

      <!-- 2-Column Grid: Office Info Details & Ultra-Fast Lazy Google Maps -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-stretch">
        
        <!-- Left Column: Contact Cards -->
        <div class="lg:col-span-5 flex flex-col justify-between space-y-4">
          <div class="bg-white border border-slate-200/80 rounded-2xl p-5 sm:p-6 shadow-xs space-y-4">
            <!-- Address -->
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#0866D3] flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wide">Alamat Kantor</h4>
                <p class="text-xs sm:text-sm text-slate-600 mt-0.5 leading-relaxed font-normal">
                  Jl. Siantar No.18, Cideng, Gambir<br />
                  Jakarta Pusat, DKI Jakarta 10150
                </p>
              </div>
            </div>

            <!-- WhatsApp & Phone -->
            <div class="flex items-start gap-3 pt-2 border-t border-slate-100">
              <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
                </svg>
              </div>
              <div>
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wide">Kontak Langsung</h4>
                <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
                  <strong>WhatsApp:</strong>{' '}
                  <a
                    href="https://wa.me/6282110009519?text=Halo%20PT%20Solusi%20Aplikasi%20Integrasi%20(SAI)%2C%20saya%20ingin%20jadwalkan%20demo%20produk."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#0866D3] hover:underline font-semibold"
                  >
                    +62 821-1000-9519
                  </a>
                </p>
                <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
                  <strong>Phone:</strong> +62 21 350-6050 (Hunting)
                </p>
                <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
                  <strong>Email:</strong>{' '}
                  <a href="mailto:sales@solusiaplikasi.id" class="text-[#0866D3] hover:underline">
                    sales@solusiaplikasi.id
                  </a>
                </p>
              </div>
            </div>

            <!-- Jam Operasional -->
            <div class="flex items-start gap-3 pt-2 border-t border-slate-100">
              <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#0866D3] flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wide">Jam Operasional</h4>
                <p class="text-xs sm:text-sm text-slate-600 mt-0.5">Senin – Jumat (09.00 – 17.00 WIB)</p>
              </div>
            </div>
          </div>

          <!-- Direct Google Maps App Button -->
          <a
            href="https://maps.google.com/?q=United+Teknologi+Integrasi+PT,+Jl.+Siantar+No.18,+Cideng,+Gambir,+Jakarta+Pusat"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-white hover:bg-slate-50 border border-slate-200/90 text-slate-800 text-xs sm:text-sm font-semibold rounded-xl shadow-2xs hover:shadow-xs transition-all text-center"
          >
            <span>Buka di Aplikasi Google Maps</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Right Column: Ultra-Fast Lazy Loading Google Maps Embed -->
        <div class="lg:col-span-7 flex flex-col">
          <div class="w-full h-full min-h-[300px] sm:min-h-[340px] rounded-2xl overflow-hidden border border-slate-200/90 shadow-xs bg-slate-100 relative">
            <!-- Lazy-loading iframe: Zero blocking script on initial render -->
            <iframe
              src="https://maps.google.com/maps?q=United+Teknologi+Integrasi+PT,+Jl.+Siantar+No.18,+Cideng,+Gambir,+Jakarta+Pusat&t=&z=16&ie=UTF8&iwloc=&output=embed"
              class="w-full h-full min-h-[300px] sm:min-h-[340px] border-0"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer-when-downgrade"
              title="Peta Lokasi Kantor PT Solusi Aplikasi Integrasi / UTI"
            ></iframe>
          </div>
        </div>

      </div>
    </div>
  </section>
</PageLayout>

<!-- Client Script for Form Submission Handling -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('request-demo-page-form');
    if (!form) return;

    const statusBox = document.getElementById('rd-status-box');
    const submitBtn = document.getElementById('rd-submit-btn');

    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const name = form.querySelector('input[name="name"]')?.value.trim() || '';
      const email = form.querySelector('input[name="email"]')?.value.trim();
      const phone = form.querySelector('input[name="phone"]')?.value.trim();
      const company = form.querySelector('input[name="company"]')?.value.trim();
      const productSelect = form.querySelector('select[name="product"]');
      const product = productSelect ? productSelect.value : '';
      const productLabel = productSelect && productSelect.selectedIndex >= 0 ? productSelect.options[productSelect.selectedIndex].text : '';
      const messageText = form.querySelector('textarea[name="message"]')?.value.trim() || '';

      if (!email || !phone || !company || !product) {
        if (statusBox) {
          statusBox.className = 'p-2.5 rounded-lg text-xs leading-relaxed bg-amber-50 border border-amber-200 text-amber-800 block';
          statusBox.textContent = 'Mohon lengkapi semua kolom yang bertanda bintang (*).';
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <svg class="animate-spin -ml-1 mr-2 h-3.5 w-3.5 text-white inline" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Mengirim...</span>
        `;
      }

      // Save to localStorage for Admin Dashboard
      try {
        const stored = localStorage.getItem('solusi_leads_data');
        const leads = stored ? JSON.parse(stored) : [];
        leads.unshift({
          id: `lead-${Date.now()}`,
          name: name || email.split('@')[0],
          email: email,
          phone: phone.startsWith('+') ? phone : `+62${phone.replace(/^0+/, '')}`,
          company: company,
          position: 'Lead Request Demo Page',
          requirements: `[Solusi: ${productLabel}] ${messageText}`,
          message: `[Perusahaan: ${company}] [Solusi: ${productLabel}] ${messageText}`,
          sourceUrl: window.location.href,
          createdAt: new Date().toISOString(),
          status: 'Baru',
        });
        localStorage.setItem('solusi_leads_data', JSON.stringify(leads));
      } catch (err) {
        console.warn('Failed to store lead in localStorage:', err);
      }

      // Send Lead Notification to sales@solusiaplikasi.id via WP REST API
      try {
        const restEndpoint = 'https://solusiaplikasi.id/solution/wp-json/solusi/v1/lead';
        await fetch(restEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: name || email,
            email: email,
            phone: phone,
            company: company,
            position: 'Lead Request Demo Page',
            requirements: `[Solusi: ${productLabel}] ${messageText}`,
            sourceUrl: window.location.href,
          }),
        });
      } catch {
        // Fallback delivery via FormSubmit
        try {
          await fetch('https://formsubmit.co/ajax/sales@solusiaplikasi.id', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              _subject: `[Lead Request Demo Baru] ${name || email} - ${company}`,
              _template: 'table',
              _captcha: 'false',
              Nama: name || '-',
              Email: email,
              'No. WhatsApp': `+62 ${phone}`,
              Perusahaan: company,
              'Solusi Dibutuhkan': productLabel,
              Kebutuhan: messageText || '-',
              'Halaman Sumber': window.location.href,
            }),
          });
        } catch (fallbackErr) {
          console.warn('Fallback error:', fallbackErr);
        }
      }

      if (statusBox) {
        statusBox.className = 'p-3 rounded-lg text-xs leading-relaxed bg-emerald-50 border border-emerald-200 text-emerald-800 block';
        statusBox.innerHTML = `
          <strong>Terima kasih${name ? ', ' + name : ''}!</strong> Permintaan demo Anda telah berhasil terkirim. Tim konsultan SAI akan segera menghubungi Anda 1x24 jam.
        `;
      }

      form.reset();

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<span>Kirim</span>`;
      }
    });
  });
</script>
