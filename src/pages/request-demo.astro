---
import PageLayout from '@/layouts/PageLayout.astro';
import { generateBreadcrumbSchema } from '@/lib/schema-ld';

const breadcrumbs = [
  { name: 'Request Demo', url: '/request-demo' },
];

const schema = [generateBreadcrumbSchema(breadcrumbs)];
---

<PageLayout
  title="Request Demo & Konsultasi Solusi Otomasi | SolusiAplikasi.id"
  description="Jadwalkan sesi demo gratis bersama konsultan PT Solusi Aplikasi Integrasi (SAI). Diskusikan solusi AI OCR, RPA, DMS, dan otomatisasi alur kerja enterprise Anda."
  schema={schema}
>
  <!-- =========================================================================
       NORMAL TWO-COLUMN LAYOUT:
       - Left Column: Kata-kata (Heading, Deskripsi, Kontak) & Maps di bawahnya
       - Right Column: Form Konsultasi / Demo (Desain Card dari CTA)
       ========================================================================= -->
  <section class="relative bg-white py-10 sm:py-14 md:py-16 lg:py-20 overflow-hidden">
    <!-- Subtle Ambient Glow -->
    <div class="absolute -top-24 right-0 w-[500px] h-[500px] bg-blue-50/60 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-1/2 -left-32 w-[400px] h-[400px] bg-slate-50 rounded-full blur-2xl pointer-events-none -z-10"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-8 lg:gap-x-12 gap-y-6 sm:gap-y-8 lg:gap-y-0 items-start">
        
        <!-- =====================================================================
             ROW 1 (Left): Main Heading
             ===================================================================== -->
        <div class="lg:col-span-6 lg:col-start-1 lg:row-start-1">
          <h1 class="text-2xl sm:text-3xl lg:text-[38px] font-extrabold text-slate-900 tracking-tight leading-[1.2] mb-3 sm:mb-4 lg:mb-6">
            Siap Mengotomatisasi Bisnis Anda dengan Solusi AI?
          </h1>
        </div>

        <!-- =====================================================================
             ROW 2 (Left): Kata-kata (Subtitle) & Bawahnya Maps
             ===================================================================== -->
        <div class="lg:col-span-6 lg:col-start-1 lg:row-start-2 flex flex-col space-y-6 sm:space-y-7">
          <!-- Subtitle (Titik acuan setara atas form) -->
          <p class="text-xs sm:text-sm lg:text-[15px] text-slate-600 leading-relaxed font-normal">
            Kami menghadirkan solusi Hyperautomation, AI/ML, dan Data Transformation terbaik dari mitra teknologi global, untuk membantu bisnis Anda tumbuh lebih cepat dan efisien.
          </p>

          <!-- Bawahnya Maps: Ultra-Fast Non-Blocking Google Maps Card -->
          <div class="w-full rounded-2xl overflow-hidden border border-slate-200/90 shadow-sm bg-slate-100 relative aspect-[16/10] min-h-[300px] sm:min-h-[320px]">
            <!-- Fast Lazy-Loaded Embed Iframe -->
            <iframe
              src="https://maps.google.com/maps?q=United+Teknologi+Integrasi+PT,+Jl.+Siantar+No.18,+Cideng,+Gambir,+Jakarta+Pusat&t=&z=16&ie=UTF8&iwloc=&output=embed"
              class="w-full h-full border-0 absolute inset-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Peta Lokasi Kantor PT Solusi Aplikasi Integrasi / UTI"
            ></iframe>
          </div>
        </div>

        <!-- =====================================================================
             ROW 2 (Right): Kanan nya Form (Setara Atas dengan Subtitle di Row 2)
             ===================================================================== -->
        <div class="lg:col-span-6 lg:col-start-7 lg:row-start-2 flex justify-center lg:justify-end">
          <div class="w-full max-w-[500px] bg-white rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-200/90 p-5 sm:p-6 lg:p-7 text-slate-800">
            <!-- Form Card Header (Matching CTA) -->
            <h2 class="text-base sm:text-lg font-bold text-[#3a5ae8] mb-1 tracking-tight">
              Diskusikan Kebutuhan anda
            </h2>
            <p class="text-[11px] text-slate-500 mb-4 leading-relaxed">
              Isi formulir di bawah ini untuk menjadwalkan sesi demo gratis bersama konsultan SAI.
            </p>

            <!-- Form Body (Matching ConsultationCta.astro) -->
            <form id="request-demo-page-form" class="space-y-3">
              <!-- Honeypot for Bot Protection -->
              <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

              <!-- Row 1: Nama & Email -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="rd-name" class="block text-[11px] font-semibold text-slate-700 mb-1">
                    Nama
                  </label>
                  <input
                    id="rd-name"
                    type="text"
                    name="name"
                    placeholder="Nama lengkap Anda"
                    class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-[#fbfcfd] focus:bg-white text-xs sm:text-[13px] text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-[#3a5ae8] focus:ring-1 focus:ring-[#3a5ae8] transition-all"
                  />
                </div>

                <div>
                  <label for="rd-email" class="block text-[11px] font-semibold text-slate-700 mb-1">
                    Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="rd-email"
                    type="email"
                    name="email"
                    required
                    placeholder="anda@perusahaan.com"
                    class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-[#fbfcfd] focus:bg-white text-xs sm:text-[13px] text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-[#3a5ae8] focus:ring-1 focus:ring-[#3a5ae8] transition-all"
                  />
                </div>
              </div>

              <!-- Row 2: WhatsApp (+62 Flag) & Nama Perusahaan -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="rd-phone" class="block text-[11px] font-semibold text-slate-700 mb-1">
                    Nomor WhatsApp <span class="text-red-500">*</span>
                  </label>
                  <div class="flex items-center rounded-lg border border-slate-200 bg-[#fbfcfd] focus-within:bg-white focus-within:border-[#3a5ae8] focus-within:ring-1 focus-within:ring-[#3a5ae8] transition-all overflow-hidden">
                    <div class="flex items-center gap-1.5 pl-2.5 pr-2 py-2 bg-slate-50 border-r border-slate-200 select-none shrink-0">
                      <!-- Indonesia Flag Icon 🇮🇩 -->
                      <svg class="w-3.5 h-2.5 rounded-2xs border border-slate-300 shadow-2xs" viewBox="0 0 24 16" fill="none" aria-hidden="true">
                        <rect width="24" height="8" fill="#e11d48"/>
                        <rect y="8" width="24" height="8" fill="#ffffff"/>
                      </svg>
                      <span class="text-[11px] font-medium text-slate-700">+62</span>
                      <svg class="w-2 h-2 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                      </svg>
                    </div>
                    <input
                      id="rd-phone"
                      type="tel"
                      name="phone"
                      required
                      placeholder="8123456789"
                      class="w-full px-2.5 py-2 text-xs sm:text-[13px] text-slate-800 placeholder:text-slate-400 focus:outline-none bg-transparent"
                    />
                  </div>
                </div>

                <div>
                  <label for="rd-company" class="block text-[11px] font-semibold text-slate-700 mb-1">
                    Nama Perusahaan <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="rd-company"
                    type="text"
                    name="company"
                    required
                    placeholder="Nama perusahaan Anda"
                    class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-[#fbfcfd] focus:bg-white text-xs sm:text-[13px] text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-[#3a5ae8] focus:ring-1 focus:ring-[#3a5ae8] transition-all"
                  />
                </div>
              </div>

              <!-- Row 3: Solusi Dibutuhkan -->
              <div>
                <label for="rd-product" class="block text-[11px] font-semibold text-slate-700 mb-1">
                  Solusi Dibutuhkan <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <select
                    id="rd-product"
                    name="product"
                    required
                    class="w-full appearance-none px-3 py-2 pr-8 rounded-lg border border-slate-200 bg-[#fbfcfd] focus:bg-white text-xs sm:text-[13px] text-slate-700 focus:outline-none focus:border-[#3a5ae8] focus:ring-1 focus:ring-[#3a5ae8] transition-all cursor-pointer"
                  >
                    <option value="" disabled selected>Pilih solusi yang dibutuhkan</option>
                    <option value="nanonets">Intelligent Document Processing (Nanonets)</option>
                    <option value="cyclone">Robotic Process Automation (Cyclone)</option>
                    <option value="docuflo">Document Management System (DocuFlo)</option>
                    <option value="syclus">Account Payable Automation (Syclus)</option>
                    <option value="spensify">Expense Management System (Spensify)</option>
                    <option value="multi">Konsultasi Solusi Multi-Platform</option>
                  </select>
                  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-slate-400">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </div>
                </div>
              </div>

              <!-- Row 4: Kebutuhan Textarea -->
              <div>
                <label for="rd-message" class="block text-[11px] font-semibold text-slate-700 mb-1">
                  Kebutuhan
                </label>
                <textarea
                  id="rd-message"
                  name="message"
                  rows="2"
                  placeholder="Jelaskan kebutuhan Anda, tantangan yang dihadapi, dan gambaran operasional bisnis Anda."
                  class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-[#fbfcfd] focus:bg-white text-xs sm:text-[13px] text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-[#3a5ae8] focus:ring-1 focus:ring-[#3a5ae8] transition-all resize-none min-h-[58px]"
                ></textarea>
              </div>

              <!-- Status Alert Feedback -->
              <div id="rd-status-box" class="hidden p-2.5 rounded-lg text-xs leading-relaxed" role="alert"></div>

              <!-- Submit Button -->
              <div class="pt-1">
                <button
                  type="submit"
                  id="rd-submit-btn"
                  class="w-full py-2.5 sm:py-3 px-5 rounded-lg sm:rounded-xl bg-[#3a5ae8] hover:bg-[#2e4ecf] active:bg-[#2541b3] text-white font-semibold text-xs sm:text-sm shadow-md shadow-blue-600/20 transition-all duration-200 cursor-pointer text-center"
                >
                  Kirim
                </button>
              </div>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>
</PageLayout>

<!-- Client Script for Form Submission Handling -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('request-demo-page-form');
    if (!form) return;

    const statusBox = document.getElementById('rd-status-box');
    const submitBtn = document.getElementById('rd-submit-btn');

    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const name = form.querySelector('input[name="name"]')?.value.trim() || '';
      const email = form.querySelector('input[name="email"]')?.value.trim();
      const phone = form.querySelector('input[name="phone"]')?.value.trim();
      const company = form.querySelector('input[name="company"]')?.value.trim();
      const productSelect = form.querySelector('select[name="product"]');
      const product = productSelect ? productSelect.value : '';
      const productLabel = productSelect && productSelect.selectedIndex >= 0 ? productSelect.options[productSelect.selectedIndex].text : '';
      const messageText = form.querySelector('textarea[name="message"]')?.value.trim() || '';

      if (!email || !phone || !company || !product) {
        if (statusBox) {
          statusBox.className = 'p-2.5 rounded-lg text-xs leading-relaxed bg-amber-50 border border-amber-200 text-amber-800 block';
          statusBox.textContent = 'Mohon lengkapi semua kolom yang bertanda bintang (*).';
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <svg class="animate-spin -ml-1 mr-2 h-3.5 w-3.5 text-white inline" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Mengirim...</span>
        `;
      }

      // Save to localStorage for Admin Dashboard
      try {
        const stored = localStorage.getItem('solusi_leads_data');
        const leads = stored ? JSON.parse(stored) : [];
        leads.unshift({
          id: `lead-${Date.now()}`,
          name: name || email.split('@')[0],
          email: email,
          phone: phone.startsWith('+') ? phone : `+62${phone.replace(/^0+/, '')}`,
          company: company,
          position: 'Lead Request Demo Page',
          requirements: `[Solusi: ${productLabel}] ${messageText}`,
          message: `[Perusahaan: ${company}] [Solusi: ${productLabel}] ${messageText}`,
          sourceUrl: window.location.href,
          createdAt: new Date().toISOString(),
          status: 'Baru',
        });
        localStorage.setItem('solusi_leads_data', JSON.stringify(leads));
      } catch (err) {
        console.warn('Failed to store lead in localStorage:', err);
      }

      // Send Lead Notification to sales@solusiaplikasi.id via WP REST API
      try {
        const restEndpoint = 'https://solusiaplikasi.id/solution/wp-json/solusi/v1/lead';
        await fetch(restEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: name || email,
            email: email,
            phone: phone,
            company: company,
            position: 'Lead Request Demo Page',
            requirements: `[Solusi: ${productLabel}] ${messageText}`,
            sourceUrl: window.location.href,
          }),
        });
      } catch {
        // Fallback delivery via FormSubmit
        try {
          await fetch('https://formsubmit.co/ajax/sales@solusiaplikasi.id', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              _subject: `[Lead Request Demo Baru] ${name || email} - ${company}`,
              _template: 'table',
              _captcha: 'false',
              Nama: name || '-',
              Email: email,
              'No. WhatsApp': `+62 ${phone}`,
              Perusahaan: company,
              'Solusi Dibutuhkan': productLabel,
              Kebutuhan: messageText || '-',
              'Halaman Sumber': window.location.href,
            }),
          });
        } catch (fallbackErr) {
          console.warn('Fallback error:', fallbackErr);
        }
      }

      if (statusBox) {
        statusBox.className = 'p-3 rounded-lg text-xs leading-relaxed bg-emerald-50 border border-emerald-200 text-emerald-800 block';
        statusBox.innerHTML = `
          <strong>Terima kasih${name ? ', ' + name : ''}!</strong> Permintaan demo Anda telah berhasil terkirim. Tim konsultan SAI akan segera menghubungi Anda 1x24 jam.
        `;
      }

      form.reset();

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<span>Kirim</span>`;
      }
    });
  });
</script>
