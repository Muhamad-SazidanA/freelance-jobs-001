---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminLogin from '@/components/admin/AdminLogin';
import { getSessionFromCookies } from '@/lib/auth';

export const prerender = false;

const session = getSessionFromCookies(Astro.cookies);
if (session) {
  return Astro.redirect('/admin');
}

const fromParam = Astro.url.searchParams.get('from') || '/admin';
const fromPath = fromParam.startsWith('/admin') ? fromParam : '/admin';
---

<AdminLayout
  title="Admin Login | SolusiAplikasi.id"
  description="Halaman autentikasi panel admin SolusiAplikasi.id."
>
  <AdminLogin client:load fromPath={fromPath} />
</AdminLayout>
