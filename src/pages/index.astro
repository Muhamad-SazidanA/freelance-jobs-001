---
import PageLayout from "@/layouts/PageLayout.astro";
import IntegratedSolutionsSection from "@/components/home/IntegratedSolutionsSection.astro";
import TrustRecognition from "@/components/home/TrustRecognition.astro";
import ConsultationCta from "@/components/common/ConsultationCta.astro";
import {
  generateOrganizationSchema,
  generateWebSiteSchema,
} from "@/lib/schema-ld";
import { getSiteOptions } from "@/content/loaders/wp-graphql-loader";

const options = await getSiteOptions();
const orgSchema = generateOrganizationSchema(options);
const websiteSchema = generateWebSiteSchema();
const schemas = [orgSchema, websiteSchema];
---

<PageLayout
  title="SolusiAplikasi.id | Empowering Business with Digital Intelligent Automation"
  description="Solusi Channel terpadu untuk percepatan ekosistem digital: AI Document OCR, Enterprise RPA, Document Management System, ITSM, dan Expense Management."
  schema={schemas}
>
  <div class="home-content-zoom w-full">
  <!-- =========================================================================
       1. HERO SECTION - FUTURISTIC AUTOMATION BANNER WITH 5 SOLUTIONS DOCK
       ========================================================================= -->
  <section class="relative overflow-hidden bg-[#030712] text-white border-b border-slate-900">
    <!-- Background Image with Gradient Overlays -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/home/Banner_Home.webp"
        alt="Solusi Digital Automation untuk Bisnis"
        class="w-full h-full object-cover object-right md:object-center"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Gradient overlay: Deep dark on left for text readability, blending into the banner on right -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#030712] via-[#030712]/85 md:via-[#030712]/70 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#030712] via-transparent to-[#030712]/30"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 pt-16 pb-10 md:pt-24 md:pb-14 flex flex-col justify-between min-h-[580px] lg:min-h-[640px]">
      {/* Top Text & CTA */}
      <div class="max-w-2xl mb-12 md:mb-16">
        <!-- Eyebrow Tag -->
        <p class="text-xs sm:text-[13px] font-semibold text-slate-300 tracking-wider uppercase mb-3 sm:mb-4">
          SOLUSI DIGITAL AUTOMATION UNTUK BISNIS
        </p>

        <!-- Main Title -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[54px] font-extrabold text-white tracking-tight leading-[1.12] mb-4 sm:mb-5">
          Empowering business<br />
          with digital intelligent<br />
          automation.
        </h1>

        <!-- Subtitle -->
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-xl mb-7 sm:mb-8 font-normal">
          Distributor dan penyedia solusi Hyperautomation, AI-driven Intelligent Document Processing, dan Robotic Process Automation terkemuka di Indonesia membuat kerja tim Anda lebih cepat, akurat, dan sederhana.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-3.5">
          <a
            href="/request-demo"
            class="inline-flex items-center justify-center px-7 py-3 bg-white hover:bg-slate-100 text-[#0f172a] text-xs sm:text-sm font-bold rounded-full shadow-lg shadow-white/10 hover:shadow-white/20 transition-all duration-200"
          >
            Kontak Kami
          </a>
          <a
            href="#form-konsultasi"
            class="inline-flex items-center justify-center px-7 py-3 bg-white/5 hover:bg-white/15 text-white text-xs sm:text-sm font-semibold rounded-full border border-white/35 hover:border-white/60 backdrop-blur-xs transition-all duration-200"
          >
            Mulai Konsultasi
          </a>
        </div>
      </div>

      {/* Bottom 5-Solutions Blue Dock */}
      <div class="w-full">
        <div class="bg-[#1877F2] rounded-2xl md:rounded-3xl shadow-xl shadow-blue-950/40 overflow-hidden">
          <div class="flex overflow-x-auto lg:grid lg:grid-cols-5 divide-x divide-white/20 no-scrollbar">
            <!-- 1. Intelligent Document Processing -->
            <a
              href="/products/nanonets"
              class="min-w-[220px] sm:min-w-[240px] lg:min-w-0 flex items-center gap-3 px-4 py-3.5 sm:px-4 sm:py-4 hover:bg-white/10 transition-colors group shrink-0 lg:shrink"
            >
              <div class="shrink-0 p-2 rounded-xl bg-white/10 text-white group-hover:bg-white/20 transition-colors">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>
              </div>
              <div class="min-w-0">
                <h4 class="text-xs sm:text-[13px] font-bold text-white leading-tight">
                  Intelligent Document<br class="hidden xl:inline" /> Processing
                </h4>
                <p class="text-[10px] sm:text-[11px] text-blue-100 mt-0.5 leading-tight">
                  Ekstraksi Data Otomatis
                </p>
              </div>
            </a>

            <!-- 2. Robotic Process Automation -->
            <a
              href="/products/cyclone"
              class="min-w-[220px] sm:min-w-[240px] lg:min-w-0 flex items-center gap-3 px-4 py-3.5 sm:px-4 sm:py-4 hover:bg-white/10 transition-colors group shrink-0 lg:shrink"
            >
              <div class="shrink-0 p-2 rounded-xl bg-white/10 text-white group-hover:bg-white/20 transition-colors">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22v-5"/>
                  <path d="M9 8V2"/>
                  <path d="M15 8V2"/>
                  <path d="M18 8v5a6 6 0 0 1-12 0V8z"/>
                </svg>
              </div>
              <div class="min-w-0">
                <h4 class="text-xs sm:text-[13px] font-bold text-white leading-tight">
                  Robotic Process<br class="hidden xl:inline" /> Automation
                </h4>
                <p class="text-[10px] sm:text-[11px] text-blue-100 mt-0.5 leading-tight">
                  Otomasi Tugas Berulang
                </p>
              </div>
            </a>

            <!-- 3. Document Management System -->
            <a
              href="/products/docuflo"
              class="min-w-[220px] sm:min-w-[240px] lg:min-w-0 flex items-center gap-3 px-4 py-3.5 sm:px-4 sm:py-4 hover:bg-white/10 transition-colors group shrink-0 lg:shrink"
            >
              <div class="shrink-0 p-2 rounded-xl bg-white/10 text-white group-hover:bg-white/20 transition-colors">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </div>
              <div class="min-w-0">
                <h4 class="text-xs sm:text-[13px] font-bold text-white leading-tight">
                  Document<br class="hidden xl:inline" /> Management System
                </h4>
                <p class="text-[10px] sm:text-[11px] text-blue-100 mt-0.5 leading-tight">
                  Pengelolaan Dokumen Digital
                </p>
              </div>
            </a>

            <!-- 4. Account Payable Automation -->
            <a
              href="/products/syclus"
              class="min-w-[220px] sm:min-w-[240px] lg:min-w-0 flex items-center gap-3 px-4 py-3.5 sm:px-4 sm:py-4 hover:bg-white/10 transition-colors group shrink-0 lg:shrink"
            >
              <div class="shrink-0 p-2 rounded-xl bg-white/10 text-white group-hover:bg-white/20 transition-colors">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="20" height="14" rx="2"/>
                  <line x1="2" y1="10" x2="22" y2="10"/>
                  <line x1="6" y1="15" x2="6.01" y2="15"/>
                  <line x1="10" y1="15" x2="14" y2="15"/>
                </svg>
              </div>
              <div class="min-w-0">
                <h4 class="text-xs sm:text-[13px] font-bold text-white leading-tight">
                  Account Payable<br class="hidden xl:inline" /> Automation
                </h4>
                <p class="text-[10px] sm:text-[11px] text-blue-100 mt-0.5 leading-tight">
                  Otomasi Utang Usaha
                </p>
              </div>
            </a>

            <!-- 5. Expense Management System -->
            <a
              href="/products/spensify"
              class="min-w-[220px] sm:min-w-[240px] lg:min-w-0 flex items-center gap-3 px-4 py-3.5 sm:px-4 sm:py-4 hover:bg-white/10 transition-colors group shrink-0 lg:shrink"
            >
              <div class="shrink-0 p-2 rounded-xl bg-white/10 text-white group-hover:bg-white/20 transition-colors">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1z"/>
                  <line x1="8" y1="7" x2="16" y2="7"/>
                  <line x1="8" y1="11" x2="16" y2="11"/>
                  <line x1="8" y1="15" x2="12" y2="15"/>
                </svg>
              </div>
              <div class="min-w-0">
                <h4 class="text-xs sm:text-[13px] font-bold text-white leading-tight">
                  Expense Management<br class="hidden xl:inline" /> System
                </h4>
                <p class="text-[10px] sm:text-[11px] text-blue-100 mt-0.5 leading-tight">
                  Pengelolaan Pengeluaran
                </p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       2. NARRATIVE VALUE STATEMENT + 3 QUICK STATS - SLIM & REFINED
       ========================================================================= -->
  <section class="py-10 md:py-12 bg-slate-50/50 border-b border-slate-200/60">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8 items-center">
        {/* Left: Paragraph narrative */}
        <div class="lg:col-span-7">
          <p
            class="text-sm sm:text-base text-slate-700 leading-relaxed font-normal"
          >
            <strong class="font-bold text-slate-900"
              >Solusi Otomatisasi kami</strong
            > dirancang dan berfungsi sebagai landasan untuk perkembangan transformasi digital dalam bisnis Anda. Kami memberikan layanan yang berkualitas dan terukur dalam menerapkan Otomatisasi Bisnis dan Proses Otomatisasi Robotik dengan teknologi AI dan ML (Machine Learning) yang menyeimbangkan kebutuhan bisnis Anda dengan teknologi inovasi.
          </p>
        </div>

        {/* Right: 3 Key Metrics */}
        <div
          class="lg:col-span-5 grid grid-cols-3 gap-2.5 border-t lg:border-t-0 lg:border-l border-slate-200/80 pt-4 lg:pt-0 lg:pl-6 text-center"
        >
          <div>
            <div
              class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"
            >
              80%
            </div>
            <div
              class="text-xs sm:text-sm text-slate-500 mt-1 font-medium leading-snug"
            >
              Percepatan waktu<br />approval dokumen
            </div>
          </div>
          <div>
            <div
              class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"
            >
              100%
            </div>
            <div
              class="text-xs sm:text-sm text-slate-500 mt-1 font-medium leading-snug"
            >
              Pengurangan risiko<br />fraud dokumen
            </div>
          </div>
          <div>
            <div
              class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"
            >
              95%
            </div>
            <div
              class="text-xs sm:text-sm text-slate-500 mt-1 font-medium leading-snug"
            >
              Pengurangan<br />entry data manual
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       3. TANTANGAN OPERASIONAL: SLIM, CLEAN & FOCUSED
       ========================================================================= -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div
        class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-6"
      >
        <div class="shrink-0">
          <p
            class="text-xs font-semibold tracking-wider uppercase text-[#0866D3] mb-1.5"
          >
            Masalah Enterprise
          </p>
          <h2
            class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug"
          >
            Proses Manual yang Bikin Bisnis<br class="hidden sm:inline" />
            Anda Lambat
          </h2>
        </div>
        <p
          class="text-sm sm:text-base text-slate-600 max-w-lg leading-relaxed md:ml-auto"
        >
          Banyak perusahaan masih mengandalkan input manual, file Excel yang
          tersebar di banyak folder, dan approval yang harus dikejar satu-satu
          lewat chat atau email. Begitu bisnis makin besar, cara kerja ini nggak
          lagi kekejar volumenya.
        </p>
      </div>

      {/* 5 Operational Challenges - Minimalist Clean Layout */}
      <div class="bg-white rounded-2xl md:rounded-3xl border border-slate-200/60 p-6 md:p-8 shadow-2xs">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-6 md:gap-8 items-start">
          {/* Item 1 */}
          <div>
            <div class="mb-3.5">
              <svg class="w-6 h-6 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="2"></rect>
                <rect x="14" y="3" width="7" height="7" rx="2"></rect>
                <rect x="14" y="14" width="7" height="7" rx="2"></rect>
                <rect x="3" y="14" width="7" height="7" rx="2"></rect>
              </svg>
            </div>
            <p class="text-xs sm:text-sm text-slate-800 font-medium leading-relaxed">
              Data tersebar di banyak sistem dan file berbeda
            </p>
          </div>

          {/* Item 2 */}
          <div>
            <div class="mb-3.5">
              <svg class="w-6 h-6 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                <line x1="9" y1="13" x2="15" y2="13"></line>
              </svg>
            </div>
            <p class="text-xs sm:text-sm text-slate-800 font-medium leading-relaxed">
              Data tersebar di banyak sistem dan file berbeda
            </p>
          </div>

          {/* Item 3 */}
          <div>
            <div class="mb-3.5">
              <svg class="w-6 h-6 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 3h10a2 2 0 012 2v10a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"></path>
                <path d="M4 7v12a2 2 0 002 2h12"></path>
              </svg>
            </div>
            <p class="text-xs sm:text-sm text-slate-800 font-medium leading-relaxed">
              Human error meningkat seiring volume dokumen
            </p>
          </div>

          {/* Item 4 */}
          <div>
            <div class="mb-3.5">
              <svg class="w-6 h-6 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="4"></rect>
                <path d="M7 10l3 4 3-3 4 4"></path>
              </svg>
            </div>
            <p class="text-xs sm:text-sm text-slate-800 font-medium leading-relaxed">
              Tim habis waktu buat kerjaan yang bisa diotomatisasi
            </p>
          </div>

          {/* Item 5 */}
          <div>
            <div class="mb-3.5">
              <svg class="w-6 h-6 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
              </svg>
            </div>
            <p class="text-xs sm:text-sm text-slate-800 font-medium leading-relaxed">
              Biaya operasional terus naik seiring beban kerja manual
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. 5 SOLUSI TERINTEGRASI (SLIM INTERACTIVE TABS & PRODUCT PREVIEW)
       ========================================================================= -->
  <IntegratedSolutionsSection />

  <!-- =========================================================================
       5. KAMI MERANCANG SOLUSI, BUKAN HANYA SEKEDAR MENJUAL LISENSI
       ========================================================================= -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 items-stretch">
        {/* Cell 1: Heading Block */}
        <div class="space-y-2.5 p-1 flex flex-col justify-start">
          <p
            class="text-xs font-semibold tracking-wider uppercase text-[#0866D3] mb-1.5"
          >
            Kenapa SAI?
          </p>
          <h2
            class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight"
          >
            Kami merancang solusi, bukan hanya sekadar menjual lisensi.
          </h2>
        </div>

        {/* Cell 2: Card 1 - End-to-End Implementation */}
        <div
          class="p-4.5 bg-slate-50/60 border border-slate-200/80 rounded-xl space-y-2 hover:border-slate-300 transition-colors"
        >
          <div
            class="w-7 h-7 rounded-md bg-slate-100 text-slate-700 flex items-center justify-center border border-slate-200/60 font-bold text-xs"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900">
            End-to-End Provider
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
           Dari konsultasi, desain, implementasi, hingga managed service satu mitra untuk seluruh perjalanan.
          </p>
        </div>

        {/* Cell 3: Card 2 - Konektor Native Terintegrasi */}
        <div
          class="p-4.5 bg-slate-50/60 border border-slate-200/80 rounded-xl space-y-2 hover:border-slate-300 transition-colors"
        >
          <div
            class="w-7 h-7 rounded-md bg-slate-100 text-slate-700 flex items-center justify-center border border-slate-200/60 font-bold text-xs"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
              ></path>
            </svg>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900">
            Ekosistem Terintegrasi
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            5 solusi yang dirancang untuk saling terhubung, bukan sistem terpisah yang berdiri sendiri.
          </p>
        </div>

        {/* Cell 4: Card 3 - Keamanan Skala Enterprise */}
        <div
          class="p-4.5 bg-slate-50/60 border border-slate-200/80 rounded-xl space-y-2 hover:border-slate-300 transition-colors"
        >
          <div
            class="w-7 h-7 rounded-md bg-slate-100 text-slate-700 flex items-center justify-center border border-slate-200/60 font-bold text-xs"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900">
            Keamanan Kelas Enterprise
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Produk kami mengikuti standar keamanan SOC 2, GDPR, ISO 27001, dan HIPAA.
          </p>
        </div>

        {/* Cell 5: Card 4 - Arsitektur Fleksibel & On-Premise */}
        <div
          class="p-4.5 bg-slate-50/60 border border-slate-200/80 rounded-xl space-y-2 hover:border-slate-300 transition-colors"
        >
          <div
            class="w-7 h-7 rounded-md bg-slate-100 text-slate-700 flex items-center justify-center border border-slate-200/60 font-bold text-xs"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
