---
import PageLayout from '@/layouts/PageLayout.astro';
import ConsultationCta from '@/components/common/ConsultationCta.astro';
import { generateBreadcrumbSchema, generateProductSchema, generateFaqSchema } from '@/lib/schema-ld';
import type { Product } from '@/types/content';

const productData: Product = {
  id: 'prod-docuflo',
  slug: 'docuflo',
  name: 'Docuflo DMS',
  headline: 'Dari Dokumen yang Berantakan Menuju Kendali Bisnis Penuh',
  tagline:
    'Docuflo menyatukan capture, penyimpanan, pencarian, dan workflow persetujuan dokumen perusahaan Anda dalam satu repository terpusat yang aman dan siap diaudit.',
  heroImage: '/images/home/home-city-banner.jpg',
  overview:
    'Docuflo menyatukan capture, penyimpanan, pencarian, dan workflow persetujuan dokumen perusahaan Anda dalam satu repository terpusat yang aman dan siap diaudit.',
  features: [
    {
      title: 'Content Capture',
      description: 'Digitalisasi email, PDF, dokumen hasil scan, hingga file dari aplikasi bisnis lain secara otomatis.',
    },
    {
      title: 'Process Workflow',
      description: 'Rute dokumen ke approver yang tepat dengan workflow otomatis dan notifikasi real-time.',
    },
    {
      title: 'Pencarian Cerdas',
      description: 'Temukan dokumen dalam hitungan detik lewat simple search, index search, hingga pencarian isi dokumen.',
    },
    {
      title: 'Indexing Otomatis',
      description: 'Zone OCR dan single-click entry mempercepat klasifikasi dokumen terstruktur maupun tidak terstruktur.',
    },
    {
      title: 'Version Control',
      description: 'Setiap revisi tercatat rapi, tim dapat berkolaborasi tanpa risiko duplikasi atau versi yang tertukar.',
    },
    {
      title: 'Integrasi Sistem',
      description: 'Tersedia API & SDK untuk terhubung dengan Active Directory, Single Sign-On, dan aplikasi bisnis lainnya.',
    },
  ],
  benefits: [
    'Peningkatan turnaround time lebih dari 55%',
    'Terpasang di 200+ lokasi klien enterprise',
    'Pencarian dokumen lebih dari 75% lebih cepat',
    'Reduksi biaya operasional pengelolaan arsip hingga lebih dari 60%',
    '10.000+ pengguna terdaftar aktif',
  ],
  useCases: [
    'Digitalisasi dan sentralisasi arsip berkas fisik',
    'Manajemen persetujuan dan rute dokumen (Approval Workflow)',
    'Kontrol versi dokumen kolaboratif multi-departemen',
    'Audit trail dan kepatuhan regulasi keamanan enterprise',
  ],
  faqs: [
    {
      question: 'Apakah Docuflo aman untuk data rahasia perbankan dan finansial?',
      answer:
        'Ya. Docuflo mengadopsi enkripsi AES-256 untuk data at rest dan TLS 1.3 untuk data in transit, serta mendukung deployment on-premise di data center internal Anda.',
    },
    {
      question: 'Apakah Docuflo bisa diintegrasikan dengan ERP seperti SAP atau Microsoft Dynamics?',
      answer:
        'Docuflo menyediakan REST API dan Webhook yang komprehensif untuk integrasi seamless dua arah dengan sistem ERP dan CRM terkemuka.',
    },
  ],
};

const breadcrumbs = [
  { name: 'Products', url: '/products/docuflo' },
  { name: 'Docuflo (DMS)', url: '/products/docuflo' },
];

const productSchema = generateProductSchema(productData);
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const faqSchema = generateFaqSchema(productData.faqs);
const schema = [productSchema, breadcrumbSchema, faqSchema];
---

<PageLayout
  title="Docuflo DMS - Dari Dokumen yang Berantakan Menuju Kendali Bisnis Penuh | SolusiAplikasi.id"
  description="Docuflo menyatukan capture, penyimpanan, pencarian, dan workflow persetujuan dokumen perusahaan Anda dalam satu repository terpusat yang aman dan siap diaudit."
  canonical="https://solusiaplikasi.id/products/docuflo"
  breadcrumbs={[]}
  schema={schema}
>
  <div class="home-content-zoom w-full">
  <!-- =========================================================================
       BAGIAN 1: HERO SECTION BANNER CARD (SESUAI FOTO REFERENSI)
       ========================================================================= -->
  <section class="docuflo-hero-section bg-white text-slate-900 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="docuflo-hero-card relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl min-h-[460px] sm:min-h-[500px] lg:min-h-[540px] flex items-center">
        <!-- Background Image Container with cover & dark gradient overlay -->
        <div class="absolute inset-0 z-0">
          <img
            src="/images/product/docuflo/docuflo-dashboard.webp"
            alt="Docuflo Enterprise Document Management System"
            class="w-full h-full object-cover object-right"
            loading="eager"
            fetchpriority="high"
          />
          <div class="docuflo-hero-card-overlay absolute inset-0"></div>
        </div>

        <!-- Content Overlay on Left Side -->
        <div class="relative z-10 max-w-2xl p-6 sm:p-10 md:p-12 lg:p-14 text-white">
          <!-- Badge Atas Sesuai Foto Referensi -->
          <div class="mb-5 sm:mb-6">
            <span class="docuflo-badge-pill-card">Enterprise Document Management System</span>
          </div>

          <!-- Headline Sesuai Foto Referensi (3 baris rapi, warna putih) -->
          <h1 class="docuflo-hero-card-title mb-4 sm:mb-5">
            Dari Dokumen yang<br />
            Berantakan Menuju<br />
            Kendali Bisnis Penuh
          </h1>

          <!-- Subtitle Sesuai Foto Referensi -->
          <p class="docuflo-hero-card-subtitle mb-6 sm:mb-8">
            Docuflo menyatukan capture, penyimpanan, pencarian, dan workflow persetujuan dokumen perusahaan Anda dalam satu repository terpusat yang aman dan siap diaudit.
          </p>

          <!-- CTA Buttons Sesuai Foto Referensi -->
          <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
            <a href="#form-konsultasi" class="docuflo-btn-primary">
              Jadwalkan Demo
            </a>
            <a href="#modul-docuflo" class="docuflo-btn-card-secondary">
              Lihat Kemampuan Produk
            </a>
          </div>

          <!-- Trust Stats Line Sesuai Foto Referensi -->
          <div class="docuflo-hero-card-metrics">
            <span><strong>200+</strong> lokasi klien</span>
            <span class="bullet">&bull;</span>
            <span><strong>10.000+</strong> pengguna terdaftar</span>
            <span class="bullet">&bull;</span>
            <span><strong>75%</strong> lebih cepat dalam pencarian dokumen</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BAGIAN 2: KEMAMPUAN INTI (6 CARDS GRID SESUAI FOTO 1)
       ========================================================================= -->
  <section class="docuflo-section bg-white text-slate-900 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="mb-12">
        <span class="docuflo-badge-pill mb-3">Kemampuan Inti</span>
        <h2 class="docuflo-section-title mt-2">
          Satu Platform untuk Seluruh Siklus Hidup Dokumen
        </h2>
        <p class="docuflo-section-subtitle">
          Dari email, PDF, hasil scan, hingga dokumen hasil aplikasi bisnis &mdash; Docuflo menangkap, mengindeks, dan mengamankan semuanya secara otomatis.
        </p>
      </div>

      <!-- 6 Cards Grid (3 cols desktop, 1 col mobile) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Card 1: Content Capture -->
        <div class="docuflo-feature-card">
          <div class="docuflo-feature-icon">
            <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="docuflo-card-title">Content Capture</h3>
          <p class="docuflo-card-desc">
            Digitalisasi email, PDF, dokumen hasil scan, hingga file dari aplikasi bisnis lain secara otomatis.
          </p>
        </div>

        <!-- Card 2: Process Workflow -->
        <div class="docuflo-feature-card">
          <div class="docuflo-feature-icon">
            <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
          </div>
          <h3 class="docuflo-card-title">Process Workflow</h3>
          <p class="docuflo-card-desc">
            Rute dokumen ke approver yang tepat dengan workflow otomatis dan notifikasi real-time.
          </p>
        </div>

        <!-- Card 3: Pencarian Cerdas -->
        <div class="docuflo-feature-card">
          <div class="docuflo-feature-icon">
            <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="docuflo-card-title">Pencarian Cerdas</h3>
          <p class="docuflo-card-desc">
            Temukan dokumen dalam hitungan detik lewat simple search, index search, hingga pencarian isi dokumen.
          </p>
        </div>

        <!-- Card 4: Indexing Otomatis -->
        <div class="docuflo-feature-card">
          <div class="docuflo-feature-icon">
            <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
          </div>
          <h3 class="docuflo-card-title">Indexing Otomatis</h3>
          <p class="docuflo-card-desc">
            Zone OCR dan single-click entry mempercepat klasifikasi dokumen terstruktur maupun tidak terstruktur.
          </p>
        </div>

        <!-- Card 5: Version Control -->
        <div class="docuflo-feature-card">
          <div class="docuflo-feature-icon">
            <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
            </svg>
          </div>
          <h3 class="docuflo-card-title">Version Control</h3>
          <p class="docuflo-card-desc">
            Setiap revisi tercatat rapi, tim dapat berkolaborasi tanpa risiko duplikasi atau versi yang tertukar.
          </p>
        </div>

        <!-- Card 6: Integrasi Sistem -->
        <div class="docuflo-feature-card">
          <div class="docuflo-feature-icon">
            <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="docuflo-card-title">Integrasi Sistem</h3>
          <p class="docuflo-card-desc">
            Tersedia API &amp; SDK untuk terhubung dengan Active Directory, Single Sign-On, dan aplikasi bisnis lainnya.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BAGIAN 3: VALUE PROPOSITION (DARK SECTION SESUAI FOTO 2)
       ========================================================================= -->
  <section class="docuflo-dark-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="mb-12">
        <span class="docuflo-dark-pill mb-3">Value Proposition</span>
        <h2 class="docuflo-dark-title mt-2">
          Mengapa Perusahaan Memilih Docuflo
        </h2>
        <p class="docuflo-dark-subtitle">
          Docuflo dirancang untuk mendukung transformasi digital sekaligus menjaga dokumen Anda tetap aman dan mudah diakses.
        </p>
      </div>

      <!-- 3 Value Proposition Cards (Sesuai Foto 2) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="docuflo-dark-card">
          <div class="docuflo-dark-icon">
            <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="docuflo-dark-card-title">Mempercepat Transformasi Digital</h3>
          <p class="docuflo-dark-card-desc">
            Mendukung digitalisasi dokumen fisik dan proses manual sebagai fondasi transformasi digital perusahaan.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="docuflo-dark-card">
          <div class="docuflo-dark-icon">
            <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="docuflo-dark-card-title">Repository Aman &amp; Terpusat</h3>
          <p class="docuflo-dark-card-desc">
            Deployment on-premise maupun cloud memastikan dokumen selalu mudah diakses namun tetap terlindungi.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="docuflo-dark-card">
          <div class="docuflo-dark-icon">
            <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="docuflo-dark-card-title">Proses yang Sederhana</h3>
          <p class="docuflo-dark-card-desc">
            Alur kerja digital menghilangkan kerumitan eskalasi dan kolaborasi dokumen antar tim.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BAGIAN 4: MODUL DOCUFLO (4 ALTERNATING ROWS SESUAI FOTO 3)
       ========================================================================= -->
  <section id="modul-docuflo" class="docuflo-section bg-white text-slate-900 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="mb-10 sm:mb-12">
        <span class="docuflo-badge-pill mb-3">Modul Docuflo</span>
        <h2 class="docuflo-section-title mt-2">
          Dirancang Menyeluruh dari Capture hingga Integrasi
        </h2>
      </div>

      <div class="space-y-12 lg:space-y-16">
        <!-- Row 1: Capturing (Text Left, Card Right) Sesuai Foto 3 -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-6 space-y-4">
            <div class="docuflo-sub-badge">
              <svg class="w-3.5 h-3.5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
              </svg>
              <span>Capturing</span>
            </div>
            <h3 class="docuflo-module-title">Digitalisasi Dokumen dalam Volume Besar</h3>
            <p class="docuflo-module-desc">
              Ubah tumpukan dokumen fisik dan digital menjadi arsip terstruktur yang siap dicari kapan saja.
            </p>
            <ul class="docuflo-checklist">
              <li>
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Digitalisasi hardcopy dalam volume tinggi</span>
              </li>
              <li>
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Web upload, batch import, dan Outlook Add-In</span>
              </li>
              <li>
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Indexing otomatis berdasarkan kriteria pencarian</span>
              </li>
              <li>
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Ekspor langsung ke Docuflo Web Portal</span>
              </li>
            </ul>
          </div>
          <div class="lg:col-span-6">
            <div class="docuflo-mockup-box">
              <div class="docuflo-mockup-row">
                <span class="docuflo-row-label">Batch Import</span>
                <div class="docuflo-row-right">
                  <span class="docuflo-row-value">128 dokumen diproses</span>
                  <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
              </div>
              <div class="docuflo-mockup-row">
                <span class="docuflo-row-label">Hardcopy Scanning</span>
                <div class="docuflo-row-right">
                  <span class="docuflo-row-value">Production &amp; MFP Scanner</span>
                  <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
              </div>
              <div class="docuflo-mockup-row">
                <span class="docuflo-row-label">Web Upload</span>
                <div class="docuflo-row-right">
                  <span class="docuflo-row-value">Drag &amp; drop langsung dari browser</span>
                  <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Row 2: Web Admin (Card Left, Text Right) Sesuai Foto 3 -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-6 order-2 lg:order-1">
            <div class="docuflo-mockup-box">
              <div class="docuflo-mockup-row">
                <span class="docuflo-row-label">Audit Log</span>
                <div class="docuflo-row-right">
                  <span class="docuflo-row-value">Ekspor laporan ke CSV</span>
                  <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
              </div>
              <div class="docuflo-mockup-row">
                <span class="docuflo-row-label">Role Based Access</span>
                <div class="docuflo-row-right">
                  <span class="docuflo-row-value">Kontrol akses per folder &amp; dokumen</span>
                  <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
              </div>
              <div class="docuflo-mockup-row">
                <span class="docuflo-row-label">Workflow Report</span>
                <div class="docuflo-row-right">
                  <span class="docuflo-row-value">Pantau progres tiap tahap approval</span>
                  <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:col-span-6 space-y-4 order-1 lg:order-2">
            <div class="docuflo-sub-badge">
              <svg class="w-3.5 h-3.5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span>Web Admin</span>
            </div>
            <h3 class="docuflo-module-title">Kontrol Penuh atas Dokumen dan Pengguna</h3>
            <p class="docuflo-module-desc">
              Administrator memiliki visibilitas lengkap atas aktivitas sistem, workflow, dan hak akses pengguna.
            </p>
            <ul class="docuflo-checklist">
              <li>
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>User rights management &amp; workflow setup</span>
