---
import PageLayout from '@/layouts/PageLayout.astro';
import ConsultationCta from '@/components/common/ConsultationCta.astro';
import { generateBreadcrumbSchema, generateProductSchema, generateFaqSchema } from '@/lib/schema-ld';
import type { Product } from '@/types/content';

const productData: Product = {
  id: 'prod-syclus',
  slug: 'syclus',
  name: 'Syclus AP Automation',
  headline: 'Otomatisasi proses Accounts Payable, dari dokumen sampai pembayaran',
  tagline:
    'SYCLUS menyederhanakan proses AP di organisasi Anda lewat digitalisasi, otomasi, dan integrasi langsung ke sistem ERP — mengubah verifikasi dokumen yang memakan hari menjadi hitungan menit.',
  heroImage: '/images/home/home-city-banner.jpg',
  overview:
    'SYCLUS menyederhanakan proses AP di organisasi Anda lewat digitalisasi, otomasi, dan integrasi langsung ke sistem ERP — mengubah verifikasi dokumen yang memakan hari menjadi hitungan menit.',
  features: [
    {
      title: 'Storage in a Central Repository',
      description: 'Penyimpanan terpusat meminimalkan risiko dokumen rusak atau hilang, mengurangi redundansi, dan mempermudah kolaborasi.',
    },
    {
      title: 'Fast Retrieval of Information',
      description: 'Pengindeksan sistematis membuat konten berharga yang tersimpan di berbagai repositori dapat ditemukan dengan cepat.',
    },
    {
      title: 'Availability of Audit Trail',
      description: 'Jejak audit mendorong kepatuhan dan mencegah implikasi hukum karena akuntabilitas lebih terjamin dan pelacakan dokumen lebih sederhana.',
    },
    {
      title: 'Promote a Paperless Environment',
      description: 'Digitalisasi dokumen membantu organisasi mengurangi overhead dan limbah kantor dengan meminimalkan penggunaan kertas.',
    },
  ],
  benefits: [
    'Reduce Data Entry: Berkurang hingga 95%',
    'Reduce Fraud: Berkurang hingga 100%',
    'Improve Approval Time: Meningkat 70-80%',
    'Pencocokan 4-Way Matching otomatis (PO, GRN, Invoice, Tax Document)',
    'Integrasi mulus ke SAP, Oracle, Microsoft Dynamics, dan ERP korporasi',
  ],
  useCases: [
    'Otomatisasi Pembayaran Faktur Supplier & Vendor',
    'Rekonsiliasi 4-Way Matching Dokumen Finansial',
    'Pencegahan Pembayaran Faktur Ganda dan Potensi Fraud',
    'Digitalisasi Arsip Audit dan Kepatuhan Akuntansi',
  ],
  faqs: [
    {
      question: 'Bagaimana cara kerja 4-Way Matching di SYCLUS?',
      answer:
        'Saat faktur masuk, SYCLUS secara otomatis memvalidasi Vendor Master dan mencocokkan Purchase Order (PO), Good Received Notes (GRN), Invoice, dan Tax Document (Faktur Pajak). Jika semua data sesuai, sistem langsung meneruskan ke alur otorisasi pembayaran.',
    },
    {
      question: 'Apakah SYCLUS mendukung integrasi dengan ERP yang sudah digunakan?',
      answer:
        'Ya. SYCLUS mendukung integrasi langsung ke SAP, Oracle NetSuite, Microsoft Dynamics 365, Odoo, Accurate, dan sistem ERP in-house lainnya.',
    },
  ],
};

const breadcrumbs = [
  { name: 'Products', url: '/products/syclus' },
  { name: 'Syclus (AP Automation)', url: '/products/syclus' },
];

const productSchema = generateProductSchema(productData);
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const faqSchema = generateFaqSchema(productData.faqs);
const schema = [productSchema, breadcrumbSchema, faqSchema];
---

<PageLayout
  title="Syclus AP Automation - Otomatisasi Proses Accounts Payable | SolusiAplikasi.id"
  description="SYCLUS menyederhanakan proses AP di organisasi Anda lewat digitalisasi, otomasi, dan integrasi langsung ke sistem ERP — mengubah verifikasi dokumen yang memakan hari menjadi hitungan menit."
  canonical="https://solusiaplikasi.id/products/syclus"
  breadcrumbs={[]}
  schema={schema}
>
  <div class="home-content-zoom w-full">
  <!-- =========================================================================
       BAGIAN 1: HERO SECTION (SESUAI FOTO 2)
       ========================================================================= -->
  <section class="syclus-hero-section text-slate-900 border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Col Left: Headline & Text -->
        <div class="lg:col-span-7">
          <!-- Kicker Badge Sesuai Foto 2 -->
          <div class="mb-4">
            <span class="syclus-badge-pill">AP Automation Solution</span>
          </div>

          <!-- Main Title Sesuai Foto 2 -->
          <h1 class="syclus-hero-title mb-5">
            Otomatisasi proses<br />
            <span class="text-blue-600">Accounts Payable</span>,<br />
            dari dokumen sampai<br />
            pembayaran.
          </h1>

          <!-- Subtitle Sesuai Foto 2 -->
          <p class="syclus-hero-subtitle mb-8">
            SYCLUS menyederhanakan proses AP di organisasi Anda lewat digitalisasi, otomasi, dan integrasi langsung ke sistem ERP &mdash; mengubah verifikasi dokumen yang memakan hari menjadi hitungan menit.
          </p>

          <!-- Action Buttons Sesuai Foto 2 -->
          <div class="flex flex-wrap items-center gap-3.5 mb-8">
            <a href="#form-konsultasi" class="syclus-btn-primary">
              Jadwalkan Demo Gratis
            </a>
            <a href="#enam-langkah" class="syclus-btn-secondary">
              Lihat Cara Kerja
            </a>
          </div>
        </div>

        <!-- Col Right: Hero Dashboard Graphic (Sesuai Foto 2) -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative w-full max-w-[340px] sm:max-w-[380px] lg:max-w-[410px] flex justify-center lg:justify-end">
            <img
              src="/images/product/syclus/Syclus-Dashboard.webp"
              alt="Syclus AP Automation Dashboard - Menuju 2025"
              class="w-full h-auto object-contain select-none pointer-events-none"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>

      <!-- Target Sector Strip Sesuai Foto 2 -->
      <div class="pt-8 mt-6 text-center">
        <p class="text-[11px] font-bold text-slate-400 tracking-wider uppercase mb-3.5">
          DIRANCANG UNTUK TIM FINANCE &amp; AP DI BERBAGAI SEKTOR
        </p>
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
          <span class="syclus-sector-pill">Manufaktur</span>
          <span class="syclus-sector-pill">Distribusi</span>
          <span class="syclus-sector-pill">Ritel</span>
          <span class="syclus-sector-pill">Jasa Profesional</span>
          <span class="syclus-sector-pill">Konstruksi</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BAGIAN 2: MANFAAT AP AUTOMATION (SESUAI FOTO 1)
       ========================================================================= -->
  <section class="syclus-section bg-slate-50/50 text-slate-900 border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="syclus-section-title">
          Manfaat AP Automation
        </h2>
        <p class="syclus-section-subtitle mx-auto">
          Bebaskan tim finance Anda dari pekerjaan manual berulang, dan alihkan fokus mereka ke hal yang benar-benar penting bagi bisnis.
        </p>
      </div>

      <!-- Checklist Benefits (2 Kolom Sesuai Foto 1) -->
      <div class="max-w-4xl mx-auto mb-14">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-y-5 gap-x-8">
          <div class="syclus-check-item">
            <div class="syclus-check-circle">
              <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </div>
            <span class="text-xs sm:text-sm font-medium text-slate-700 leading-snug">Mencapai akurasi tinggi dan menghilangkan human error</span>
          </div>

          <div class="syclus-check-item">
            <div class="syclus-check-circle">
              <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </div>
            <span class="text-xs sm:text-sm font-medium text-slate-700 leading-snug">Menghemat biaya tenaga kerja dengan menghilangkan input dan review manual</span>
          </div>

          <div class="syclus-check-item">
            <div class="syclus-check-circle">
              <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </div>
            <span class="text-xs sm:text-sm font-medium text-slate-700 leading-snug">Mempersingkat waktu proses faktur dari hitungan hari menjadi menit</span>
          </div>

          <div class="syclus-check-item">
            <div class="syclus-check-circle">
              <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </div>
            <span class="text-xs sm:text-sm font-medium text-slate-700 leading-snug">Mengalihkan tim AP ke tugas bisnis yang lebih strategis</span>
          </div>

          <div class="syclus-check-item md:col-span-2">
            <div class="syclus-check-circle">
              <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </div>
            <span class="text-xs sm:text-sm font-medium text-slate-700 leading-snug">Membangun proses yang skalabel untuk menangani volume data besar</span>
          </div>
        </div>
      </div>

      <!-- 3 Donut Stat Cards Sesuai Foto 1 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <!-- Card 1: 95% Reduce Data Entry -->
        <div class="syclus-metric-card">
          <div class="syclus-metric-donut">
            <svg class="w-14 h-14 -rotate-90 transform" viewBox="0 0 60 60">
              <circle cx="30" cy="30" r="23" stroke="#fef3c7" stroke-width="5.5" fill="none" />
              <circle cx="30" cy="30" r="23" stroke="#f59e0b" stroke-width="5.5" stroke-dasharray="144.5" stroke-dashoffset="7.2" stroke-linecap="round" fill="none" />
            </svg>
            <span class="syclus-metric-donut-text">95%</span>
          </div>
          <div>
            <h4 class="text-sm font-extrabold text-slate-900">Reduce Data Entry</h4>
            <p class="text-xs text-slate-500 mt-0.5">Berkurang hingga 95%</p>
          </div>
        </div>

        <!-- Card 2: 100% Reduce Fraud -->
        <div class="syclus-metric-card">
          <div class="syclus-metric-donut">
            <svg class="w-14 h-14 -rotate-90 transform" viewBox="0 0 60 60">
              <circle cx="30" cy="30" r="23" stroke="#f59e0b" stroke-width="5.5" fill="none" />
            </svg>
            <span class="syclus-metric-donut-text text-[11px]">100%</span>
          </div>
          <div>
            <h4 class="text-sm font-extrabold text-slate-900">Reduce Fraud</h4>
            <p class="text-xs text-slate-500 mt-0.5">Berkurang hingga 100%</p>
          </div>
        </div>

        <!-- Card 3: 80% Improve Approval Time -->
        <div class="syclus-metric-card">
          <div class="syclus-metric-donut">
            <svg class="w-14 h-14 -rotate-90 transform" viewBox="0 0 60 60">
              <circle cx="30" cy="30" r="23" stroke="#fef3c7" stroke-width="5.5" fill="none" />
              <circle cx="30" cy="30" r="23" stroke="#f59e0b" stroke-width="5.5" stroke-dasharray="144.5" stroke-dashoffset="28.9" stroke-linecap="round" fill="none" />
            </svg>
            <span class="syclus-metric-donut-text">80%</span>
          </div>
          <div>
            <h4 class="text-sm font-extrabold text-slate-900">Improve Approval Time</h4>
            <p class="text-xs text-slate-500 mt-0.5">Meningkat 70-80%</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BAGIAN 3: KENAPA ORGANISASI MEMBUTUHKANNYA SEKARANG (SESUAI FOTO 2)
       ========================================================================= -->
  <section class="syclus-section bg-white text-slate-900 border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-12">
        <span class="syclus-badge-pill mb-3">Mengapa AP Automation</span>
        <h2 class="syclus-section-title mt-2">
          Kenapa organisasi Anda<br class="hidden sm:inline" />
          membutuhkannya sekarang
        </h2>
      </div>

      <!-- 3 Cards Grid (01, 02, 03 Sesuai Foto 2) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="syclus-card-reason">
          <span class="syclus-card-number">01</span>
          <h3 class="syclus-reason-title">
            Hilangkan kertas dan input data manual
          </h3>
          <p class="syclus-reason-desc">
            SYCLUS hadir dengan teknologi yang mendukung proses AP di organisasi Anda melalui digitalisasi, otomasi, dan integrasi ke sistem ERP.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="syclus-card-reason">
          <span class="syclus-card-number">02</span>
          <h3 class="syclus-reason-title">
            Pangkas waktu persiapan audit
          </h3>
          <p class="syclus-reason-desc">
            Audit tidak harus membuang waktu. Temukan faktur digital secara instan dan sajikan sebagai arsip yang rapi dan aman.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="syclus-card-reason">
          <span class="syclus-card-number">03</span>
          <h3 class="syclus-reason-title">
            Otomatiskan workflow dan exception handling
          </h3>
          <p class="syclus-reason-desc">
            Bangun persetujuan otomatis berdasarkan nominal, vendor, atau data lain, dan tangani pengecualian dengan rapi tanpa human error.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BAGIAN 4: ENAM LANGKAH, SATU SIKLUS (SESUAI FOTO 2 - DARK NAVY THEME)
       ========================================================================= -->
  <section id="enam-langkah" class="syclus-dark-section text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="syclus-dark-pill mb-3">AP Automation Approach</span>
        <h2 class="syclus-dark-title mt-2">
          Enam langkah, satu siklus yang<br class="hidden sm:inline" />
          berjalan sendiri
        </h2>
        <p class="syclus-dark-subtitle mx-auto">
          Dari penerimaan dokumen hingga arsip audit, setiap tahap saling terhubung dan berjalan otomatis.
        </p>
      </div>

      <!-- 6 Dark Cards Grid (3x2 Sesuai Foto 2) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="syclus-step-dark-card">
          <div class="syclus-step-icon-circle">
            <svg class="w-5 h-5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="syclus-step-title">Capture, Code &amp; Send</h3>
          <p class="syclus-step-desc">
            Dokumen ditangkap otomatis, diberi kode, dan dikirim ke alur kerja.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="syclus-step-dark-card">
          <div class="syclus-step-icon-circle">
            <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="syclus-step-title">Verify &amp; Approve</h3>
          <p class="syclus-step-desc">
            Sistem memverifikasi data dan merutekan ke penanggung jawab yang tepat.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="syclus-step-dark-card">
          <div class="syclus-step-icon-circle">
            <svg class="w-5 h-5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
          </div>
          <h3 class="syclus-step-title">Send to ERP System</h3>
          <p class="syclus-step-desc">
            Data tervalidasi terkirim langsung ke sistem ERP perusahaan.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="syclus-step-dark-card">
          <div class="syclus-step-icon-circle">
            <svg class="w-5 h-5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </div>
          <h3 class="syclus-step-title">Payment Channel</h3>
          <p class="syclus-step-desc">
            Pembayaran diproses melalui kanal yang telah ditentukan.
          </p>
        </div>

        <!-- Step 5 -->
        <div class="syclus-step-dark-card">
          <div class="syclus-step-icon-circle">
            <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="syclus-step-title">Authorize for Payment</h3>
          <p class="syclus-step-desc">
            Otorisasi pembayaran dilakukan sesuai kebijakan internal.
          </p>
        </div>

        <!-- Step 6 -->
        <div class="syclus-step-dark-card">
          <div class="syclus-step-icon-circle">
            <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
          </div>
          <h3 class="syclus-step-title">Archive for Audit</h3>
          <p class="syclus-step-desc">
            Semua dokumen tersimpan rapi dan siap ditelusuri kapan saja.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BAGIAN 5: SEMUA YANG DIBUTUHKAN TIM AP (SESUAI FOTO 3)
       ========================================================================= -->
  <section class="syclus-section bg-white text-slate-900 border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-12">
        <span class="syclus-badge-pill mb-3">Syclus Features</span>
        <h2 class="syclus-section-title mt-2">
          Semua yang dibutuhkan tim AP<br class="hidden sm:inline" />
          dalam satu sistem
        </h2>
      </div>

      <!-- 4 Cards Grid (2x2 Sesuai Foto 3) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Feature 1 -->
        <div class="syclus-feature-item-card">
          <div class="syclus-feature-circle-icon">
            <svg class="w-5 h-5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
          </div>
          <div>
            <h3 class="syclus-feature-title">Storage in a Central Repository</h3>
            <p class="syclus-feature-desc">
              Penyimpanan terpusat meminimalkan risiko dokumen rusak atau hilang, mengurangi redundansi, dan mempermudah kolaborasi.
            </p>
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="syclus-feature-item-card">
          <div class="syclus-feature-circle-icon">
            <svg class="w-5 h-5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="syclus-feature-title">Fast Retrieval of Information</h3>
            <p class="syclus-feature-desc">
              Pengindeksan sistematis membuat konten berharga yang tersimpan di berbagai repositori dapat ditemukan dengan cepat.
            </p>
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="syclus-feature-item-card">
          <div class="syclus-feature-circle-icon">
            <svg class="w-5 h-5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <h3 class="syclus-feature-title">Availability of Audit Trail</h3>
            <p class="syclus-feature-desc">
              Jejak audit mendorong kepatuhan dan mencegah implikasi hukum karena akuntabilitas lebih terjamin dan pelacakan dokumen lebih sederhana.
            </p>
          </div>
        </div>

        <!-- Feature 4 -->
        <div class="syclus-feature-item-card">
