---
import PageLayout from '@/layouts/PageLayout.astro';
import ConsultationCta from '@/components/common/ConsultationCta.astro';
import { generateBreadcrumbSchema, generateProductSchema, generateFaqSchema } from '@/lib/schema-ld';
import type { Product } from '@/types/content';

const productData: Product = {
  id: 'prod-syclus',
  slug: 'syclus',
  name: 'Syclus AP Automation',
  headline: 'Otomatisasi proses Accounts Payable, dari dokumen sampai pembayaran',
  tagline:
    'SYCLUS menyederhanakan proses AP di organisasi Anda lewat digitalisasi, otomasi, dan integrasi langsung ke sistem ERP — mengubah verifikasi dokumen yang memakan hari menjadi hitungan menit.',
  heroImage: '/images/home/home-city-banner.jpg',
  overview:
    'SYCLUS menyederhanakan proses AP di organisasi Anda lewat digitalisasi, otomasi, dan integrasi langsung ke sistem ERP — mengubah verifikasi dokumen yang memakan hari menjadi hitungan menit.',
  features: [
    {
      title: 'Storage in a Central Repository',
      description: 'Penyimpanan terpusat meminimalkan risiko dokumen rusak atau hilang, mengurangi redundansi, dan mempermudah kolaborasi.',
    },
    {
      title: 'Fast Retrieval of Information',
      description: 'Pengindeksan sistematis membuat konten berharga yang tersimpan di berbagai repositori dapat ditemukan dengan cepat.',
    },
    {
      title: 'Availability of Audit Trail',
      description: 'Jejak audit mendorong kepatuhan dan mencegah implikasi hukum karena akuntabilitas lebih terjamin dan pelacakan dokumen lebih sederhana.',
    },
    {
      title: 'Promote a Paperless Environment',
      description: 'Digitalisasi dokumen membantu organisasi mengurangi overhead dan limbah kantor dengan meminimalkan penggunaan kertas.',
    },
  ],
  benefits: [
    'Reduce Data Entry: Berkurang hingga 95%',
    'Reduce Fraud: Berkurang hingga 100%',
    'Improve Approval Time: Meningkat 70-80%',
    'Pencocokan 4-Way Matching otomatis (PO, GRN, Invoice, Tax Document)',
    'Integrasi mulus ke SAP, Oracle, Microsoft Dynamics, dan ERP korporasi',
  ],
  useCases: [
    'Otomatisasi Pembayaran Faktur Supplier & Vendor',
    'Rekonsiliasi 4-Way Matching Dokumen Finansial',
    'Pencegahan Pembayaran Faktur Ganda dan Potensi Fraud',
    'Digitalisasi Arsip Audit dan Kepatuhan Akuntansi',
  ],
  faqs: [
    {
      question: 'Bagaimana cara kerja 4-Way Matching di SYCLUS?',
      answer:
        'Saat faktur masuk, SYCLUS secara otomatis memvalidasi Vendor Master dan mencocokkan Purchase Order (PO), Good Received Notes (GRN), Invoice, dan Tax Document (Faktur Pajak). Jika semua data sesuai, sistem langsung meneruskan ke alur otorisasi pembayaran.',
    },
    {
      question: 'Apakah SYCLUS mendukung integrasi dengan ERP yang sudah digunakan?',
      answer:
        'Ya. SYCLUS mendukung integrasi langsung ke SAP, Oracle NetSuite, Microsoft Dynamics 365, Odoo, Accurate, dan sistem ERP in-house lainnya.',
    },
  ],
};

const breadcrumbs = [
  { name: 'Products', url: '/products/syclus' },
  { name: 'Syclus (AP Automation)', url: '/products/syclus' },
];

const productSchema = generateProductSchema(productData);
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const faqSchema = generateFaqSchema(productData.faqs);
const schema = [productSchema, breadcrumbSchema, faqSchema];
---

<PageLayout
  title="Syclus AP Automation - Otomatisasi Proses Accounts Payable | SolusiAplikasi.id"
  description="SYCLUS menyederhanakan proses AP di organisasi Anda lewat digitalisasi, otomasi, dan integrasi langsung ke sistem ERP — mengubah verifikasi dokumen yang memakan hari menjadi hitungan menit."
  canonical="https://solusiaplikasi.id/products/syclus"
  breadcrumbs={[]}
  schema={schema}
>
  <div class="syclus-page w-full text-slate-900">
    <!-- =========================================================================
         BAGIAN 1: HERO SECTION (SESUAI FOTO 1)
         ========================================================================= -->
    <section class="syclus-hero-section relative overflow-hidden bg-gradient-to-b from-[#f8fafc] via-[#edf4fb] to-white pt-10 sm:pt-12 lg:pt-14 pb-8 sm:pb-10 border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <!-- Col Left: Headline & Text -->
          <div class="lg:col-span-7 text-left">
            <!-- Kicker Badge Sesuai Foto 1 -->
            <div class="mb-4">
              <span class="syclus-badge-pill">AP Automation Solution</span>
            </div>

            <!-- Main Title Sesuai Foto 1 -->
            <h1 class="text-3xl sm:text-4xl lg:text-[44px] font-extrabold text-[#0f172a] leading-[1.18] tracking-tight mb-5">
              Otomatisasi proses<br />
              <span class="text-[#2563eb]">Accounts Payable</span>,<br />
              dari dokumen sampai<br />
              pembayaran.
            </h1>

            <!-- Subtitle Sesuai Foto 1 -->
            <p class="text-slate-600 text-sm sm:text-[15px] leading-relaxed max-w-xl mb-8">
              SYCLUS menyederhanakan proses AP di organisasi Anda lewat digitalisasi, otomasi, dan integrasi langsung ke sistem ERP — mengubah verifikasi dokumen yang memakan hari menjadi hitungan menit.
            </p>

            <!-- Action Buttons Sesuai Foto 1 -->
            <div class="flex flex-wrap items-center gap-3.5 mb-2">
              <a href="#form-konsultasi" class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-[#0d223a] hover:bg-[#1a385c] active:bg-[#081524] text-white text-sm font-bold shadow-md transition-all">
                Jadwalkan Demo
              </a>
              <a href="#alur-ap" class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-[#2563eb] hover:bg-[#1d4ed8] active:bg-[#1e40af] text-white text-sm font-bold shadow-md transition-all">
                Lihat Cara Kerja
              </a>
            </div>
          </div>

          <!-- Col Right: Hero Graphic Menuju 2025 Sesuai Referensi -->
          <div class="lg:col-span-5 flex justify-center lg:justify-end">
            <div class="relative w-full max-w-[360px] sm:max-w-[400px]">
              <img
                src="/images/product/syclus/syclus-hero-stat.webp"
                alt="Menuju 2025: 50% faktur business-to-business di seluruh dunia akan diproses dan dibayar tanpa intervensi manual"
                width="1024"
                height="1009"
                class="w-full h-auto drop-shadow-2xl transition-transform duration-300 hover:scale-[1.02]"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <!-- Target Sector Strip Sesuai Foto 1 -->
        <div class="pt-6 sm:pt-8 text-center">
          <p class="text-[11px] font-bold text-slate-400 tracking-wider uppercase mb-3">
            DIRANCANG UNTUK TIM FINANCE &amp; AP DI BERBAGAI SEKTOR
          </p>
          <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5">
            <span class="px-4 py-1.5 rounded-full bg-[#dbeafe] text-[#1e40af] text-xs font-semibold">Manufaktur</span>
            <span class="px-4 py-1.5 rounded-full bg-[#dbeafe] text-[#1e40af] text-xs font-semibold">Distribusi</span>
            <span class="px-4 py-1.5 rounded-full bg-[#dbeafe] text-[#1e40af] text-xs font-semibold">Logistik</span>
            <span class="px-4 py-1.5 rounded-full bg-[#dbeafe] text-[#1e40af] text-xs font-semibold">Perkebunan</span>
            <span class="px-4 py-1.5 rounded-full bg-[#dbeafe] text-[#1e40af] text-xs font-semibold">Pertambangan &amp; Energi</span>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         BAGIAN 2: MANFAAT AP AUTOMATION (SESUAI FOTO 2)
         ========================================================================= -->
    <section class="syclus-section bg-[#EEF4FC] py-10 sm:py-12 border-b border-[#dbe6f5]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header Sesuai Foto 2 -->
        <div class="text-center max-w-2xl mx-auto mb-7 sm:mb-8">
          <h2 class="text-2xl sm:text-3xl lg:text-[34px] font-extrabold text-[#0f172a] tracking-tight mb-2.5">
            Manfaat AP Automation
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Otomatiskan proses Accounts Payable, kurangi pekerjaan manual, dan berikan tim Finance lebih banyak waktu untuk fokus pada aktivitas strategis bisnis.
          </p>
        </div>

        <!-- Checklist Benefits (2 Kolom Sesuai Foto 2) -->
        <div class="max-w-4xl mx-auto mb-7 sm:mb-8">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-y-5 gap-x-8 lg:gap-x-12">
            <!-- Left Column (3 items) -->
            <div class="space-y-4 sm:space-y-5">
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-[#0d223a] text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-xs sm:text-[13px] font-semibold text-slate-800 leading-snug">Menghilangkan Human Error dan Mencapai Akurasi yang Tinggi</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-[#0d223a] text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-xs sm:text-[13px] font-semibold text-slate-800 leading-snug">Mengurangi Biaya Operasional dengan Menghilangkan Proses Input dan Review Manual</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-[#0d223a] text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-xs sm:text-[13px] font-semibold text-slate-800 leading-snug">Mempercepat Pemrosesan Invoice dari Hitungan Hari Menjadi Menit</span>
              </div>
            </div>

            <!-- Right Column (2 items) -->
            <div class="space-y-4 sm:space-y-5">
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-[#0d223a] text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-xs sm:text-[13px] font-semibold text-slate-800 leading-snug">Mengalihkan Fokus Tim AP ke Aktivitas Bisnis yang Lebih Strategis</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-[#0d223a] text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-xs sm:text-[13px] font-semibold text-slate-800 leading-snug">Membangun Proses AP yang Skalabel untuk Menangani Volume Transaksi Besar</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 3 Donut Stat Cards Sesuai Foto 2 -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 max-w-4xl mx-auto">
          <!-- Card 1: 95% Reduce Data Entry -->
          <div class="bg-white border border-slate-100 rounded-2xl p-5 sm:p-6 flex items-center gap-4 shadow-xs">
            <div class="relative w-14 h-14 shrink-0 flex items-center justify-center">
              <svg class="w-full h-full -rotate-90 transform" viewBox="0 0 60 60">
                <circle cx="30" cy="30" r="23" stroke="#fef3c7" stroke-width="5.5" fill="none" />
                <circle cx="30" cy="30" r="23" stroke="#f59e0b" stroke-width="5.5" stroke-dasharray="144.5" stroke-dashoffset="7.2" stroke-linecap="round" fill="none" />
              </svg>
              <span class="absolute text-xs font-bold text-[#0f172a]">95%</span>
            </div>
            <div>
              <h4 class="text-sm font-bold text-[#0f172a]">Reduce Data Entry</h4>
              <p class="text-xs text-slate-500 mt-0.5">Berkurang hingga 95%</p>
            </div>
          </div>

          <!-- Card 2: 100% Reduce Fraud -->
          <div class="bg-white border border-slate-100 rounded-2xl p-5 sm:p-6 flex items-center gap-4 shadow-xs">
            <div class="relative w-14 h-14 shrink-0 flex items-center justify-center">
              <svg class="w-full h-full -rotate-90 transform" viewBox="0 0 60 60">
                <circle cx="30" cy="30" r="23" stroke="#f59e0b" stroke-width="5.5" fill="none" />
              </svg>
              <span class="absolute text-[11px] font-bold text-[#0f172a]">100%</span>
            </div>
            <div>
              <h4 class="text-sm font-bold text-[#0f172a]">Reduce Fraud</h4>
              <p class="text-xs text-slate-500 mt-0.5">Berkurang hingga 100%</p>
            </div>
          </div>

          <!-- Card 3: 80% Improve Approval Time -->
          <div class="bg-white border border-slate-100 rounded-2xl p-5 sm:p-6 flex items-center gap-4 shadow-xs">
            <div class="relative w-14 h-14 shrink-0 flex items-center justify-center">
              <svg class="w-full h-full -rotate-90 transform" viewBox="0 0 60 60">
                <circle cx="30" cy="30" r="23" stroke="#fef3c7" stroke-width="5.5" fill="none" />
                <circle cx="30" cy="30" r="23" stroke="#f59e0b" stroke-width="5.5" stroke-dasharray="144.5" stroke-dashoffset="28.9" stroke-linecap="round" fill="none" />
              </svg>
              <span class="absolute text-xs font-bold text-[#0f172a]">80%</span>
            </div>
            <div>
              <h4 class="text-sm font-bold text-[#0f172a]">Improve Approval Time</h4>
              <p class="text-xs text-slate-500 mt-0.5">Meningkat 70–80%</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         BAGIAN 3: KENAPA ORGANISASI MEMBUTUHKANNYA SEKARANG (SESUAI FOTO 3)
         ========================================================================= -->
    <section class="syclus-section bg-white pt-10 sm:pt-12 pb-10 sm:pb-12 border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Top Sub-section Header Sesuai Foto 3 -->
        <div class="mb-7 sm:mb-8 text-left">
          <span class="syclus-badge-pill mb-3">Mengapa AP Automation</span>
          <h2 class="text-2xl sm:text-3xl lg:text-[34px] font-extrabold text-[#0f172a] tracking-tight mt-2">
            Kenapa organisasi Anda<br class="hidden sm:inline" />
            membutuhkannya sekarang
          </h2>
        </div>

        <!-- 3 Reason Cards (01, 02, 03 Sesuai Foto 3) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-0">
          <!-- Card 01 -->
          <div class="bg-white border border-slate-200/90 rounded-2xl p-6 sm:p-7 shadow-xs">
            <span class="block text-xs font-mono font-bold text-[#2563eb] mb-3">01</span>
            <h3 class="text-base sm:text-lg font-bold text-[#0f172a] mb-2.5 leading-snug">
              Hilangkan kertas dan input data manual
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed">
              SYCLUS hadir dengan teknologi yang mendukung proses AP di organisasi Anda melalui digitalisasi, otomasi, dan integrasi ke sistem ERP.
            </p>
          </div>

          <!-- Card 02 -->
          <div class="bg-white border border-slate-200/90 rounded-2xl p-6 sm:p-7 shadow-xs">
            <span class="block text-xs font-mono font-bold text-[#2563eb] mb-3">02</span>
            <h3 class="text-base sm:text-lg font-bold text-[#0f172a] mb-2.5 leading-snug">
              Pangkas waktu persiapan audit
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed">
              Audit tidak harus membuang waktu. Temukan faktur digital secara instan dan sajikan sebagai arsip yang rapi dan aman.
            </p>
          </div>

          <!-- Card 03 -->
          <div class="bg-white border border-slate-200/90 rounded-2xl p-6 sm:p-7 shadow-xs">
            <span class="block text-xs font-mono font-bold text-[#2563eb] mb-3">03</span>
            <h3 class="text-base sm:text-lg font-bold text-[#0f172a] mb-2.5 leading-snug">
              Otomatiskan Workflow dan Exception Handling
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed">
              Otomatiskan alur persetujuan berdasarkan nominal, vendor, dan regulasi perusahaan. Invoice yang telah sesuai dengan ketentuan dapat diproses otomatis, sementara invoice yang memiliki ketidaksesuaian diteruskan untuk di review
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom Sub-section: AP Automation Approach (Dark Navy Theme Sesuai Foto 3) -->
    <section id="alur-ap" class="syclus-section bg-[#0b172a] text-white py-10 sm:py-14">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header Sesuai Foto 3 -->
        <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
          <span class="inline-block px-3.5 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-300 text-xs font-bold uppercase tracking-wider mb-3">
            AP Automation Approach
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-[34px] font-extrabold text-white tracking-tight mb-2.5">
            Otomatisasi Menyeluruh dalam Proses AP
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-xl mx-auto">
            Sederhanakan proses Accounts Payable melalui alur kerja otomatis dari penerimaan dokumen hingga penyelesaian transaksi.
          </p>
        </div>

          <!-- 6 Cards Grid Sesuai Foto 3 -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Card 1: Vendor Portal -->
            <div class="bg-[#11223b] border border-slate-700/60 rounded-2xl p-6 transition-all hover:border-sky-400/50">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-sky-400 to-blue-600 flex items-center justify-center mb-4.5 shadow-md">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-white mb-2">Vendor Portal</h3>
              <p class="text-xs sm:text-[13px] text-slate-300 leading-relaxed">
                Vendor mengunggah invoice dan dokumen pendukung secara mandiri melalui portal terintegrasi.
              </p>
            </div>

            <!-- Card 2: OCR AI Extraction -->
            <div class="bg-[#11223b] border border-slate-700/60 rounded-2xl p-6 transition-all hover:border-amber-400/50">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center mb-4.5 shadow-md">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-white mb-2">OCR AI Extraction</h3>
              <p class="text-xs sm:text-[13px] text-slate-300 leading-relaxed">
                AI secara otomatis mengekstrak data invoice dan dokumen pendukung dengan cepat dan akurat.
              </p>
            </div>

            <!-- Card 3: Verify 4-Way Matching -->
            <div class="bg-[#11223b] border border-slate-700/60 rounded-2xl p-6 transition-all hover:border-teal-400/50">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-teal-400 to-emerald-600 flex items-center justify-center mb-4.5 shadow-md">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-white mb-2">Verify 4-Way Matching</h3>
              <p class="text-xs sm:text-[13px] text-slate-300 leading-relaxed">
                Sistem mencocokkan data invoice dengan PO, Goods Receipt, dan dokumen pendukung lainnya.
              </p>
            </div>

            <!-- Card 4: Approve -->
            <div class="bg-[#11223b] border border-slate-700/60 rounded-2xl p-6 transition-all hover:border-blue-400/50">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-400 to-indigo-600 flex items-center justify-center mb-4.5 shadow-md">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-white mb-2">Approve</h3>
              <p class="text-xs sm:text-[13px] text-slate-300 leading-relaxed">
                Invoice yang sesuai ketentuan diteruskan untuk approval berdasarkan workflow dan kebijakan perusahaan.
              </p>
            </div>

            <!-- Card 5: Send to ERP System -->
