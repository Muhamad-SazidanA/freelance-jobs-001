---
import PageLayout from "@/layouts/PageLayout.astro";
import ConsultationCta from "@/components/common/ConsultationCta.astro";
import CycloneFlowDiagram from "@/components/cyclone/CycloneFlowDiagram.astro";
import {
  generateBreadcrumbSchema,
  generateProductSchema,
  generateFaqSchema,
} from "@/lib/schema-ld";
import type { Product } from "@/types/content";

const productData: Product = {
  id: "prod-cyclone",
  slug: "cyclone",
  name: "Cyclone RPA",
  headline: "Robot yang Bekerja Tanpa Henti, Tepat Seperti yang Anda Minta",
  tagline:
    "Cyclone mengotomasi pekerjaan digital yang berulang dari membuka aplikasi hingga mengirim laporan langsung di atas sistem yang sudah Anda pakai, tanpa perlu mengganggunya.",
  heroImage: "/images/product/cyclone/cyclone-dashboard-real.webp",
  overview:
    "Cyclone adalah platform Robotic Process Automation (RPA) modern yang menghubungkan aplikasi web, desktop legacy, mainframe, dan spreadsheet untuk menyelesaikan pekerjaan manual tanpa henti 24/7.",
  features: [
    {
      title: "Cyclone Robot",
      description:
        "Robot perangkat lunak yang mengeksekusi pekerjaan secara attended maupun unattended 24 jam sehari.",
    },
    {
      title: "Cyclone Designer",
      description:
        "Alat rancang alur kerja visual drag-and-drop tanpa butuh coding rumit.",
    },
    {
      title: "Cyclone Controller",
      description:
        "Pusat kendali seluruh robot untuk penjadwalan, monitoring status, dan audit log real-time.",
    },
  ],
  benefits: [
    "Penghematan biaya operasional hingga ±60%",
    "Peningkatan produktivitas pekerjaan berulang hingga ±80%",
    "Nol human error pada proses yang terdefinisi dengan baik",
    "Jam operasional 7x24 jam tanpa tambahan headcount",
  ],
  useCases: [
    "Pemrosesan Faktur & Hutang Vendor",
    "Sinkronisasi Stok E-Commerce & Gudang ERP",
    "Penerbitan Sales Order Otomatis dari Email Masuk",
  ],
  faqs: [
    {
      question: "Apakah Cyclone membutuhkan perubahan pada sistem lama kami?",
      answer:
        "Tidak. Bot Cyclone berinteraksi dengan sistem lama melalui lapisan UI dan API, sehingga tidak mengganggu database sistem yang sedang aktif.",
    },
    {
      question: "Bagaimana keamanan data dan kredensial akses pada bot?",
      answer:
        "Seluruh kredensial disimpan di brankas terenkripsi (Credential Vault) berstandar AES-256 dan hanya dapat diakses saat sesi eksekusi tugas berlangsung.",
    },
  ],
};

const breadcrumbs = [
  { name: "Products", url: "/products/cyclone" },
  { name: "Cyclone (RPA)", url: "/products/cyclone" },
];

const productSchema = generateProductSchema(productData);
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const faqSchema = generateFaqSchema(productData.faqs);
const schema = [productSchema, breadcrumbSchema, faqSchema];
---

<PageLayout
  title="Cyclone RPA - Robot yang Bekerja Tanpa Henti, Tepat Seperti yang Anda Minta | SolusiAplikasi.id"
  description="Cyclone mengotomasi pekerjaan digital yang berulang dari membuka aplikasi hingga mengirim laporan langsung di atas sistem yang sudah Anda pakai, tanpa perlu mengganggunya."
  canonical="https://solusiaplikasi.id/products/cyclone"
  breadcrumbs={[]}
  schema={schema}
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;500;700&display=swap" />

  <!-- SVG Global Symbol & Pattern Definitions -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <symbol id="clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
      <symbol id="warn" viewBox="0 0 24 24"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></symbol>
      <symbol id="users" viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2M16 3.1a4 4 0 0 1 0 7.8M22 21v-2a4 4 0 0 0-3-3.9"/></symbol>
      <symbol id="shield" viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5 3.4 9 8 11 4.6-2 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/></symbol>
      <symbol id="link" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></symbol>
      <symbol id="bank" viewBox="0 0 24 24"><path d="M3 21h18M5 21V10M9 21V10M15 21V10M19 21V10M2 10l10-7 10 7z"/></symbol>
      <symbol id="fact" viewBox="0 0 24 24"><path d="M2 21V9l6 4V9l6 4V4h4v17zM6 17h.01M10 17h.01M14 17h.01"/></symbol>
      <symbol id="cart" viewBox="0 0 24 24"><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M2 3h3l3 12h11l2-8H6"/></symbol>
      <symbol id="truck" viewBox="0 0 24 24"><path d="M1 4h13v12H1zM14 8h4l4 4v4h-8"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></symbol>
      <symbol id="heart" viewBox="0 0 24 24"><path d="M20.8 5.6a5.5 5.5 0 0 0-8.8-1.5 5.5 5.5 0 0 0-8.8 7L12 21l8.8-9.9a5.5 5.5 0 0 0 0-5.5z"/><path d="M3 12h5l2-3 3 6 2-3h6"/></symbol>
      <symbol id="phone" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></symbol>
      <symbol id="ne" viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9"/></symbol>
      <symbol id="ck" viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></symbol>
      <symbol id="box" viewBox="0 0 24 24"><rect x="3" y="11" width="8" height="8" rx="1"/><circle cx="17" cy="15" r="4"/><path d="M7 11V7h4M17 3v4"/></symbol>
      <g id="pf"><ellipse cx="0" cy="30" rx="58" ry="15" fill="#ff8a3d" opacity=".4"/><path d="M-50,10 L0,-16 L50,10 L0,36z" fill="#111" stroke="#111" stroke-width="12" stroke-linejoin="round"/><path d="M-50,2 L0,-24 L50,2 L0,28z" fill="#fff5ec" stroke="#fff5ec" stroke-width="12" stroke-linejoin="round"/><ellipse cx="0" cy="2" rx="20" ry="8" fill="#ffe3cf"/></g>
      <g id="i1"><rect x="-14" y="-62" width="40" height="26" rx="4" fill="#ffd2b0"/><circle cx="10" cy="-55" r="2" fill="#f4511e"/><rect x="-34" y="-50" width="42" height="30" rx="4" fill="#f4511e"/><path d="m-33,-47 21,15 21,-15" stroke="#fff" stroke-width="3" fill="none"/><circle cx="22" cy="-46" r="5" fill="#111"/></g>
      <g id="i2"><rect x="-22" y="-70" width="36" height="46" rx="3" fill="#ff9a4a"/><path d="M-14,-58h20M-14,-50h20M-14,-42h12" stroke="#fff" stroke-width="3"/><circle cx="18" cy="-24" r="9" fill="#111"/><circle cx="18" cy="-24" r="3.5" fill="#ffd0aa"/></g>
      <g id="i3"><path d="M-30,-68v-10h10M30,-68v-10h-10M-30,-26v10h10M30,-26v10h-10" stroke="#111" stroke-width="3" fill="none"/><rect x="-18" y="-64" width="36" height="42" rx="3" fill="#f4511e"/><text x="0" y="-38" text-anchor="middle" font-size="15" font-weight="700" fill="#fff" font-family="'Plus Jakarta Sans',sans-serif">AI</text><path d="M-26,-42h52" stroke="#111" stroke-width="2"/></g>
      <g id="i4"><ellipse cx="0" cy="-30" rx="24" ry="8" fill="#ff9a4a"/><path d="M-24,-30v-12a24 8 0 0 1 48 0v12a24 8 0 0 1-48 0z" fill="#f4511e"/><ellipse cx="0" cy="-42" rx="24" ry="8" fill="#ffb27a"/><ellipse cx="0" cy="-54" rx="24" ry="8" fill="#ffb27a"/><path d="M-24,-54v12M24,-54v12" stroke="#f4511e" stroke-width="2"/><circle cx="26" cy="-26" r="9" fill="#ffb347"/><path d="m22,-26 3,3 5,-6" stroke="#fff" stroke-width="2.5" fill="none"/></g>
      <g id="i5"><rect x="-26" y="-70" width="44" height="52" rx="3" fill="#ffe2cf"/><path d="M-18,-58h26M-18,-48h26M-18,-38h26M-18,-28h18" stroke="#f4511e" stroke-width="3"/><circle cx="20" cy="-26" r="11" fill="#ff9d2e"/><path d="m14,-26 4,4 7,-8" stroke="#fff" stroke-width="3" fill="none"/></g>
      <g id="i6"><rect x="-24" y="-68" width="46" height="50" rx="3" fill="#fff" stroke="#f4a070" stroke-width="2"/><rect x="-24" y="-68" width="46" height="9" fill="#ff9a4a"/><path d="M-16,-50h30M-16,-42h30M-16,-34h30M-16,-26h20" stroke="#9db4d6" stroke-width="3"/></g>
      <g id="i7"><path d="M-22,-24c0-8 4-14 4-24a18 18 0 0 1 36 0c0 10 4 16 4 24z" fill="#f4511e"/><circle cx="0" cy="-66" r="4" fill="#f4511e"/><rect x="-26" y="-24" width="52" height="5" rx="2" fill="#f4511e"/><circle cx="0" cy="-17" r="5" fill="#111"/><circle cx="-24" cy="-8" r="7" fill="#fff" stroke="#ff9a4a" stroke-width="2"/><circle cx="24" cy="-8" r="7" fill="#fff" stroke="#ff9a4a" stroke-width="2"/></g>
      <g id="i8"><rect x="-26" y="-72" width="46" height="54" rx="3" fill="#ffc9a3"/><path d="M-18,-60h24M-18,-52h24M-18,-44h14" stroke="#fff" stroke-width="3"/><circle cx="22" cy="-26" r="13" fill="#ff9d2e"/><path d="m15,-26 5,5 8,-10" stroke="#fff" stroke-width="3.5" fill="none"/></g>
    </defs>
  </svg>

  <div class="cyclone-page w-full">
    <!-- SECTION 1: HERO -->
    <div class="hero">
      <div class="w">
        <div class="hg">
          <div>
            <h1>Robot yang bekerja tanpa henti, tepat seperti yang Anda minta.</h1>
            <p class="l">
              Cyclone mengotomasi pekerjaan digital yang berulang, dari membuka aplikasi hingga mengirim laporan, langsung di atas sistem yang sudah Anda pakai.
            </p>
            <div class="stats">
              <div>
                <svg class="i"><use href="#clock"/></svg>
                <span><b>24 jam</b>Bekerja nonstop</span>
              </div>
              <div>
                <svg class="i"><use href="#link"/></svg>
                <span><b>Terhubung</b>Ke sistem Anda</span>
              </div>
              <div>
                <svg class="i"><use href="#shield"/></svg>
                <span><b>Tanpa ubah</b>Sistem yang ada</span>
              </div>
            </div>
            <div class="cta">
              <a class="btn w1" href="#form-konsultasi">Jadwalkan Demo <i>&rarr;</i></a>
              <a class="btn gh" href="#alur">Lihat Cara Kerja</a>
            </div>
          </div>

          <div class="dwrap">
            <div class="dash" role="img" aria-label="Contoh tampilan dashboard Cyclone Controller">
              <div class="dt">
                <span class="dots">
                  <i style="background:#ff5f57"></i>
                  <i style="background:#febc2e"></i>
                  <i style="background:#28c840"></i>
                </span>
                <b>CYCLONE .</b>
                <span class="tab">Controller</span>
                <span>System Settings</span>
                <span class="r">
                  <span style="color:#28c840">●</span>2026-11-11 14:47:47<span class="av">ad</span>
                </span>
              </div>
              <div class="sd">
                <span class="on">Dashboard</span>
                <span>Task ⌄</span>
                <span>Process ⌄</span>
                <span>Client ⌄</span>
                <span>Data ⌄</span>
                <span>Business log</span>
                <span>Operations ⌄</span>
                <span>Other Settings ⌄</span>
              </div>
              <div class="mn">
                <div class="k4">
                  <div class="kc">
                    <h5>Historical Tasks<u>Today ⌄</u></h5>
                    <div class="n">1,248</div>
                    <small>Number of tasks executed successfully</small>
                    <div class="row">
                      <i class="ring" style="--p:70%;--a:#2b5de0;--b:#d6dbe6"></i>
                      <span class="lg"><i>Succeeded</i><i>Cancel manually</i><i>Exception</i></span>
                    </div>
                  </div>
                  <div class="kc">
                    <h5>Task Schedule<u>Today ⌄</u></h5>
                    <div class="n">12</div>
                    <small>Total number of schedules</small>
                    <div class="row">
                      <i class="ring" style="--p:60%;--a:#f0a43a;--b:#2b5de0"></i>
                      <span class="lg"><i>Disable</i><i>Start</i><i>End</i></span>
                    </div>
                  </div>
                  <div class="kc">
                    <h5>Task Queue<u>All Robots ⌄</u></h5>
                    <div class="n">3</div>
                    <small>Tasks in progress</small>
                    <div class="row">
                      <i class="ring" style="--p:66%;--a:#f0a43a;--b:#2fb872"></i>
                      <span class="lg"><i>Running</i><i>To run</i></span>
                    </div>
                  </div>
                  <div class="kc">
                    <h5>Robot Status<u>All Robots ⌄</u></h5>
                    <div class="n">5</div>
                    <small>Total number of online robots</small>
                    <div class="row">
                      <i class="ring" style="--p:40%;--a:#2fb872;--b:#d6dbe6"></i>
                      <span class="lg"><i>Idle</i><i>Busy</i><i>Unavailable</i><i>Offline</i></span>
                    </div>
                  </div>
                </div>
                <div class="op">
                  <b>Task Operating Situation</b>
                  <div class="f">
                    <span>All Robots</span>
                    <span>Select</span>
                    <span>Select</span>
                    <span class="b">Search</span>
                  </div>
                  <svg viewBox="0 0 400 90" preserveAspectRatio="none">
                    <g stroke="#eee">
                      <path d="M0 10h400M0 35h400M0 60h400M0 85h400"/>
                    </g>
                    <polyline fill="none" stroke="#2b5de0" stroke-width="2" points="0,80 50,70 100,66 150,46 200,52 250,32 300,40 350,28 400,34"/>
                    <polyline fill="none" stroke="#2fb872" stroke-width="2" points="0,82 50,75 100,72 150,56 200,58 250,42 300,48 350,38 400,42"/>
                    <polyline fill="none" stroke="#e5484d" stroke-width="2" points="0,84 100,82 200,80 300,81 400,79"/>
                  </svg>
                </div>
              </div>
            </div>
            <div class="badge">
              <i>✓</i>
              <div>
                Sales Order dibuat di SAP
                <span>PO-2026-1184 selesai dalam 42 dtk</span>
              </div>
            </div>
            <p class="cap">Contoh tampilan Cyclone dengan data ilustrasi.</p>
          </div>
        </div>
      </div>
      <div class="strip">
        Berjalan di atas sistem yang sudah Anda pakai, tanpa mengubah atau mengganggunya.
        <div class="chips">
          <span>Email</span>
          <span>Portal pelanggan</span>
          <span>Database master</span>
          <span>SAP</span>
          <span>Aplikasi desktop dan web</span>
        </div>
      </div>
    </div>

    <!-- SECTION 2: SEBELUM CYCLONE -->
    <section>
      <div class="w">
        <div class="eb">Sebelum Cyclone</div>
        <h2>Mengapa harus menghabiskan waktu untuk pekerjaan rutin jika semuanya bisa diotomatisasi?</h2>
        <div class="g3">
          <div class="card">
            <span class="n">01</span>
            <div class="ic"><svg class="i"><use href="#clock"/></svg></div>
            <h3>Waktu habis untuk input data</h3>
            <p>Staf memindahkan data yang sama dari satu sistem ke sistem lain, berulang setiap hari — waktu yang seharusnya bisa dipakai untuk pekerjaan yang lebih bernilai.</p>
          </div>
          <div class="card">
            <span class="n">02</span>
            <div class="ic"><svg class="i"><use href="#warn"/></svg></div>
            <h3>Human error yang terus berulang</h3>
            <p>Semakin banyak dan semakin cepat pekerjaan manual dikerjakan, semakin besar peluang salah ketik, salah baca, atau data yang terlewat.</p>
          </div>
          <div class="card">
            <span class="n">03</span>
            <div class="ic"><svg class="i"><use href="#users"/></svg></div>
            <h3>Sulit menambah kapasitas</h3>
            <p>Saat volume transaksi naik, satu-satunya jalan yang terpikir adalah menambah orang — biaya rekrutmen, training, dan waktu terus bertambah.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: ARSITEKTUR PRODUK -->
    <section style="padding-top:20px">
      <div class="w">
        <div class="eb">Arsitektur Produk</div>
        <h2>Komponen Utama Robotic Process Automation</h2>
        <p class="sub">Cyclone terdiri dari beberapa komponen utama untuk mendukung proses otomasi, mulai dari perancangan flow, Executor, hingga pemantauan dan pengelolaan aktivitas robot.</p>
        <div class="rows">
          <div class="row">
            <small>01</small>
            <div>
              <h3>Cyclone Robot</h3>
              <span>Executor</span>
            </div>
            <p>Robot perangkat lunak yang menjalankan proses pekerjaan secara otomatis, dengan dua pilihan attended maupun unattended, yang dapat berjalan 24 jam sehari tanpa penurunan performa.</p>
          </div>
          <div class="row">
            <small>02</small>
            <div>
              <h3>Cyclone Designer</h3>
              <span>Builder</span>
            </div>
            <p>Alat untuk merancang alur kerja (flow) secara visual menggunakan metode drag and drop. Tim operasional dapat menyusun proses otomasi secara mandiri tanpa harus menulis coding yang rumit.</p>
          </div>
          <div class="row">
            <small>03</small>
            <div>
              <h3>Cyclone Controller</h3>
              <span>Manager</span>
            </div>
            <p>Pusat kendali seluruh robot — menjadwalkan tugas, memantau status tiap bot secara real-time, dan menyimpan log audit dari satu dashboard.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: MODE OPERASI -->
    <section style="padding-top:20px">
      <div class="w">
        <div class="eb">Mode Operasi</div>
        <h2>Otomasi yang menyesuaikan cara tim Anda bekerja</h2>
        <div class="modes">
          <div class="mode a">
            <div class="t">
              <h3>Attended</h3>
              <i><svg class="i"><use href="#users"/></svg></i>
            </div>
            <b>Robot bekerja bersama tim Anda</b>
            <p>Diaktifkan oleh staf saat dibutuhkan, membantu di tengah proses yang masih memerlukan keputusan manusia pada titik-titik tertentu.</p>
          </div>
          <div class="mode u">
            <div class="t">
              <h3>Unattended</h3>
              <i><svg class="i"><use href="#box"/></svg></i>
            </div>
            <b>Robot bekerja secara mandiri</b>
            <p>Jadwalkan robot untuk menjalankan rangkaian pekerjaan. Proses dapat berjalan tanpa harus menunggu staf mengoperasikan setiap langkahnya.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: SIAPA YANG MEMAKAI -->
    <section style="padding-top:40px">
      <div class="w">
        <div class="eb">Siapa yang memakai</div>
        <h2>Dipakai lintas industri, di proses yang volumenya tinggi dan berulang</h2>
        <p class="sub">Cyclone mengotomatiskan pekerjaan manual yang repetitif, dari input data sampai rekonsiliasi, tanpa mengubah sistem yang sudah Anda pakai.</p>
        <div class="ind">
          <div class="card">
            <div class="ic"><svg class="i"><use href="#bank"/></svg></div>
            <span class="ar"><svg class="i"><use href="#ne"/></svg></span>
            <h3>Keuangan &amp; Perbankan</h3>
            <p>Kurangi input manual di tim finance.</p>
            <ul>
              <li><svg class="i"><use href="#ck"/></svg>Pemrosesan faktur &amp; hutang vendor</li>
              <li><svg class="i"><use href="#ck"/></svg>Rekonsiliasi akun antar sistem</li>
            </ul>
          </div>
          <div class="card">
            <div class="ic"><svg class="i"><use href="#fact"/></svg></div>
            <span class="ar"><svg class="i"><use href="#ne"/></svg></span>
            <h3>Manufaktur</h3>
            <p>Data pabrik selalu rapi dan terbarui.</p>
            <ul>
              <li><svg class="i"><use href="#ck"/></svg>Pembaruan stok &amp; laporan gudang</li>
              <li><svg class="i"><use href="#ck"/></svg>Kompilasi data kontrol kualitas</li>
            </ul>
          </div>
          <div class="card">
            <div class="ic"><svg class="i"><use href="#cart"/></svg></div>
            <span class="ar"><svg class="i"><use href="#ne"/></svg></span>
            <h3>Retail &amp; Distribusi</h3>
            <p>Dari pesanan masuk sampai ke ERP.</p>
            <ul>
              <li><svg class="i"><use href="#ck"/></svg>Input pesanan dari email/portal</li>
              <li><svg class="i"><use href="#ck"/></svg>Pembuatan Sales Order ke ERP</li>
            </ul>
          </div>
          <div class="card">
            <div class="ic"><svg class="i"><use href="#truck"/></svg></div>
            <span class="ar"><svg class="i"><use href="#ne"/></svg></span>
            <h3>Logistik</h3>
            <p>Status &amp; dokumen tanpa ketik ulang.</p>
            <ul>
              <li><svg class="i"><use href="#ck"/></svg>Pembaruan status pengiriman</li>
              <li><svg class="i"><use href="#ck"/></svg>Proses retur barang &amp; dokumen</li>
            </ul>
          </div>
          <div class="card">
            <div class="ic"><svg class="i"><use href="#heart"/></svg></div>
            <span class="ar"><svg class="i"><use href="#ne"/></svg></span>
            <h3>Kesehatan</h3>
            <p>Administrasi pasien lebih cepat &amp; akurat.</p>
            <ul>
              <li><svg class="i"><use href="#ck"/></svg>Input data rekam medis pasien</li>
              <li><svg class="i"><use href="#ck"/></svg>Verifikasi klaim asuransi</li>
            </ul>
