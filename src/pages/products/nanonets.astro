---
import PageLayout from '@/layouts/PageLayout.astro';
import ConsultationCta from '@/components/common/ConsultationCta.astro';
import { generateBreadcrumbSchema, generateProductSchema, generateFaqSchema } from '@/lib/schema-ld';
import type { Product } from '@/types/content';

const productData: Product = {
  id: 'prod-nanonets',
  slug: 'nanonets',
  name: 'Nanonets',
  headline: 'Dokumen Masuk, Data Terstruktur Keluar Otomatis',
  tagline: 'Nanonets mengekstrak data dari invoice, KTP, faktur pajak, hingga dokumen tabel kompleks — tanpa perlu setup rules atau template manual.',
  heroImage: '/images/home/home-nanonets-dashboard.jpg',
  overview:
    'Nanonets memanfaatkan deep learning vision untuk membaca dan mengonversi jutaan dokumen tidak terstruktur menjadi data terstruktur siap integrasi ke ERP internal Anda secara instan.',
  features: [
    {
      title: 'Model custom untuk dokumen Anda',
      description: 'Bangun model ekstraksi yang dilatih khusus dari dokumen milik perusahaan Anda sendiri.',
    },
    {
      title: 'Ekstraksi tabel terbaik',
      description: 'Pemetaan kolom-baris otomatis untuk mengubah tabel jadi data terstruktur.',
    },
    {
      title: 'Akurasi tinggi di dokumen kompleks',
      description: 'Bekerja secara konsisten pada berbagai jenis dan format dokumen.',
    },
    {
      title: 'JSON API siap pakai',
      description: 'Mendukung kustomisasi dan langsung bisa dipakai untuk model & tipe dokumen baru.',
    },
  ],
  benefits: [
    'Memangkas waktu input data dokumen hingga 90%',
    'Mengeliminasi human-error dalam rekonsiliasi keuangan',
    'Kepatuhan standar keamanan enkripsi TLS 1.3 dan audit ISO 27001',
  ],
  useCases: [
    'Pengolahan Faktur Pajak & Invoice Supplier Skala Besar',
    'Digitalisasi Klaim Asuransi & Form Registrasi Medis',
    'Verifikasi Dokumen Identitas (KYC) dan Legalitas Finansial',
  ],
  faqs: [
    {
      question: 'Berapa lama waktu yang dibutuhkan untuk mengekstrak 1 halaman dokumen?',
      answer: 'Rata-rata waktu pemrosesan adalah 2-3 detik per halaman dengan tingkat akurasi hingga 99%.',
    },
    {
      question: 'Apakah Nanonets mendukung integrasi on-premise atau private cloud?',
      answer: 'Ya, kami menyediakan opsi deployment cloud maupun hybrid on-premise sesuai regulasi perbankan dan enterprise.',
    },
  ],
};

const breadcrumbs = [
  { name: 'Products', url: '/products/nanonets' },
  { name: 'Nanonets (AI OCR)', url: '/products/nanonets' },
];

const productSchema = generateProductSchema(productData);
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const faqSchema = generateFaqSchema(productData.faqs);
const schema = [productSchema, breadcrumbSchema, faqSchema];

const waysOfWorking = [
  {
    id: 'ekstraksi',
    label: 'Ekstraksi Teks & Field',
    title: 'Ekstraksi Teks & Field<br />Otomatis',
    description:
      'Setiap field dikembalikan dalam format key-value lengkap dengan koordinat posisi dan skor keyakinan — siap disambungkan langsung ke sistem Anda tanpa parsing tambahan.',
    bullets: [
      'Bounding box (xmin, xmax, ymin, ymax) untuk tiap field',
      'Confidence score per field untuk validasi otomatis',
      'Format keluar JSON, siap dikonsumsi API atau RPA',
    ],
    image: '/images/product/nanonets/Five_Ways_Of_Working/Ekstraksi_Teks_&_Field.webp',
    alt: 'Ekstraksi Teks & Field Otomatis',
  },
  {
    id: 'pemrosesan-invoice',
    label: 'Pemrosesan Invoice',
    title: 'Pemrosesan Invoice<br />Otomatis',
    description:
      'Placeholder deskripsi untuk pemrosesan invoice otomatis dan integrasi alur persetujuan.',
    bullets: [
      'Placeholder poin fitur 1 untuk pemrosesan invoice',
      'Placeholder poin fitur 2 untuk validasi dan approval',
      'Placeholder poin fitur 3 integrasi sistem akuntansi',
    ],
    image: '/images/product/nanonets/Five_Ways_Of_Working/Pemrosesan_Invoice.webp',
    alt: 'Pemrosesan Invoice Otomatis',
  },
  {
    id: 'klasifikasi-dokumen',
    label: 'Klasifikasi Dokumen',
    title: 'Klasifikasi Dokumen<br />Otomatis',
    description:
      'Placeholder deskripsi untuk klasifikasi dan pengkategorian dokumen cerdas berbasis AI.',
    bullets: [
      'Placeholder poin fitur 1 deteksi jenis dokumen otomatis',
      'Placeholder poin fitur 2 pemilahan dokumen multi-halaman',
      'Placeholder poin fitur 3 routing ke workflow yang tepat',
    ],
    image: '/images/product/nanonets/Five_Ways_Of_Working/Klasifikasi_Dokumen.webp',
    alt: 'Klasifikasi Dokumen Otomatis',
  },
  {
    id: 'otomatisasi-workflow',
    label: 'Otomatisasi Workflow',
    title: 'Otomatisasi Workflow<br />& Integrasi',
    description:
      'Placeholder deskripsi untuk otomatisasi alur kerja dan integrasi langsung ke sistem internal.',
    bullets: [
      'Placeholder poin fitur 1 koneksi ke email, cloud storage, dan API',
      'Placeholder poin fitur 2 automasi pemicu dokumen masuk',
      'Placeholder poin fitur 3 sinkronisasi real-time ke ERP',
    ],
    image: '/images/product/nanonets/Five_Ways_Of_Working/Otomatisasi_Workflow.webp',
    alt: 'Otomatisasi Workflow & Integrasi',
  },
  {
    id: 'validasi-data',
    label: 'Validasi data',
    title: 'Validasi Data &<br />Verifikasi Dokumen',
    description:
      'Placeholder deskripsi untuk pencocokan data otomatis, verifikasi identitas, dan aturan bisnis.',
    bullets: [
      'Placeholder poin fitur 1 verifikasi keaslian dan kelengkapan data',
      'Placeholder poin fitur 2 integrasi validasi database internal',
      'Placeholder poin fitur 3 pencegahan kesalahan input manual',
    ],
    image: '/images/product/nanonets/Five_Ways_Of_Working/Validasi_Data.webp',
    alt: 'Validasi Data & Verifikasi Dokumen',
  },
];

const technologyCards = [
  {
    title: 'Manual Review',
    description: 'Verifikasi hasil ekstraksi sebelum masuk sistem',
    image: '/images/product/nanonets/Technology_Outplay/Manual_Review.webp',
  },
  {
    title: 'Improve Model',
    description: 'Belajar dari setiap koreksi yang dilakukan',
    image: '/images/product/nanonets/Technology_Outplay/Improve_Model.webp',
  },
  {
    title: 'Handwriting',
    description: 'Membaca teks tulisan tangan pada dokumen',
    image: '/images/product/nanonets/Technology_Outplay/Handwriting.webp',
  },
  {
    title: 'Formatting',
    description: 'Menyesuaikan format output sesuai kebutuhan',
    image: '/images/product/nanonets/Technology_Outplay/Formatting.webp',
  },
  {
    title: 'Predefined',
    description: 'Field siap pakai untuk dokumen umum',
    image: '/images/product/nanonets/Technology_Outplay/Predefined.webp',
  },
  {
    title: 'Page Section',
    description: 'Mendeteksi bagian-bagian pada tiap halaman',
    image: '/images/product/nanonets/Technology_Outplay/Page_Section.webp',
  },
  {
    title: 'Classification',
    description: 'Mengenali jenis dokumen secara otomatis',
    image: '/images/product/nanonets/Technology_Outplay/Classification.webp',
  },
  {
    title: 'Check List',
    description: 'Mendeteksi checkbox pada formulir',
    image: '/images/product/nanonets/Technology_Outplay/Check_List.webp',
  },
  {
    title: 'QR Code',
    description: 'Membaca dan mengekstrak data dari QR Code',
    image: '/images/product/nanonets/Technology_Outplay/QR_Code.webp',
  },
];

const deploymentOptions = [
  {
    tag: 'DEPLOYMENT CEPAT',
    tagColor: 'text-blue-600',
    title: 'Cloud',
    description: 'Akses model AI yang di-host melalui API untuk pemrosesan dokumen yang skalabel.',
    image: '/images/product/nanonets/Pemrosesan_Dokumen_AI/Cloud.webp',
  },
  {
    tag: 'INTEGRASI FLEKSIBEL',
    tagColor: 'text-indigo-600',
    title: 'Hybrid',
    description: 'Jalankan ekstraksi AI di cloud, sementara data diproses di lingkungan server Anda.',
    image: '/images/product/nanonets/Pemrosesan_Dokumen_AI/Hybrid.webp',
  },
  {
    tag: 'KONTROL INFRASTRUKTUR',
    tagColor: 'text-purple-600',
    title: 'On-Premise',
    description: 'Host model AI yang kompatibel di server Anda sendiri untuk kontrol infrastruktur lebih besar.',
    image: '/images/product/nanonets/Pemrosesan_Dokumen_AI/On-Premise.webp',
  },
];
---

<PageLayout
  title="Nanonets AI OCR - Dokumen Masuk, Data Terstruktur Keluar Otomatis | SolusiAplikasi.id"
  description="Nanonets mengekstrak data dari invoice, KTP, faktur pajak, hingga dokumen tabel kompleks — tanpa perlu setup rules atau template manual."
  canonical="https://solusiaplikasi.id/products/nanonets"
  breadcrumbs={[]}
  schema={schema}
>
  <div class="home-content-zoom w-full">
  <!-- =========================================================================
       BAGIAN 1 (FOTO 1 / IMAGES 2): HERO + KENAPA NANONETS BERBEDA (DARK THEME)
       ========================================================================= -->
  <div class="nanonets-dark-theme text-white">
    <!-- Hero Section -->
    <section class="nanonets-hero-section px-4">
      <!-- Glow ambient light -->
      <div class="nanonets-glow-circle"></div>

      <div class="max-w-4xl mx-auto relative z-10">
        <!-- New Badge (Sesuai Foto 1) -->
        <div class="nanonets-badge">
          <span class="nanonets-badge-pill">New</span>
          <span class="nanonets-badge-text">Intelligent Document Processing</span>
          <span class="nanonets-badge-arrow">&rarr;</span>
        </div>

        <!-- Headline (Sesuai Foto 1: "Dokumen Masuk," soft blue/lavender & "Data Terstruktur Keluar Otomatis." white) -->
        <h1 class="nanonets-hero-title">
          <span class="nanonets-title-blue">Dokumen Masuk,</span><br />
          <span class="nanonets-title-white">Data Terstruktur Keluar Otomatis.</span>
        </h1>

        <!-- Subtitle (Sesuai Foto 1: terbagi 2 baris rapi) -->
        <p class="nanonets-hero-subtitle">
          Nanonets mengekstrak data dari invoice, KTP, faktur pajak, hingga dokumen<br class="hidden sm:inline" />
          tabel kompleks — tanpa perlu setup rules atau template manual.
        </p>

        <!-- CTA Button Coba Gratis (Sesuai Foto 1: pill elegan dengan icon kilauan) -->
        <div class="flex items-center justify-center pt-2">
          <a href="#form-konsultasi" class="nanonets-btn-coba-gratis">
            <svg class="nanonets-btn-icon" width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z" />
            </svg>
            <span>Coba Gratis</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Comparison Section: KENAPA NANONETS BERBEDA (Sesuai Foto 1) -->
    <section class="nanonets-comparison-section px-4">
      <div class="max-w-5xl mx-auto">
        <div class="mb-10 text-left">
          <span class="nanonets-tag-sky">
            KENAPA NANONETS BERBEDA
          </span>
          <h2 class="nanonets-comparison-title">
            OCR biasa cuma baca teks. Nanonets<br class="hidden sm:inline" />
            memahami struktur dokumen Anda.
          </h2>
          <p class="nanonets-comparison-desc">
            Engine rules pada OCR tradisional gampang jebol begitu format dokumen sedikit berubah.
          </p>
        </div>

        <!-- 2 Comparison White Cards (Sesuai Foto 1) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
          <!-- Card 1: OCR Tradisional -->
          <div class="nanonets-card-white">
            <div>
              <span class="text-xs font-semibold text-slate-500 block mb-1">
                OCR Tradisional
              </span>
              <h3 class="text-base sm:text-lg font-bold text-[#1e3a8a] tracking-tight mb-5">
                Non-AI, Zoning &amp; Rules
              </h3>
              <ul class="space-y-3.5 text-xs sm:text-[13px] text-slate-600 leading-relaxed">
                <li class="flex items-start gap-2.5">
                  <span class="text-slate-400 font-bold">•</span>
                  <span>Output tidak terstruktur, perlu diolah manual lagi</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-slate-400 font-bold">•</span>
                  <span>Bergantung pada rule engine yang rumit untuk tiap format</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-slate-400 font-bold">•</span>
                  <span>Rule engine tidak scalable untuk dokumen semi-terstruktur</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-slate-400 font-bold">•</span>
                  <span>Output tabel flat, tidak memahami hierarki baris-kolom</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-slate-400 font-bold">•</span>
                  <span>Mengandalkan metode zoning/area capturing yang kaku</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Card 2: Nanonets AI -->
          <div class="nanonets-card-white">
            <div>
              <span class="text-xs font-semibold text-blue-600 block mb-1">
                Nanonets AI
              </span>
              <h3 class="text-base sm:text-lg font-bold text-[#1e3a8a] tracking-tight mb-5">
                Structured Key-Value Output
              </h3>
              <ul class="space-y-3.5 text-xs sm:text-[13px] text-slate-700 leading-relaxed font-medium">
                <li class="flex items-start gap-2.5">
                  <span class="text-blue-600 font-bold">•</span>
                  <span>Output key-value pair yang sudah terstruktur &amp; siap pakai</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-blue-600 font-bold">•</span>
                  <span>Tidak perlu rules atau template post-processing</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-blue-600 font-bold">•</span>
                  <span>AI otomatis menemukan posisi data dari hasil training</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-blue-600 font-bold">•</span>
                  <span>Deteksi tabel dengan hierarki baris-kolom yang utuh</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-blue-600 font-bold">•</span>
                  <span>Model terus belajar setiap kali memproses dokumen baru</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- =========================================================================
       BAGIAN 2 (FOTO 2 / IMAGES 3): WORKFLOW TAB + TEKNOLOGI DOKUMEN (WHITE THEME)
       ========================================================================= -->
  <div class="bg-white text-slate-900">
    <!-- Section: Satu platform, lima cara kerja (Sesuai Foto 2) -->
    <section class="nanonets-section-platform px-4 border-b border-slate-100">
      <div class="max-w-6xl mx-auto">
        <h2 class="nanonets-platform-title">
          <span class="text-[#3b82f6]">Satu platform,</span> lima cara kerja<br />
          yang bisa disesuaikan dengan kebutuhan tim Anda.
        </h2>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Col 1: Vertical Tabs (5 Cara Kerja Sesuai Foto 2) -->
          <div class="lg:col-span-3 space-y-2.5" role="tablist" aria-label="Lima Cara Kerja Nanonets">
            {
              waysOfWorking.map((item, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`way-tab-btn-${index}`}
                  data-way-tab={index}
                  aria-controls={`way-panel-${index}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  class={`w-full text-left px-5 py-3 rounded-xl text-xs sm:text-sm transition-all duration-200 cursor-pointer ${
                    index === 0
                      ? 'bg-[#3b82f6] text-white font-semibold shadow-md shadow-blue-500/25'
                      : 'text-slate-700 font-medium hover:text-slate-900 hover:bg-slate-50'
                  }`}
                >
                  {item.label}
                </button>
              ))
            }
          </div>

          <!-- Col 2 & 3: Interactive Content Panels -->
          <div class="lg:col-span-9">
            {
              waysOfWorking.map((item, index) => (
                <div
                  id={`way-panel-${index}`}
                  role="tabpanel"
                  aria-labelledby={`way-tab-btn-${index}`}
                  class={`way-panel grid grid-cols-1 lg:grid-cols-9 gap-8 items-center min-h-[320px] sm:min-h-[350px] lg:min-h-[370px] transition-all duration-300 ${
                    index === 0 ? 'block opacity-100' : 'hidden opacity-0'
                  }`}
                >
                  <!-- Col 2: Text Description & Checkpoints (Sesuai Foto 2) -->
                  <div class="lg:col-span-4 space-y-4 flex flex-col justify-center">
                    <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-snug" set:html={item.title} />
                    <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed">
                      {item.description}
                    </p>
                    <ul class="space-y-3 text-xs sm:text-[13px] text-slate-700">
                      {item.bullets.map((bullet) => (
                        <li class="flex items-start gap-2.5">
                          <svg
                            class="w-4 h-4 text-slate-800 shrink-0 mt-0.5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <polyline points="9 11 12 14 22 4" />
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                          </svg>
                          <span class="leading-relaxed">{bullet}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Col 3: Visual Mockup Image (Sesuai Foto 2) -->
                  <div class="lg:col-span-5 flex justify-center items-center">
                    <div class="w-full max-w-lg h-[320px] sm:h-[350px] lg:h-[370px] flex items-center justify-center p-1">
                      <img
                        src={item.image}
                        alt={item.alt}
                        width="720"
                        height="480"
                        loading={index === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                        class="max-h-full max-w-full w-auto h-auto object-contain rounded-2xl drop-shadow-sm"
                      />
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Section: Teknologi di balik setiap dokumen (Sesuai Foto 2) -->
    <section class="nanonets-section-tech px-4 border-b border-slate-100">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Col 1: Header + 3x3 Card Grid Container -->
          <div class="lg:col-span-7">
            <div class="mb-6 sm:mb-8 text-left">
              <span class="text-blue-600 text-xs font-bold tracking-wider block mb-1">
                Solusi Nanonets
              </span>
              <h2 class="text-2xl sm:text-3xl lg:text-[32px] font-extrabold text-slate-900 tracking-tight leading-[1.2] mb-3">
                Teknologi di balik setiap dokumen yang diproses<br class="hidden sm:inline" />
                Nanonets
              </h2>
              <div>
                <span class="text-sm font-bold text-slate-800 block mb-0.5">Technology Outplay</span>
                <p class="text-xs text-slate-500 max-w-xl">
                  Kombinasi kemampuan AI yang membuat ekstraksi dokumen tetap akurat, walau formatnya bervariasi.
                </p>
              </div>
            </div>

            <!-- 3x3 Grid with 9 Feature Cards Container (Sesuai Foto 2) -->
            <div class="bg-white rounded-3xl border border-slate-200/90 p-4 sm:p-6 shadow-sm">
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4">
                {
                  technologyCards.map((card) => (
                    <div class="p-3.5 sm:p-4 rounded-2xl border border-slate-100 hover:border-slate-200/90 bg-white transition-all text-left flex flex-col justify-between min-h-[175px] sm:min-h-[185px] shadow-2xs hover:shadow-xs group">
                      <div>
                        <h4 class="text-xs sm:text-[13px] font-bold text-slate-900 mb-1 leading-snug">
                          {card.title}
                        </h4>
                        <p class="text-[11px] text-slate-500 leading-relaxed">
                          {card.description}
                        </p>
                      </div>
                      <div class="mt-3 flex items-center justify-center">
                        <img
                          src={card.image}
                          alt={card.title}
                          width="240"
                          height="120"
                          loading="eager"
                          decoding="async"
                          class="w-full h-14 sm:h-[68px] object-contain mx-auto"
                        />
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Col 2: Isometric 4-Layer Stack Diagram (Sesuai Foto 2) -->
          <div class="lg:col-span-5 flex justify-center items-center">
            <div class="w-full max-w-lg lg:max-w-none px-2 sm:px-0">
              <img
                src="/images/product/nanonets/Technology_Outplay/Head_Technology_Outplay.webp"
                alt="Teknologi Nanonets IDP Outplay Arsitektur"
                width="700"
                height="1000"
                loading="eager"
                decoding="async"
                class="w-full h-auto object-contain mx-auto drop-shadow-xl"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- =========================================================================
       BAGIAN 3 (FOTO 3 / IMAGES 4): AKURASI + OUTPUT JSON + DELIVERY & INSTALASI
       ========================================================================= -->
  <div class="bg-white text-slate-900">
    <!-- Section: Dibangun untuk akurasi (Sesuai Foto 3) -->
    <section class="nanonets-section-accuracy px-4 border-b border-slate-100">
      <div class="max-w-6xl mx-auto">
        <div class="mb-8 text-left">
          <span class="text-blue-600 text-xs font-bold tracking-wider uppercase block mb-1">
            — KENAPA NANONETS
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Dibangun untuk akurasi, bukan sekadar<br class="hidden sm:inline" />
            pembacaan teks
          </h2>
        </div>

        <!-- 2x2 Grid 4 Feature Cards (Sesuai Foto 3) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
          <!-- Card 1 -->
          <div class="nanonets-feature-box">
            <div class="w-9 h-9 rounded-lg bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center shrink-0 mt-0.5">
