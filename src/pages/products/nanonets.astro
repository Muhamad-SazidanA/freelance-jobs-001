    // Form feedback handler
    const form = document.getElementById('nanonets-demo-form');
    const feedback = document.getElementById('form-feedback');
    if (form instanceof HTMLFormElement) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (feedback) {
          feedback.classList.remove('hidden');
        }
        form.reset();
      });
    }

    // Five Ways of Working Interactive Tabs
    function setupWaysTabs() {
      const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-way-tab]');
      const tabPanels = document.querySelectorAll<HTMLElement>('.way-panel');
      if (!tabButtons.length || !tabPanels.length) return;

      const activeClasses = ['bg-[#3b82f6]', 'text-white', 'font-semibold', 'shadow-md', 'shadow-blue-500/25'];
      const inactiveClasses = ['text-slate-700', 'font-medium', 'hover:text-slate-900', 'hover:bg-slate-50'];

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetIndex = btn.getAttribute('data-way-tab');

          // Update tab buttons
          tabButtons.forEach((b) => {
            const isSelected = b.getAttribute('data-way-tab') === targetIndex;
            b.setAttribute('aria-selected', isSelected ? 'true' : 'false');
            if (isSelected) {
              b.classList.remove(...inactiveClasses);
              b.classList.add(...activeClasses);
            } else {
              b.classList.remove(...activeClasses);
              b.classList.add(...inactiveClasses);
            }
          });

          // Update tab panels
          tabPanels.forEach((p) => {
            const isTarget = p.id === `way-panel-${targetIndex}`;
            if (isTarget) {
              p.classList.remove('hidden');
              requestAnimationFrame(() => {
                p.classList.remove('opacity-0');
                p.classList.add('opacity-100');
              });
            } else {
              p.classList.add('hidden', 'opacity-0');
              p.classList.remove('opacity-100');
            }
          });
        });
      });
    }

    document.addEventListener('DOMContentLoaded', setupWaysTabs);
    document.addEventListener('astro:page-load', setupWaysTabs);
    setupWaysTabs();
  </script>
</PageLayout>
