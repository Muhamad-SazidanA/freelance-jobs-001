---
import PageLayout from '@/layouts/PageLayout.astro';
import ConsultationCta from '@/components/common/ConsultationCta.astro';
import { generateBreadcrumbSchema, generateProductSchema, generateFaqSchema } from '@/lib/schema-ld';
import type { Product } from '@/types/content';

const productData: Product = {
  id: 'prod-spensify',
  slug: 'spensify',
  name: 'Spensify',
  headline: 'Kendalikan Setiap Pengeluaran, Tanpa Ribet.',
  tagline:
    'Spensify menyatukan pengajuan, approval, budgeting, dan pelaporan pengeluaran perusahaan dalam satu platform — bisa diakses lewat web maupun aplikasi mobile.',
  heroImage: '/images/home/home-city-banner.jpg',
  overview:
    'Spensify mengubah proses reimbursement yang kompleks dan manual menjadi proses digital yang lebih cepat, terstruktur, dan terintegrasi dalam satu platform.',
  features: [
    {
      title: 'Smart Scan',
      description: 'OCR Gen AI membaca karakter & kata secara global dari foto kwitansi dan nota belanja.',
    },
    {
      title: 'Budgeting & Pagu Anggaran',
      description: 'Kontrol anggaran per divisi, proyek, atau cabang dengan peringatan batas overspending.',
    },
    {
      title: 'Approval Bertingkat',
      description: 'Routing otomatis mengikuti hierarki organisasi berdasarkan kebijakan dan nominal transaksi.',
    },
    {
      title: 'Deteksi Struk Duplikat',
      description: 'Deteksi duplikasi otomatis berbasis SHA-256 dan metadata transaksi sebelum dana dicairkan.',
    },
  ],
  benefits: [
    'Transparansi penuh atas seluruh pengeluaran operasional perusahaan',
    'Kecepatan pencairan klaim real-time tanpa menunggu siklus bulanan',
    'Ketepatan data dan kategori terstruktur mengurangi kesalahan laporan',
    'Kemudahan akses melalui aplikasi mobile iOS, Android, dan portal web',
  ],
  useCases: [
    'Reimbursement Biaya Operasional & Klaim Transportasi',
    'Pengelolaan Petty Cash & Kas Kecil Proyek',
    'Alokasi Anggaran Departemen & Pagu Biaya Perjalanan Dinas',
    'Deteksi Anti-Fraud & Integrasi Sistem ERP Korporat',
  ],
  faqs: [
    {
      question: 'Bagaimana cara kerja Smart Scan OCR di Spensify?',
      answer:
        'Cukup ambil foto struk dari smartphone atau upload via web. Teknologi OCR Gen AI Spensify langsung mengekstrak nama merchant, tanggal, total nominal, dan kategori biaya secara otomatis.',
    },
    {
      question: 'Bagaimana Spensify mendeteksi nota duplikat?',
      answer:
        'Sistem membandingkan hash SHA-256 dari file gambar, nomor transaksi, tanggal, jumlah, dan vendor. Jika terindikasi ganda, pengajuan otomatis ditahan untuk review.',
    },
  ],
};

const breadcrumbs = [
  { name: 'Products', url: '/products/spensify' },
  { name: 'Spensify (Expense)', url: '/products/spensify' },
];

const productSchema = generateProductSchema(productData);
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const faqSchema = generateFaqSchema(productData.faqs);
const schema = [productSchema, breadcrumbSchema, faqSchema];
---

<PageLayout
  title="Spensify - Kendalikan Setiap Pengeluaran, Tanpa Ribet. | SolusiAplikasi.id"
  description="Spensify menyatukan pengajuan, approval, budgeting, dan pelaporan pengeluaran perusahaan dalam satu platform — bisa diakses lewat web maupun aplikasi mobile."
  canonical="https://solusiaplikasi.id/products/spensify"
  breadcrumbs={[]}
  schema={schema}
>
  <div class="home-content-zoom w-full">
  <!-- =========================================================================
       BAGIAN 1: HERO SECTION (SESUAI FOTO 2)
       ========================================================================= -->
  <section class="spensify-hero-section text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Kicker Badge Sesuai Foto 2 -->
        <div class="mb-5">
          <span class="spensify-badge-pill-hero">
            <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block mr-1.5"></span>
            Smart Expense Management untuk Bisnis Modern
          </span>
        </div>

        <!-- Headline Sesuai Foto 2 -->
        <h1 class="spensify-hero-title mb-5">
          Kendalikan Setiap<br />
          Pengeluaran, Tanpa Ribet.
        </h1>

        <!-- Subtitle Sesuai Foto 2 -->
        <p class="spensify-hero-subtitle mb-8 mx-auto">
          Spensify menyatukan pengajuan, approval, budgeting, dan pelaporan pengeluaran perusahaan dalam satu platform &mdash; bisa diakses lewat web maupun aplikasi mobile.
        </p>

        <!-- CTA Buttons Sesuai Foto 2 -->
        <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
          <a href="#form-konsultasi" class="spensify-btn-gold">
            Jadwalkan Demo
          </a>
          <a
            href="https://wa.me/6282110009519?text=Halo%20PT%20Solusi%20Aplikasi%20Integrasi%20(SAI)%2C%20saya%20tertarik%20dengan%20solusi%20Spensify%20dan%20layanan%20Anda.%20Mohon%20info%20lebih%20lanjut."
            target="_blank"
            rel="noopener noreferrer"
            class="spensify-btn-wa"
          >
            Chat via WhatsApp
          </a>
        </div>
      </div>

      <!-- Dashboard Mockup Image Sesuai Foto 2 -->
      <div class="max-w-4xl mx-auto relative px-2 sm:px-4 flex justify-center">
        <img
          src="/images/product/spensify/spensify-dashboard.webp"
          alt="Spensify Smart Expense Management Dashboard"
          class="w-full h-auto object-contain select-none pointer-events-none"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <!-- Bottom Quote & 4 Pills Strip Sesuai Foto 2 -->
      <div class="pt-10 mt-6 flex flex-col md:flex-row items-center justify-between gap-6">
        <p class="text-xs sm:text-sm text-emerald-100/90 text-center md:text-left max-w-lg leading-relaxed">
          &ldquo;Menjadi sistem kontrol keuangan andalan bagi perusahaan yang tumbuh tanpa kehilangan kendali atas pengeluarannya.&rdquo;
        </p>
        <div class="flex flex-wrap items-center justify-center gap-2.5 text-xs">
          <span class="spensify-pill-prop">Transparansi</span>
          <span class="spensify-pill-prop">Kecepatan</span>
          <span class="spensify-pill-prop">Ketepatan</span>
          <span class="spensify-pill-prop">Kemudahan</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BAGIAN 2: TENTANG KAMI & TANTANGAN & S.A.V.E (SESUAI FOTO 2)
       ========================================================================= -->
  <section class="spensify-section bg-white text-slate-900 border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-24">
      <!-- 2.1: Tentang Kami (Visi & Misi Sesuai Foto 2) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-4">
          <span class="spensify-badge-tag">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block mr-1"></span>
            Tentang Kami
          </span>
          <h2 class="spensify-section-title">
            Satu Sistem untuk Seluruh Alur<br class="hidden sm:inline" />
            Keuangan Operasional Anda
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl">
            Spensify mengubah proses reimbursement yang kompleks dan manual menjadi proses digital yang lebih cepat, terstruktur, dan terintegrasi dalam satu platform.
          </p>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl">
            Tinggalkan ketergantungan pada nota fisik serta approval lewat chat atau kertas &mdash; karyawan mengajukan reimbursement dengan mudah, sementara tim Finance mengontrol dan melaporkan pengeluaran perusahaan dengan lebih efektif.
          </p>
        </div>

        <div class="lg:col-span-5 space-y-4">
          <!-- Visi Card -->
          <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs">
            <span class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider block mb-1">VISI</span>
            <p class="text-sm sm:text-[15px] font-bold text-slate-900 leading-snug">
              Satu sistem untuk seluruh alur keuangan operasional Anda.
            </p>
          </div>

          <!-- Misi Card -->
          <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs">
            <span class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider block mb-1">MISI</span>
            <p class="text-sm sm:text-[15px] font-bold text-slate-900 leading-snug">
              Mengubah proses finansial yang tadinya manual menjadi otomatis, transparan, dan bisa diakses kapan saja.
            </p>
          </div>
        </div>
      </div>

      <!-- 2.2: Pengeluaran Bisnis yang Sulit Dilacak? (Tantangan 01-04 Sesuai Foto 2) -->
      <div>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="spensify-badge-tag mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block mr-1"></span>
            Tantangan
          </span>
          <h2 class="spensify-section-title mt-2">
            Pengeluaran Bisnis yang Sulit<br class="hidden sm:inline" />
            Dilacak?
          </h2>
          <p class="spensify-section-subtitle mx-auto">
            Tantangan reimbursement yang menghambat tim Finance &mdash; lihat bedanya kalau prosesnya masih berjalan manual.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Card 01 -->
          <div class="spensify-card-challenge">
            <div class="flex justify-between items-center mb-4">
              <div class="spensify-challenge-icon">
                <svg class="w-5 h-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              </div>
              <span class="text-xs font-mono font-bold text-slate-300">01</span>
            </div>
            <h3 class="text-sm sm:text-[15px] font-bold text-slate-900 mb-2">Dokumen Tidak Lengkap</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Nota hilang, tidak jelas, atau dokumen pendukung kurang sehingga verifikasi terhambat.
            </p>
          </div>

          <!-- Card 02 -->
          <div class="spensify-card-challenge">
            <div class="flex justify-between items-center mb-4">
              <div class="spensify-challenge-icon">
                <svg class="w-5 h-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <span class="text-xs font-mono font-bold text-slate-300">02</span>
            </div>
            <h3 class="text-sm sm:text-[15px] font-bold text-slate-900 mb-2">Status Approval Sulit Dilacak</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Approval lewat chat, email, atau kertas membuat status pengajuan sulit dipantau.
            </p>
          </div>

          <!-- Card 03 -->
          <div class="spensify-card-challenge">
            <div class="flex justify-between items-center mb-4">
              <div class="spensify-challenge-icon">
                <svg class="w-5 h-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
              </div>
              <span class="text-xs font-mono font-bold text-slate-300">03</span>
            </div>
            <h3 class="text-sm sm:text-[15px] font-bold text-slate-900 mb-2">Visibilitas Terbatas</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Transaksi tersebar sehingga sulit memantau pengeluaran secara real-time.
            </p>
          </div>

          <!-- Card 04 -->
          <div class="spensify-card-challenge">
            <div class="flex justify-between items-center mb-4">
              <div class="spensify-challenge-icon">
                <svg class="w-5 h-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
              </div>
              <span class="text-xs font-mono font-bold text-slate-300">04</span>
            </div>
            <h3 class="text-sm sm:text-[15px] font-bold text-slate-900 mb-2">Rekap Laporan Manual</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Pengecekan memakan waktu serta meningkatkan risiko human error.
            </p>
          </div>
        </div>
      </div>

      <!-- 2.3: Kerangka S.A.V.E (Solusi Sesuai Foto 2) -->
      <div>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="spensify-badge-tag mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block mr-1"></span>
            Solusi
          </span>
          <h2 class="spensify-section-title mt-2">
            Kerangka S.A.V.E
          </h2>
          <p class="spensify-section-subtitle mx-auto">
            Empat pilar yang menjawab tantangan finance di atas &mdash; Speed, Accuracy, Visibility, Efficiency.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto items-stretch">
          <!-- Cara Lama: Reimbursement Manual Sesuai Foto 2 -->
          <div class="p-8 sm:p-9 rounded-[24px] bg-white border border-slate-200/90 shadow-2xs flex flex-col justify-between">
            <div>
              <span class="inline-block px-3.5 py-1 rounded-full bg-[#f3e4dc] text-[#8c3e21] font-bold text-xs mb-4">
                Cara Lama
              </span>
              <h3 class="text-lg sm:text-xl font-extrabold text-slate-900 tracking-tight mb-6">Reimbursement Manual</h3>
              <div class="divide-y divide-slate-100">
                <div class="py-3.5 flex items-start gap-3">
                  <svg class="w-4 h-4 text-[#ea580c] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                  <span class="text-xs sm:text-sm text-slate-600 font-medium leading-snug">Nota fisik hilang atau dokumen pendukung kurang lengkap</span>
                </div>
                <div class="py-3.5 flex items-start gap-3">
                  <svg class="w-4 h-4 text-[#ea580c] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                  <span class="text-xs sm:text-sm text-slate-600 font-medium leading-snug">Approval berjalan lewat chat, email, atau kertas</span>
                </div>
                <div class="py-3.5 flex items-start gap-3">
                  <svg class="w-4 h-4 text-[#ea580c] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                  <span class="text-xs sm:text-sm text-slate-600 font-medium leading-snug">Transaksi tersebar, sulit dipantau real-time</span>
                </div>
                <div class="py-3.5 flex items-start gap-3">
                  <svg class="w-4 h-4 text-[#ea580c] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                  <span class="text-xs sm:text-sm text-slate-600 font-medium leading-snug">Rekap laporan manual, rawan human error</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Dengan Spensify: S.A.V.E Framework Sesuai Foto 2 -->
          <div class="p-8 sm:p-9 rounded-[24px] bg-[#0a4728] text-white shadow-xl flex flex-col justify-between">
            <div>
              <span class="inline-block px-3.5 py-1 rounded-full bg-[#1b5437] text-[#a7f3d0] font-bold text-xs mb-4">
                Dengan Spensify
              </span>
              <h3 class="text-lg sm:text-xl font-extrabold text-white tracking-tight mb-6">S.A.V.E Framework</h3>
              <div class="border-t border-[#175033] divide-y divide-[#175033]">
                <div class="py-3.5 flex items-start gap-3">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <div class="text-xs sm:text-sm leading-snug">
                    <span class="font-bold text-white">Speed</span>
                    <span class="text-white/85"> &mdash; approval &amp; reimbursement real-time, tidak menunggu siklus bulanan</span>
                  </div>
                </div>
                <div class="py-3.5 flex items-start gap-3">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <div class="text-xs sm:text-sm leading-snug">
                    <span class="font-bold text-white">Accuracy</span>
                    <span class="text-white/85"> &mdash; data dan kategori terstruktur, kurangi risiko kesalahan laporan</span>
                  </div>
                </div>
                <div class="py-3.5 flex items-start gap-3">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <div class="text-xs sm:text-sm leading-snug">
                    <span class="font-bold text-white">Visibility</span>
                    <span class="text-white/85"> &mdash; dashboard budget per divisi/proyek bisa dipantau kapan saja</span>
                  </div>
                </div>
                <div class="py-3.5 flex items-start gap-3">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <div class="text-xs sm:text-sm leading-snug">
                    <span class="font-bold text-white">Efficiency</span>
                    <span class="text-white/85"> &mdash; kebijakan pengeluaran otomatis, kurangi pemborosan</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons Sesuai Foto 2 -->
        <div class="flex flex-wrap items-center justify-center gap-4 mt-12">
          <a href="#form-konsultasi" class="spensify-btn-gold">
            Jadwalkan Demo
          </a>
          <a
            href="https://wa.me/6282110009519?text=Halo%20PT%20Solusi%20Aplikasi%20Integrasi%20(SAI)%2C%20saya%20tertarik%20dengan%20solusi%20Spensify%20dan%20layanan%20Anda.%20Mohon%20info%20lebih%20lanjut."
            target="_blank"
            rel="noopener noreferrer"
            class="spensify-btn-wa-light"
          >
            Chat via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BAGIAN 3 & 4: SPENSIFY DALAM SATU KALIMAT (4 ROW SESUAI FOTO 3 & 4)
       ========================================================================= -->
  <section id="fitur-spensify" class="spensify-section bg-white text-slate-900 border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="spensify-badge-tag mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block mr-1"></span>
          Produk
        </span>
        <h2 class="spensify-section-title mt-2">
          Spensify dalam Satu Kalimat
        </h2>
        <p class="spensify-section-subtitle mx-auto">
          Platform yang menghubungkan pengeluaran, budget, dan reimbursement dalam satu sistem &mdash; dari pengajuan sampai laporan.
        </p>
      </div>

      <!-- Divider line below header matching Image 2 -->
      <div class="w-full border-b border-slate-100/90 mb-16"></div>

      <div class="space-y-20 lg:space-y-24">
        <!-- Feature 1: OCR AI (Text Left, feature-shot.webp Right Sesuai Foto 2) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-7 space-y-4">
            <h3 class="spensify-feature-row-title">OCR AI: Foto Struk, Data Terisi Otomatis</h3>
            <p class="spensify-feature-row-desc">
              Transaksi harian tanpa isi manual satu per satu. Foto atau upload struk dari HP maupun web, sistem baca datanya secara otomatis.
            </p>
            <ul class="space-y-3 pt-1">
              <li class="flex items-start gap-3 text-xs sm:text-sm text-slate-700 leading-snug">
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
