---
interface Props {
  schema: Record<string, unknown> | Array<Record<string, unknown> | null | undefined>;
}

const { schema } = Astro.props;
const filteredSchema = Array.isArray(schema) ? schema.filter(Boolean) : schema;
const jsonLdString = JSON.stringify(filteredSchema);
---

<script type="application/ld+json" set:html={jsonLdString} />
