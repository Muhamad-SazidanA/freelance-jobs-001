---
const ways = [
  {
    id: 'ekstraksi',
    label: 'Ekstraksi Data',
    desc: 'Setiap field data diekstrak sesuai kebutuhan dari setiap dokumen.',
    points: [
      'Siap diintegrasikan langsung ke sistem Anda tanpa tambahan pengembangan.',
      'Confidence score per field untuk mendukung validasi otomatis.',
      'Output dalam format JSON, siap diintegrasikan melalui API.',
    ],
  },
  {
    id: 'pemrosesan',
    label: 'Pemrosesan Otomatis',
    desc: 'Dokumen diproses otomatis begitu masuk ke sistem, tanpa menunggu input manual.',
    points: [
      'Upload melalui email, drive, atau API.',
      'Antrian pemrosesan berjalan terus tanpa henti.',
      'Notifikasi otomatis saat proses selesai.',
    ],
  },
  {
    id: 'klasifikasi',
    label: 'Klasifikasi Dokumen',
    desc: 'Sistem mengenali jenis dokumen secara otomatis lalu mengarahkannya ke model yang tepat.',
    points: [
      'Membedakan invoice, PO, faktur pajak, dan receipt.',
      'Dapat dilatih untuk jenis dokumen khusus perusahaan.',
      'Mengurangi pemilahan dokumen secara manual.',
    ],
  },
  {
    id: 'workflow',
    label: 'Otomatisasi Workflow',
    desc: 'Hubungkan hasil ekstraksi ke alur persetujuan dan sistem ERP Anda.',
    points: [
      'Persetujuan berjenjang sesuai aturan internal.',
      'Integrasi dengan sistem akuntansi dan ERP.',
      'Riwayat aktivitas tercatat untuk audit.',
    ],
  },
  {
    id: 'validasi',
    label: 'Validasi Data',
    desc: 'Cocokkan data dengan aturan bisnis dan tandai anomali sebelum masuk sistem.',
    points: [
      'Pengecekan total, tanggal, dan nomor referensi.',
      'Anomali ditandai untuk ditinjau tim.',
      'Data yang lolos validasi langsung diteruskan.',
    ],
  },
];
---
<section id="cara" class="ways">
  <div class="container">
    <span class="eyebrow">Cara kerja</span>
    <h2>Satu platform, <span class="accent">lima cara kerja</span><br />yang bisa disesuaikan dengan kebutuhan tim Anda.</h2>

    <div class="layout">
      <div class="tabs" role="tablist" aria-label="Cara kerja">
        {ways.map((w, i) => (
          <button
            role="tab"
            class="tab"
            id={`tab-${w.id}`}
            aria-controls={`panel-${w.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-index={i}
          >
            {w.label}
          </button>
        ))}
      </div>

      <div class="panels">
        {ways.map((w, i) => (
          <article role="tabpanel" class="panel" id={`panel-${w.id}`} aria-labelledby={`tab-${w.id}`} hidden={i !== 0}>
            <div class="text">
              <h3>{w.label}</h3>
              <p class="desc">{w.desc}</p>
              <ul>
                {w.points.map((p) => <li>{p}</li>)}
              </ul>
            </div>
            <div class="mock" aria-hidden="true">
              <div class="mock-card">
                <i class="title"></i>
                <i></i><i></i><i class="short"></i>
                <div class="mock-chips"><b></b><b></b></div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ways { background: #fff; }
  .eyebrow { font-size: 14px; font-weight: 600; color: #0a6cff; }
  h2 { font-size: clamp(28px, 3.8vw, 44px); font-weight: 500; margin: 14px 0 48px; }
  .accent { color: #0a6cff; }

  .layout { display: grid; grid-template-columns: 280px 1fr; gap: 40px; align-items: start; }
  .tabs { display: grid; gap: 8px; }
  .tab {
    text-align: left; padding: 16px 20px; border-radius: 12px; border: 0; background: transparent;
    font-size: 17px; font-weight: 600; color: #0f172a; cursor: pointer; transition: background .2s, color .2s;
  }
  .tab:hover { background: #f1f5ff; }
  .tab[aria-selected='true'] { background: #0a6cff; color: #fff; box-shadow: 0 10px 24px rgba(10, 108, 255, .3); }
  .tab:focus-visible { outline: 3px solid #93c5fd; outline-offset: 2px; }

  .panel {
    display: grid; grid-template-columns: 1fr 1fr; gap: 36px; align-items: center;
    padding: 8px 0; animation: fade .35s ease;
  }
  .panel[hidden] { display: none; }
  .panel h3 { font-size: 24px; color: #0f172a; }
  .desc { color: #5b6578; margin: 10px 0 20px; font-size: 16px; }
  ul { padding-left: 20px; display: grid; gap: 10px; color: #334155; font-size: 15px; }

  .mock {
    padding: 24px; border-radius: 18px; background: linear-gradient(135deg, #eef3ff, #dfe8ff);
  }
  .mock-card { background: #fff; border-radius: 14px; padding: 20px; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08); display: grid; gap: 10px; }
  .mock i { display: block; height: 12px; border-radius: 6px; background: #c9d6f5; }
  .mock i.title { width: 40%; height: 16px; background: #9db4ef; }
  .mock i.short { width: 60%; }
  .mock-chips { display: flex; gap: 8px; margin-top: 6px; }
  .mock-chips b { height: 26px; width: 80px; border-radius: 8px; background: #e7eeff; }

  @keyframes fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: 24px; }
    .panel { grid-template-columns: 1fr; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.ways [role="tab"]'));

  const select = (index: number, focus = false) => {
    tabs.forEach((t, i) => {
      const active = i === index;
      t.setAttribute('aria-selected', String(active));
      t.tabIndex = active ? 0 : -1;
      const targetPanel = document.getElementById(t.getAttribute('aria-controls') || '');
      if (targetPanel) {
        targetPanel.hidden = !active;
      }
    });
    if (focus && tabs[index]) tabs[index].focus();
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(i));
    tab.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
    });
  });
</script>
