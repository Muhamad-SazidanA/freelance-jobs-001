---
// TrustRecognition.astro
// Pilihan Utama Perusahaan Terkemuka di Asia Pasifik

const ratings = [
  { name: 'G2', src: '/images/home/Independen-Rating/G2.webp', score: '5.0' },
  { name: 'Paper.id', src: '/images/home/Independen-Rating/Paper.id.webp', score: '5.0' },
  { name: 'Gartner', src: '/images/home/Independen-Rating/Gartner.webp', score: '5.0' },
];

const certifications = [
  {
    label: 'ISO 27001',
    src: '/images/home/Tersertifikasi/ISO_27001.webp',
    alt: 'ISO/IEC 27001 Information Security Management System Certified',
    title: 'ISO/IEC 27001 — Information Security Management System Certification',
  },
  {
    label: 'ISO 9001',
    src: '/images/home/Tersertifikasi/ISO_9001.webp',
    alt: 'ISO 9001 Quality Management System Certified',
    title: 'ISO 9001 — Quality Management System Certification',
  },
  {
    label: 'ISO 20000',
    src: '/images/home/Tersertifikasi/ISO_20000.webp',
    alt: 'ISO/IEC 20000 IT Service Management System Certified',
    title: 'ISO/IEC 20000 — Information Technology Service Management System Certification',
  },
  {
    label: 'ISO 45001',
    src: '/images/home/Tersertifikasi/ISO_45001.webp',
    alt: 'ISO 45001:2018 Occupational Health and Safety Management System Certified',
    title: 'ISO 45001 — Occupational Health and Safety Management System Certification',
  },
  {
    label: 'ISO 14001',
    src: '/images/home/Tersertifikasi/ISO_14001.webp',
    alt: 'ISO 14001 Environmental Management System Certified',
    title: 'ISO 14001 — Environmental Management System Certification',
  },
  {
    label: 'SOC 2',
    src: '/images/home/Tersertifikasi/AICPA_SOC.webp',
    alt: 'AICPA SOC 2 Type I & Type II Compliant',
    title: 'SOC 2 Type I & Type II — AICPA Service Organization Controls',
  },
  {
    label: 'EY Audit',
    src: '/images/home/Tersertifikasi/EY.webp',
    alt: 'Ernst & Young SOC 2 Type 1 Authentication Report',
    title: 'SOC 2 Type 1 Authentication Report Issued by Ernst & Young (EY)',
  },
  {
    label: 'CMMI L3',
    src: '/images/home/Tersertifikasi/CMMI_Level_3.webp',
    alt: 'CMMI Certification Level 3',
    title: 'CMMI Level 3 — Capability Maturity Model Integration Certification',
  },
  {
    label: 'GDPR',
    src: '/images/home/Tersertifikasi/GDPR.webp',
    alt: 'GDPR & UK GDPR Compliant',
    title: 'GDPR & UK GDPR — General Data Protection Regulation Compliant',
  },
  {
    label: 'HIPAA',
    src: '/images/home/Tersertifikasi/HIPAA.webp',
    alt: 'HIPAA Compliant',
    title: 'HIPAA — Health Insurance Portability and Accountability Act Compliant',
  },
];
---

<section class="py-12 md:py-16 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
      <h2
        class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight"
      >
        Pilihan Solusi dari Penyedia Teknologi Terkemuka
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2.5 leading-relaxed">
        Beragam solusi teknologi untuk kebutuhan bisnis yang berbeda.
      </p>
    </div>

    <!-- Symmetrical 50/50 2-Column Grid with centered divider -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 divide-y divide-slate-100 md:divide-y-0 md:divide-x md:divide-slate-200 max-w-5xl mx-auto items-stretch"
    >
      <!-- Column 1: Independen Rating -->
      <div
        class="py-6 md:py-2 md:pr-10 md:pl-0 flex flex-col justify-start"
      >
        <!-- Ratings Showcase (Matches exact height & style of Column 2 badge grid) -->
        <div class="grid grid-cols-3 gap-2.5 sm:gap-3 mb-6 md:h-[150px]">
          {ratings.map((item) => (
            <div class="group bg-slate-50/70 hover:bg-white border border-slate-200/70 hover:border-slate-300 rounded-xl px-3 py-3 flex flex-col items-center justify-center gap-2 transition-all duration-200 hover:shadow-2xs">
              <img
                src={item.src}
                alt={item.name}
                class="w-10 h-10 object-contain rounded-md transition-transform duration-200 group-hover:scale-105"
                loading="eager"
                decoding="async"
              />
              <div class="text-center">
                <span class="block text-[11px] font-bold text-slate-800 leading-tight mb-1">
                  {item.name}
                </span>
                <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-50 border border-amber-200/70">
                  <svg
                    class="w-3 h-3 text-amber-500 fill-amber-500"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                    ></path>
                  </svg>
                  <span class="text-[11px] font-bold text-slate-800">{item.score}</span>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Content -->
        <div>
          <h3
            class="text-base lg:text-lg font-bold text-slate-900 leading-snug tracking-tight mb-2"
          >
            <span class="text-[#0866D3]">Pilihan Utama</span> dari Pengguna di{' '}<br class="hidden lg:inline" />
            Berbagai Platform Global
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Pengakuan independen dan rating tinggi yang konsisten dari pengguna
            di berbagai industri terkemuka.
          </p>
        </div>
      </div>

      <!-- Column 2: Tersertifikasi -->
      <div
        class="py-6 md:py-2 md:pl-10 md:pr-0 flex flex-col justify-start"
      >
        <!-- Compliance & Certification Badge Grid (2 Rows x 5 Badges, exact height match) -->
        <div class="grid grid-cols-3 sm:grid-cols-5 gap-2 mb-6 md:h-[150px]">
          {certifications.map((cert) => (
            <div
              class="group bg-slate-50/70 hover:bg-white border border-slate-200/70 hover:border-slate-300 rounded-xl px-1 lg:px-1.5 py-2 flex flex-col items-center justify-center gap-1 transition-all duration-200 hover:shadow-2xs"
              title={cert.title}
            >
              <img
                src={cert.src}
                alt={cert.alt}
                class="w-8 h-8 sm:w-9 sm:h-9 object-contain transition-transform duration-200 group-hover:scale-105"
                loading="eager"
                decoding="async"
              />
              <span class="text-[9.5px] lg:text-[10px] font-semibold text-slate-600 leading-tight text-center tracking-tight whitespace-nowrap">
                {cert.label}
              </span>
            </div>
          ))}
        </div>

        <!-- Content -->
        <div>
          <h3
            class="text-base lg:text-lg font-bold text-slate-900 leading-snug tracking-tight mb-2"
          >
            Beroperasi dengan <span class="text-[#0866D3]">Standar Keamanan</span>{' '}<br class="hidden lg:inline" />
            yang Tersertifikasi
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Tersertifikasi secara internasional mencakup ISO (27001, 9001, 20000, 45001, 14001), SOC 2 (Ernst &amp; Young), CMMI Level 3, GDPR, dan HIPAA.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
