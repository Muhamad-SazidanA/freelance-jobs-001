---
// TrustRecognition.astro
// Pilihan Utama Perusahaan Terkemuka di Asia Pasifik
---

<section class="py-12 md:py-16 bg-white border-y border-slate-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
      <h2
        class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight"
      >
        Pilihan Utama Perusahaan Terkemuka di <span class="text-[#0866D3]"
          >Asia Pasifik</span
        >
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2.5 leading-relaxed">
        Berawal dari kepercayaan, terbukti melalui dampak nyata, dan diakui di
        seluruh Asia Pasifik.
      </p>
    </div>

    <!-- 3-Column Grid with subtle vertical dividers -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 divide-y divide-slate-100 md:divide-y-0 md:divide-x md:divide-slate-200"
    >
      <!-- Column 1: Industri & Inovasi -->
      <div
        class="py-6 md:py-2 md:pr-8 md:pl-0 flex flex-col justify-start"
      >
        <!-- Logos Header -->
        <div class="h-20 flex flex-col justify-center gap-2 mb-5">
          <div class="flex items-center gap-3">
            <img
              src="/images/home/Industri-Inovasi/CNN-AWARDS.webp"
              alt="CNN Awards"
              class="h-7 w-auto object-contain"
              loading="lazy"
            />
            <img
              src="/images/home/Industri-Inovasi/CNBC-AWARDS.webp"
              alt="CNBC Awards 3 Years in a Row"
              class="h-6 w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="flex items-center">
            <img
              src="/images/home/Industri-Inovasi/Bloomberg.webp"
              alt="Bloomberg"
              class="h-4.5 w-auto object-contain"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Content -->
        <h3
          class="text-base sm:text-lg font-bold text-slate-900 leading-snug tracking-tight mb-2.5"
        >
          Konsisten dalam Memberikan <span class="text-[#0866D3]"
            >Dampak Nyata</span
          > bagi Bisnis
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Diakui oleh platform industri atas inovasi, performa, dan keandalan
          sistem perusahaan.
        </p>
      </div>

      <!-- Column 2: Independen Rating -->
      <div
        class="py-6 md:py-2 md:px-8 flex flex-col justify-start"
      >
        <!-- Logos / Ratings Header -->
        <div class="h-20 flex items-center mb-5">
          <div class="flex items-center gap-3.5 sm:gap-4">
            <!-- G2 -->
            <div class="flex flex-col items-center">
              <img
                src="/images/home/Independen-Rating/G2.webp"
                alt="G2"
                class="h-8.5 w-8.5 object-contain rounded-md"
                loading="lazy"
              />
              <div class="flex items-center gap-1 mt-1.5">
                <svg
                  class="w-3 h-3 text-amber-500 fill-amber-500"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                  ></path>
                </svg>
                <span class="text-xs font-bold text-slate-800">5.0</span>
              </div>
            </div>

            <!-- Divider -->
            <div class="h-8 w-px bg-slate-200"></div>

            <!-- Paper.id -->
            <div class="flex flex-col items-center">
              <img
                src="/images/home/Independen-Rating/Paper.id.webp"
                alt="Paper.id"
                class="h-8.5 w-8.5 object-contain rounded-md"
                loading="lazy"
              />
              <div class="flex items-center gap-1 mt-1.5">
                <svg
                  class="w-3 h-3 text-amber-500 fill-amber-500"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                  ></path>
                </svg>
                <span class="text-xs font-bold text-slate-800">5.0</span>
              </div>
            </div>

            <!-- Divider -->
            <div class="h-8 w-px bg-slate-200"></div>

            <!-- Gartner -->
            <div class="flex flex-col items-center">
              <img
                src="/images/home/Independen-Rating/Gartner.webp"
                alt="Gartner"
                class="h-8.5 w-8.5 object-contain rounded-md"
                loading="lazy"
              />
              <div class="flex items-center gap-1 mt-1.5">
                <svg
                  class="w-3 h-3 text-amber-500 fill-amber-500"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                  ></path>
                </svg>
                <span class="text-xs font-bold text-slate-800">5.0</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Content -->
        <h3
          class="text-base sm:text-lg font-bold text-slate-900 leading-snug tracking-tight mb-2.5"
        >
          <span class="text-[#0866D3]">Pilihan Utama</span> dari Pengguna di
          Berbagai Platform Global
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Pengakuan independen dan rating tinggi yang konsisten dari pengguna
          di berbagai industri.
        </p>
      </div>

      <!-- Column 3: Tersertifikasi -->
      <div
        class="py-6 md:py-2 md:pl-8 md:pr-0 flex flex-col justify-start"
      >
        <!-- Logos Header -->
        <div class="h-20 flex items-center mb-5">
          <div class="flex items-center gap-4 sm:gap-5">
            <img
              src="/images/home/Tersertifikasi/ISO.webp"
              alt="ISO 27001"
              class="h-9.5 w-auto object-contain"
              loading="lazy"
            />
            <img
              src="/images/home/Tersertifikasi/Komdigi.webp"
              alt="Komdigi"
              class="h-8.5 w-auto object-contain"
              loading="lazy"
            />
            <img
              src="/images/home/Tersertifikasi/DJP.webp"
              alt="Direktorat Jenderal Pajak (DJP)"
              class="h-8.5 w-auto object-contain"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Content -->
        <h3
          class="text-base sm:text-lg font-bold text-slate-900 leading-snug tracking-tight mb-2.5"
        >
          Beroperasi dengan <span class="text-[#0866D3]">Standar Keamanan</span> yang
          Tersertifikasi
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Tersertifikasi secara internasional dan diakui oleh otoritas regulasi
          resmi.
        </p>
      </div>
    </div>
  </div>
</section>
