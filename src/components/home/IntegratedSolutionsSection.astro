<section id="solusi" class="py-12 md:py-16 bg-slate-50/60 border-y border-slate-200/70">
  <div class="max-w-[1206px] mx-auto px-4 xl:px-0">

    <!-- Section Header - Clean & Understated -->
    <div class="max-w-2xl mx-auto text-center mb-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-2">
        5 Solusi Terintegrasi
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        Pakai satu sesuai kebutuhan Anda sekarang, atau gabungkan bertahap seiring proses bisnis berkembang.
      </p>
    </div>

    <!-- Floating Logo Tabs with Ambient Neon Glow -->
    <div
      id="iss-tabs"
      class="flex flex-wrap items-center justify-center gap-2 sm:gap-4 md:gap-6 mb-10 max-w-4xl mx-auto"
      role="tablist"
      aria-label="Pilihan Solusi Terintegrasi"
    >
      {products.map((product, i) => (
        <button
          type="button"
          data-tab={product.id}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`panel-${product.id}`}
          id={`tab-${product.id}`}
          style={`--neon-rgb: ${product.neonRgb};`}
          class={`iss-tab relative py-2.5 px-4 sm:px-6 rounded-xl cursor-pointer flex items-center justify-center transition-all duration-200 ${i === 0 ? 'active' : ''}`}
          title={product.name}
        >
          <img
            src={product.logo}
            alt={product.name}
            class="iss-tab-img h-6 sm:h-7 md:h-7.5 w-auto max-w-[90px] sm:max-w-[110px] md:max-w-[125px] object-contain transition-all duration-200 pointer-events-none select-none"
            loading="eager" decoding="async"
          />
        </button>
      ))}
    </div>

    <!-- Product Panels -->
    <div class="relative w-full">
      {products.map((product, i) => {
        if (product.id === 'nanonets') {
          return (
            <div
              id={`panel-${product.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${product.id}`}
              class={`iss-panel bg-white border border-slate-200/80 rounded-2xl md:rounded-3xl overflow-hidden shadow-xs p-6 sm:p-8 md:p-10 lg:py-4 lg:pl-10 lg:pr-6 xl:pl-11 xl:pr-8 w-full max-w-[1206px] min-h-[487px] lg:h-[487px] grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center ${i !== 0 ? 'hidden' : ''}`}
            >
              {/* Nanonets Custom Clean Panel (following Cyclone typography & composition) */}
              <div class="lg:col-span-6 flex flex-col justify-center items-start space-y-3.5 sm:space-y-4 pr-0 lg:pr-3 h-full">
                <img
                  src={product.logo}
                  alt={product.name}
                  class="h-8 sm:h-9 md:h-10 w-auto object-contain mb-1 sm:mb-2 self-start"
                  loading="eager" decoding="async"
                />

                {/* 3 Text Elements: Dibuat rapat jaraknya */}
                <div class="w-full space-y-1.5 sm:space-y-2">
                  <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight whitespace-normal xl:whitespace-nowrap">
                    Intelligent Document Processing
                  </h3>
                  <p class="text-base sm:text-lg font-bold text-[#0866D3] leading-snug">
                    AI-Powered Document Automation Platform
                  </p>
                  <p class="text-xs sm:text-sm md:text-base text-slate-600 leading-relaxed font-normal pt-0.5">
                    Nanonets adalah platform cerdas untuk otomatisasi dokumen, dirancang untuk mengekstrak informasi penting dari berbagai dokumen seperti receipt, invoice, surat medis, dan formulir. Cocok untuk perusahaan di banyak sektor seperti keuangan, kesehatan, logistik, dan banyak lagi.
                  </p>
                </div>

                <div class="pt-4 sm:pt-5 lg:pt-6">
                  <a
                    href="/products/nanonets"
                    class="inline-flex items-center justify-center px-6 py-2.5 sm:px-7 sm:py-3 bg-[#0866D3] hover:bg-[#0756b3] text-white text-sm sm:text-base font-semibold rounded-xl shadow-md transition-all duration-200"
                  >
                    Learn More
                  </a>
                </div>
              </div>

              {/* Right Content: Nanonets Visual Article Preview Graphic (Enlarged to almost card height) */}
              <div class="lg:col-span-6 flex items-center justify-center lg:justify-end h-full">
                <img
                  src="/images/home/Product/Article/Nanonets/Nanonets.webp"
                  alt="Nanonets Intelligent Document Processing Platform Preview"
                  class="w-auto h-auto max-h-[380px] sm:max-h-[420px] lg:max-h-[455px] max-w-full object-contain drop-shadow-md"
                  loading="eager" decoding="async"
