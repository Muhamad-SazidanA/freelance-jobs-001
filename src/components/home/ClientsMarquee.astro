---
// src/components/home/ClientsMarquee.astro
// Clean, Lightweight & Interactive 2-Row Enterprise Client Marquee
// Visual 100% matching Reference Image 2: "Client Kami" with real client logos

interface ClientLogo {
  name: string;
  file: string;
  alt: string;
}

// 22 Enterprise Client Logos from public/images/home/Client/
// Balanced into 2 dynamic rows
const row1: ClientLogo[] = [
  { name: 'Bank BNI', file: 'BNI.webp', alt: 'Logo Bank BNI' },
  { name: 'Telkom Indonesia', file: 'telkom.webp', alt: 'Logo Telkom Indonesia' },
  { name: 'Astra Otoparts', file: 'Astra_Otoparts.webp', alt: 'Logo Astra Otoparts' },
  { name: 'Bridgestone', file: 'Bridgestone.webp', alt: 'Logo Bridgestone Indonesia' },
  { name: 'Angkasa Pura', file: 'Angkasa_Pura.webp', alt: 'Logo Angkasa Pura' },
  { name: 'Pos Indonesia', file: 'Pos_Ind.webp', alt: 'Logo Pos Indonesia' },
  { name: 'Jotun', file: 'JOTUN.webp', alt: 'Logo Jotun' },
  { name: 'Mitra10', file: 'Mitra10.webp', alt: 'Logo Mitra10' },
  { name: 'Lautan Luas', file: 'Lautan_Luas.webp', alt: 'Logo Lautan Luas' },
  { name: 'Husky Energy', file: 'Husky_Energy.webp', alt: 'Logo Husky Energy' },
  { name: 'Anderia', file: 'Anderia.webp', alt: 'Logo Anderia' },
];

const row2: ClientLogo[] = [
  { name: 'Lembaga Penjamin Simpanan (LPS)', file: 'LPS.webp', alt: 'Logo Lembaga Penjamin Simpanan' },
  { name: 'CKB Logistics', file: 'CKB.webp', alt: 'Logo CKB Logistics' },
  { name: 'Triputra Agro Persada', file: 'Triputra_Agro_Persada.webp', alt: 'Logo Triputra Agro Persada' },
  { name: 'SANF', file: 'SANF.webp', alt: 'Logo Surya Artha Nusantara Finance' },
  { name: 'APL', file: 'APL.webp', alt: 'Logo Anugerah Pharmindo Lestari' },
  { name: 'Bina Pertiwi', file: 'BinaPertiwi.webp', alt: 'Logo Bina Pertiwi' },
  { name: 'CSA', file: 'CSA.webp', alt: 'Logo Catur Sentosa Adiprana' },
  { name: 'Tokyo Roki Indonesia', file: 'ROKI.webp', alt: 'Logo Tokyo Roki Indonesia' },
  { name: 'SDN', file: 'SDN.webp', alt: 'Logo Sumber Daya Nelayan' },
  { name: 'Sunpride', file: 'Sunpride.webp', alt: 'Logo Sunpride' },
  { name: 'TT Metals Indonesia', file: 'TT_Metals_Indonesia.webp', alt: 'Logo TT Metals Indonesia' },
];
---

<section
  class="relative py-12 sm:py-16 md:py-20 bg-white overflow-hidden select-none"
  aria-label="Daftar Klien Enterprise PT Solusi Aplikasi Integrasi"
>
  <!-- Header: Subdued Trust Eyebrow (Sleek Modern Tech Standard) -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-7 sm:mb-10 text-center">
    <p class="text-xs sm:text-sm font-semibold tracking-wider uppercase text-slate-500">
      Dipercaya oleh Perusahaan &amp; Institusi Terkemuka di Indonesia
    </p>
  </div>

  <!-- Marquee Container with Soft Left & Right Fade Masks -->
  <div class="relative w-full overflow-hidden space-y-6 sm:space-y-8">
    <!-- Left & Right Gradient Shadows for Seamless Infinite Fade -->
    <div
      class="pointer-events-none absolute left-0 top-0 bottom-0 w-8 sm:w-12 md:w-16 bg-gradient-to-r from-white to-white/0 z-10"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute right-0 top-0 bottom-0 w-8 sm:w-12 md:w-16 bg-gradient-to-l from-white to-white/0 z-10"
      aria-hidden="true"
    ></div>

    <!-- ROW 1: Glides Leftward -->
    <div class="marquee-group group flex overflow-hidden">
      <div class="marquee-track marquee-track-left flex shrink-0 items-center gap-10 sm:gap-14 md:gap-18">
        {[...row1, ...row1].map((logo) => (
          <div
            class="flex items-center justify-center shrink-0 w-32 sm:w-40 md:w-44 h-12 sm:h-14 transition-all duration-300 hover:scale-110 cursor-pointer"
            title={logo.name}
          >
            <img
              src={`/images/home/Client/${logo.file}`}
              alt={logo.alt}
              loading="lazy"
              decoding="async"
              class="max-h-8 sm:max-h-10 md:max-h-11 w-auto max-w-[120px] sm:max-w-[150px] object-contain opacity-80 hover:opacity-100 transition-opacity duration-200"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- ROW 2: Glides Rightward (Opposite Direction for Dynamic Motion) -->
    <div class="marquee-group group flex overflow-hidden">
      <div class="marquee-track marquee-track-right flex shrink-0 items-center gap-10 sm:gap-14 md:gap-18">
        {[...row2, ...row2].map((logo) => (
          <div
            class="flex items-center justify-center shrink-0 w-32 sm:w-40 md:w-44 h-12 sm:h-14 transition-all duration-300 hover:scale-110 cursor-pointer"
            title={logo.name}
          >
            <img
              src={`/images/home/Client/${logo.file}`}
              alt={logo.alt}
              loading="lazy"
              decoding="async"
              class="max-h-8 sm:max-h-10 md:max-h-11 w-auto max-w-[120px] sm:max-w-[150px] object-contain opacity-80 hover:opacity-100 transition-opacity duration-200"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Hardware Accelerated GPU Animation (Zero JS, 60 FPS, Non-blocking) */
  .marquee-track {
    will-change: transform;
    backface-visibility: hidden;
  }

  .marquee-track-left {
    animation: scroll-left 52s linear infinite;
  }

  .marquee-track-right {
    animation: scroll-right 55s linear infinite;
  }

  /* Interactive: Hover Pauses the Animation Smoothly */
  .marquee-group:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes scroll-left {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes scroll-right {
    0% {
      transform: translate3d(-50%, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  /* Accessibility: Respect Reduced Motion Preferences */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track-left,
    .marquee-track-right {
      animation: none;
      transform: none;
    }
  }
</style>
