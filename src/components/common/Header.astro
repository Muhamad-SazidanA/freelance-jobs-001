---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'About Us', href: '/about-us' },
  {
    label: 'Produk',
    href: '/products/nanonets',
    children: [
      { label: 'Nanonets (AI OCR)', href: '/products/nanonets' },
      { label: 'Cyclone (RPA)', href: '/products/cyclone' },
      { label: 'Docuflo (DMS)', href: '/products/docuflo' },
      { label: 'Syclus (ITSM)', href: '/products/syclus' },
      { label: 'Spensify (Expense)', href: '/products/spensify' },
    ],
  },
  { label: 'Articles', href: '/articles' },
];
---

<header class="site-header border-b border-slate-200 bg-white sticky top-0 z-40 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 py-3 md:py-3.5 flex items-center justify-between">
    <!-- Logo di Pojok Kiri -->
    <a href="/" class="brand-logo flex items-center" aria-label="SolusiAplikasi.id Beranda">
      <img
        src="/images/LogoHeader.png"
        alt="SolusiAplikasi.id"
        class="h-7 sm:h-8 md:h-9 w-auto object-contain transition-all"
        width="220"
        height="36"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <!-- Navigasi Desktop & Action Button -->
    <div class="flex items-center gap-4 sm:gap-6 md:gap-7">
      <nav aria-label="Navigasi Utama" class="hidden md:flex items-center gap-6">
        {navItems.map((item) => (
          item.children ? (
            <div class="relative group py-2">
              <a
                href={item.href}
                class={`text-sm font-medium flex items-center gap-1.5 hover:text-sky-600 focus-visible:outline-sky-600 transition-colors ${
                  currentPath.startsWith('/products') ? 'text-sky-600 font-semibold' : 'text-slate-700'
                }`}
                aria-haspopup="true"
                aria-expanded="false"
              >
                <span>{item.label}</span>
                <svg
                  class="w-3.5 h-3.5 text-slate-400 group-hover:text-sky-600 group-hover:rotate-180 group-focus-within:rotate-180 transition-transform duration-200"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              <div class="absolute left-0 top-full pt-1.5 hidden group-hover:block group-focus-within:block w-52 z-50">
                <div class="p-1.5 bg-white/95 backdrop-blur-md border border-slate-200/80 rounded-xl shadow-lg shadow-slate-900/5 ring-1 ring-slate-900/5 space-y-0.5">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class={`block px-3 py-2 text-[13px] font-medium rounded-lg transition-colors duration-150 focus-visible:outline-sky-600 ${
                        currentPath === child.href
                          ? 'text-sky-600 bg-sky-50/80 font-semibold'
                          : 'text-slate-600 hover:text-sky-600 hover:bg-slate-50/90'
                      }`}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class={`text-sm font-medium hover:text-sky-600 focus-visible:outline-sky-600 transition-colors ${
                currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                  ? 'text-sky-600 font-semibold'
                  : 'text-slate-700'
              }`}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <a
        href="/request-demo"
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs md:text-sm font-semibold text-white bg-sky-600 hover:bg-sky-500 rounded-lg shadow-xs transition-colors whitespace-nowrap focus-visible:outline-sky-600"
      >
        Request Demo
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-slate-700 hover:text-sky-600 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Buka menu navigasi"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 shadow-lg transition-all"
  >
    <nav class="space-y-1">
      <a
        href="/about-us"
        class={`block px-3 py-2.5 rounded-lg text-sm font-medium ${
          currentPath === '/about-us' ? 'bg-sky-50 text-sky-600 font-semibold' : 'text-slate-700 hover:bg-slate-50'
        }`}
      >
        About Us
      </a>

      <!-- Mobile Accordion for Products -->
      <div class="py-1">
        <div class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-slate-400">
          Produk Enterprise
        </div>
        <div class="pl-2 space-y-1">
          <a
            href="/products/nanonets"
            class={`block px-3 py-2 rounded-lg text-xs font-medium ${
              currentPath === '/products/nanonets' ? 'bg-sky-50 text-sky-600 font-semibold' : 'text-slate-600 hover:bg-slate-50'
            }`}
          >
            Nanonets (AI OCR)
          </a>
          <a
            href="/products/cyclone"
            class={`block px-3 py-2 rounded-lg text-xs font-medium ${
              currentPath === '/products/cyclone' ? 'bg-sky-50 text-sky-600 font-semibold' : 'text-slate-600 hover:bg-slate-50'
            }`}
          >
            Cyclone (RPA)
          </a>
          <a
            href="/products/docuflo"
            class={`block px-3 py-2 rounded-lg text-xs font-medium ${
              currentPath === '/products/docuflo' ? 'bg-sky-50 text-sky-600 font-semibold' : 'text-slate-600 hover:bg-slate-50'
            }`}
          >
            Docuflo (DMS)
          </a>
          <a
            href="/products/syclus"
            class={`block px-3 py-2 rounded-lg text-xs font-medium ${
              currentPath === '/products/syclus' ? 'bg-sky-50 text-sky-600 font-semibold' : 'text-slate-600 hover:bg-slate-50'
            }`}
          >
            Syclus (ITSM)
          </a>
          <a
            href="/products/spensify"
            class={`block px-3 py-2 rounded-lg text-xs font-medium ${
              currentPath === '/products/spensify' ? 'bg-sky-50 text-sky-600 font-semibold' : 'text-slate-600 hover:bg-slate-50'
            }`}
          >
            Spensify (Expense)
          </a>
        </div>
      </div>

      <a
        href="/articles"
        class={`block px-3 py-2.5 rounded-lg text-sm font-medium ${
          currentPath.startsWith('/articles') ? 'bg-sky-50 text-sky-600 font-semibold' : 'text-slate-700 hover:bg-slate-50'
        }`}
      >
        Articles
      </a>

      <div class="pt-3">
        <a
          href="/request-demo"
          class="block w-full text-center py-2.5 px-4 bg-sky-600 hover:bg-sky-500 text-white font-semibold text-sm rounded-lg shadow-xs transition-colors"
        >
          Request Demo Gratis
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close mobile menu on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.focus();
      }
    });
  }
</script>
