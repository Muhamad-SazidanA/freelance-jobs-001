---
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/solusiaplikasi/',
    path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/solusi-aplikasi-integrasi',
    path: 'M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.65 1.65 0 1 0 0-3.3 1.65 1.65 0 0 0 0 3.3m1.4 9.74v-8.37H5.06v8.37h2.8z',
  },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@solusiaplikasiintegrasi',
    path: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
];

const menuLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Articles', href: '/articles' },
  { label: 'Request Demo', href: '/request-demo' },
];

const productLinks = [
  { label: 'Nanonets', href: '/products/nanonets' },
  { label: 'Cyclone', href: '/products/cyclone' },
  { label: 'Docuflo', href: '/products/docuflo' },
  { label: 'Syclus', href: '/products/syclus' },
  { label: 'Spensify', href: '/products/spensify' },
];
---

<footer class="site-footer relative overflow-hidden bg-[#070b14] text-white pt-14 pb-8 border-t border-slate-800/60">
  <!-- Subtle background glow decoration -->
  <div class="pointer-events-none absolute -top-24 -left-24 w-96 h-96 rounded-full bg-blue-500/5 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-indigo-500/5 blur-3xl"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row justify-between items-start gap-10 lg:gap-12">

      <!-- ===================================================================
           LEFT COLUMN: COMPANY & CONTACT INFO
           =================================================================== -->
      <div class="w-full lg:max-w-md">
        <!-- Company Heading (Setara dengan Menu dan Product) -->
        <h4 class="text-sm sm:text-base font-bold text-white tracking-wide mb-4">
          Company
        </h4>

        <!-- Address & Contact Details -->
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300 leading-relaxed font-normal">
          <li class="flex items-start gap-2">
            <span>Block 21, Jl. Siantar No.18, Cideng, Kecamatan Gambir<br/>Kota Jakarta Pusat, DKI Jakarta 10150</span>
          </li>
          <li class="pt-1">
            <strong class="text-white font-semibold">WhatsApp:</strong>{' '}
            <a
              href="https://wa.me/6282110009519?text=Halo%20PT%20Solusi%20Aplikasi%20Integrasi%20(SAI)%2C%20saya%20tertarik%20dengan%20solusi%20IT%20dan%20layanan%20Anda.%20Mohon%20info%20lebih%20lanjut."
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline hover:text-white transition-colors text-slate-300"
            >
              +62 821-1000-9519
            </a>
          </li>
          <li>
            <strong class="text-white font-semibold">Phone:</strong>{' '}
            <a href="tel:+62213505050" class="hover:underline hover:text-white transition-colors text-slate-300">
              (021) 3505050
            </a>
          </li>
          <li>
            <strong class="text-white font-semibold">Email:</strong>{' '}
            <a href="mailto:sales@solusiaplikasi.id" class="hover:underline hover:text-white transition-colors text-slate-300">
              sales@solusiaplikasi.id
            </a>
          </li>
          <li class="text-slate-400 text-xs pt-1">
            Senin - Jumat (09.00 - 17.00 WIB)
          </li>
        </ul>

        <div class="flex items-center gap-2.5 pt-4">
          {socialLinks.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${item.name} PT Solusi Aplikasi Integrasi`}
              class="w-9 h-9 rounded-full border border-slate-700/80 bg-slate-800/60 hover:bg-[#3a5ae8] hover:border-[#3a5ae8] text-slate-300 hover:text-white flex items-center justify-center transition-all duration-200 active:scale-95 shadow-xs"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d={item.path}/>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- ===================================================================
           RIGHT COLUMN: MENU (HEADER ITEMS) & PRODUCT (PRODUCT ITEMS)
           =================================================================== -->
      <div class="w-full lg:w-auto">
        <div class="flex flex-row justify-between sm:justify-start gap-10 sm:gap-16 lg:gap-20">

          <!-- 1. Menu (Semua Item di Header) -->
          <div class="min-w-[120px]">
            <h4 class="text-sm sm:text-base font-bold text-white tracking-wide mb-4">
              Menu
            </h4>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300">
              {menuLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-block hover:text-white hover:translate-x-1 transition-all duration-200"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- 2. Product (Semua Produk di Submenu Header) -->
          <div class="min-w-[160px]">
            <h4 class="text-sm sm:text-base font-bold text-white tracking-wide mb-4">
              Product
            </h4>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300">
              {productLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-block hover:text-white hover:translate-x-1 transition-all duration-200"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>

    </div>

    <!-- ===================================================================
         BOTTOM BAR: COPYRIGHT
         =================================================================== -->
    <div class="border-t border-slate-800/80 mt-12 pt-6 text-center text-xs text-slate-400">
      <p>&copy; {currentYear} PT Solusi Aplikasi Integrasi. All Rights Reserved.</p>
    </div>
  </div>
</footer>
