---
// src/components/common/Footer.astro
// Global Footer Component - Vibrant Blue Enterprise Theme (Matching Image 1)

const currentYear = new Date().getFullYear();

const menuLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Produk', href: '/products/nanonets' },
  { label: 'Articles', href: '/articles' },
  { label: 'Request Demo', href: '/request-demo' },
];

const productLinks = [
  { label: 'Nanonets (AI OCR)', href: '/products/nanonets' },
  { label: 'Cyclone (RPA)', href: '/products/cyclone' },
  { label: 'Docuflo (DMS)', href: '/products/docuflo' },
  { label: 'Syclus (ITSM)', href: '/products/syclus' },
  { label: 'Spensify (Expense)', href: '/products/spensify' },
];
---

<footer class="site-footer relative overflow-hidden bg-gradient-to-r from-[#0062e0] via-[#006bf5] to-[#0052cc] text-white pt-14 pb-8 border-t border-sky-400/20">
  <!-- Subtle background glow decoration -->
  <div class="pointer-events-none absolute -top-24 -left-24 w-96 h-96 rounded-full bg-white/5 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-cyan-400/10 blur-3xl"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-8 sm:px-12 lg:px-16">
    <div class="flex flex-col lg:flex-row justify-between items-start gap-10 lg:gap-12">

      <!-- ===================================================================
           LEFT COLUMN: COMPANY & CONTACT INFO (Matching Image 1)
           =================================================================== -->
      <div class="w-full lg:max-w-md">
        <!-- Company Heading (Setara dengan Menu dan Product) -->
        <h4 class="text-sm sm:text-base font-bold text-white tracking-wide mb-4">
          Company
        </h4>

        <!-- Address & Contact Details -->
        <ul class="space-y-2.5 text-xs sm:text-sm text-white/90 leading-relaxed font-normal">
          <li class="flex items-start gap-2">
            <span>Jl. Siantar No.18, Cideng, Gambir<br/>Jakarta Pusat, DKI Jakarta 10150</span>
          </li>
          <li class="pt-1">
            <strong class="text-white font-semibold">WhatsApp:</strong>{' '}
            <a
              href="https://wa.me/6282110009519?text=Halo%20PT%20Solusi%20Aplikasi%20Integrasi%20(SAI)%2C%20saya%20tertarik%20dengan%20solusi%20IT%20dan%20layanan%20Anda.%20Mohon%20info%20lebih%20lanjut."
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline hover:text-white transition-colors"
            >
              +62 821-1000-9519
            </a>
          </li>
          <li>
            <strong class="text-white font-semibold">Phone:</strong>{' '}
            <a href="tel:+62213506050" class="hover:underline hover:text-white transition-colors">
              +62 21 350-6050 (Hunting)
            </a>
          </li>
          <li>
            <strong class="text-white font-semibold">Email:</strong>{' '}
            <a href="mailto:sales@solusiaplikasi.id" class="hover:underline hover:text-white transition-colors">
              sales@solusiaplikasi.id
            </a>
          </li>
          <li class="text-white/80 text-xs pt-1">
            Senin - Jumat (09.00 - 17.00 WIB)
          </li>
        </ul>

        <!-- Social Media Icons (Circular White Outlined Buttons matching Image 1) -->
        <div class="flex items-center gap-2.5 pt-2">
          <!-- Facebook -->
          <a
            href="https://facebook.com/solusiaplikasi.id"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook SolusiAplikasi.id"
            class="w-9 h-9 rounded-full border border-white/40 bg-white/10 hover:bg-white hover:text-[#0062e0] text-white flex items-center justify-center transition-all duration-200 active:scale-95 shadow-xs"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="https://instagram.com/solusiaplikasi.id"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram SolusiAplikasi.id"
            class="w-9 h-9 rounded-full border border-white/40 bg-white/10 hover:bg-white hover:text-[#0062e0] text-white flex items-center justify-center transition-all duration-200 active:scale-95 shadow-xs"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://linkedin.com/company/solusi-aplikasi-integrasi"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn SolusiAplikasi.id"
            class="w-9 h-9 rounded-full border border-white/40 bg-white/10 hover:bg-white hover:text-[#0062e0] text-white flex items-center justify-center transition-all duration-200 active:scale-95 shadow-xs"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.65 1.65 0 1 0 0-3.3 1.65 1.65 0 0 0 0 3.3m1.4 9.74v-8.37H5.06v8.37h2.8z"/>
            </svg>
          </a>

          <!-- Twitter / X -->
          <a
            href="https://twitter.com/solusiaplikasi"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter / X SolusiAplikasi.id"
            class="w-9 h-9 rounded-full border border-white/40 bg-white/10 hover:bg-white hover:text-[#0062e0] text-white flex items-center justify-center transition-all duration-200 active:scale-95 shadow-xs"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- ===================================================================
           RIGHT COLUMN: MENU (HEADER ITEMS) & PRODUCT (PRODUCT ITEMS)
           =================================================================== -->
      <div class="w-full lg:w-auto">
        <div class="flex flex-row justify-between sm:justify-start gap-10 sm:gap-16 lg:gap-20">

          <!-- 1. Menu (Semua Item di Header) -->
          <div class="min-w-[120px]">
            <h4 class="text-sm sm:text-base font-bold text-white tracking-wide mb-4">
              Menu
            </h4>
            <ul class="space-y-2.5 text-xs sm:text-sm text-white/85">
              {menuLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-block hover:text-white hover:translate-x-1 transition-all duration-200"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- 2. Product (Semua Produk di Submenu Header) -->
          <div class="min-w-[160px]">
            <h4 class="text-sm sm:text-base font-bold text-white tracking-wide mb-4">
              Product
            </h4>
            <ul class="space-y-2.5 text-xs sm:text-sm text-white/85">
              {productLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-block hover:text-white hover:translate-x-1 transition-all duration-200"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>

    </div>

    <!-- ===================================================================
         BOTTOM BAR: COPYRIGHT
         =================================================================== -->
    <div class="border-t border-white/20 mt-12 pt-6 text-center text-xs text-white/75">
      <p>&copy; {currentYear} PT Solusi Aplikasi Integrasi. All Rights Reserved.</p>
    </div>
  </div>
</footer>
