---
interface Props {
  src: string;
  alt: string;
  align?: 'center' | 'left';
  framed?: boolean;
  heightClass?: string;
}

const {
  src,
  alt,
  align = 'center',
  framed = false,
  heightClass = 'h-9 sm:h-10 md:h-11',
} = Astro.props;

const alignClass = align === 'center' ? 'justify-center mx-auto' : 'justify-start';
---

<div class={`flex items-center mb-6 sm:mb-7 ${alignClass}`}>
  {framed ? (
    <div class="inline-flex items-center justify-center rounded-xl bg-white/95 px-4 py-2 sm:px-5 sm:py-2.5 shadow-lg shadow-black/20 border border-white/30">
      <img
        src={src}
        alt={alt}
        class={`${heightClass} w-auto object-contain select-none pointer-events-none block`}
        loading="eager"
        decoding="async"
      />
    </div>
  ) : (
    <img
      src={src}
      alt={alt}
      class={`${heightClass} w-auto object-contain select-none pointer-events-none block`}
      loading="eager"
      decoding="async"
    />
  )}
</div>
