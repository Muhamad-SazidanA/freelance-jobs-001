---
interface Props {
  phoneNumber?: string;
  message?: string;
  placement?: string;
}

const {
  phoneNumber = '6282110009519',
  message = 'Halo PT Solusi Aplikasi Integrasi (SAI), saya tertarik dengan solusi IT dan layanan Anda. Mohon info lebih lanjut.',
  placement = 'floating_button',
} = Astro.props;

const encodedMessage = encodeURIComponent(message);
const waUrl = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;
---

<a
  href={waUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-40 bg-[#25D366] hover:bg-[#20ba5a] text-white w-12 h-12 sm:w-auto p-0 sm:px-4 sm:py-2.5 rounded-full shadow-lg shadow-emerald-950/20 flex items-center justify-center sm:gap-2 text-sm font-semibold transition-all hover:scale-105 active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500"
  aria-label="Konsultasi via WhatsApp"
  data-placement={placement}
  id="whatsapp-direct-btn"
>
  <svg class="w-6 h-6 sm:w-5 sm:h-5 fill-white shrink-0" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12.01 2.003C6.488 2.003 2.008 6.483 2.008 12.005c0 1.905.534 3.688 1.458 5.215L2 22l4.929-1.428a9.96 9.96 0 0 0 5.081 1.433h.005c5.52 0 10-4.48 10-10.002 0-5.522-4.48-10.002-10.005-10.002zm5.836 14.198c-.244.688-1.417 1.315-1.954 1.399-.519.08-1.157.115-3.454-.837-2.693-1.116-4.453-3.8-4.59-3.98-.133-.183-1.082-1.44-1.082-2.744 0-1.302.68-1.942.92-2.203.243-.26.531-.325.707-.325.176 0 .353.002.508.01.164.008.384-.062.6.458.225.541.768 1.874.836 2.012.068.138.113.298.022.479-.09.18-.135.293-.267.452-.132.16-.279.356-.399.478-.133.134-.272.28-.117.546.155.267.688 1.135 1.474 1.837 1.012.902 1.866 1.181 2.132 1.314.267.133.422.112.578-.067.155-.18.665-.776.842-1.043.177-.267.354-.222.598-.133.244.09 1.55.731 1.816.864.266.134.443.2.51.311.066.112.066.643-.178 1.33z"/>
  </svg>
  <span class="hidden sm:inline">WhatsApp</span>
</a>

<script>
  import { trackWhatsAppClick } from '@/lib/analytics';

  function initWhatsAppTrack() {
    const waBtn = document.getElementById('whatsapp-direct-btn');
    if (!waBtn || (waBtn as any).__waInitialized) return;
    (waBtn as any).__waInitialized = true;

    waBtn.addEventListener('click', () => {
      const placement = waBtn.getAttribute('data-placement') || 'floating';
      trackWhatsAppClick(window.location.href, placement);
    });
  }

  document.addEventListener('DOMContentLoaded', initWhatsAppTrack);
  document.addEventListener('astro:page-load', initWhatsAppTrack);
  initWhatsAppTrack();
</script>
