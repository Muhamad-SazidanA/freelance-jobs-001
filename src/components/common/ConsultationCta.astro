---
// src/components/common/ConsultationCta.astro
// Reusable CTA Template Component — Pure Astro + Vanilla JS
// Visual 100% Matching Reference Image: Enterprise Skyline Banner + Dual Action Form

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  imageSrc?: string;
  imageAlt?: string;
  badge?: string;
  badgeSubtitle?: string;
  defaultProduct?: 'nanonets' | 'cyclone' | 'docuflo' | 'syclus' | 'spensify' | 'multi' | string;
  primaryButtonText?: string;
  whatsappButtonText?: string;
  whatsappMessage?: string;
  whatsappNumber?: string;
  class?: string;
  bgClass?: string;
}

const {
  id = "form-konsultasi",
  title = "Jalankan Bisnis Anda dengan Performa Maksimal",
  subtitle = "Tim konsultan kami siap menganalisis alur kerja perusahaan Anda dan mendemonstrasikan implementasi solusi terbaik secara langsung.",
  imageSrc = "/images/home/home-city-banner.jpg",
  imageAlt = "Jalankan Bisnis Anda dengan Performa Maksimal",
  badge = "ENTERPRISE READY",
  badgeSubtitle = "Solusi Teruji Skala Nasional",
  defaultProduct = "",
  primaryButtonText = "Request Demo Gratis",
  whatsappButtonText = "Dapatkan Konsultasi Gratis",
  whatsappMessage = "Halo PT Solusi Aplikasi Integrasi (SAI), saya tertarik dengan solusi IT dan layanan Anda. Mohon info lebih lanjut.",
  whatsappNumber = "6282110009519",
  class: className = "",
  bgClass = "bg-white",
} = Astro.props;

// Unique identifier to avoid DOM collisions across multiple instances
const instanceId = `cta-${Math.random().toString(36).substring(2, 8)}`;
---

<section id={id} class={`py-14 md:py-20 ${bgClass} ${className}`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

      <!-- Left Column: City Skyline Banner -->
      <div class="lg:col-span-5 flex items-center justify-center">
        <div class="relative w-full rounded-2xl md:rounded-3xl overflow-hidden shadow-sm border border-slate-200/80 bg-slate-900 aspect-square group">
          <img
            src={imageSrc}
            alt={imageAlt}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-102"
            loading="eager"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent flex items-end p-6">
            <div class="text-white">
              <div class="text-[11px] font-bold uppercase tracking-wider text-sky-400 mb-0.5">{badge}</div>
              <div class="text-sm sm:text-base font-bold leading-snug">{badgeSubtitle}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Consultation Form -->
      <div class="lg:col-span-7">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight">
          {title}
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2 mb-6 leading-relaxed">
          {subtitle}
        </p>

        <form data-cta-form={instanceId} class="space-y-3">
          <!-- Honeypot for Bot Protection -->
          <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

          <!-- Full Name -->
          <div>
            <input
              type="text"
              name="name"
              required
              placeholder="Nama Lengkap Anda *"
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all shadow-xs"
            />
          </div>

          <!-- Phone & Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="flex rounded-lg border border-slate-200 overflow-hidden focus-within:border-sky-500 focus-within:ring-1 focus-within:ring-sky-500 bg-white shadow-xs">
              <span class="px-3 py-2.5 bg-slate-50 text-slate-500 text-xs sm:text-sm border-r border-slate-200 flex items-center font-medium select-none shrink-0">
                ID +62
              </span>
              <input
                type="tel"
                name="phone"
                required
                placeholder="812-3456-7890 *"
                class="w-full px-3 py-2.5 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none bg-transparent"
              />
            </div>

            <div>
              <input
                type="email"
                name="email"
                required
                placeholder="Email Perusahaan Anda *"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all shadow-xs"
              />
            </div>
          </div>

          <!-- Product & Industry Selects -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <select
                name="product"
                required
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-xs sm:text-sm text-slate-700 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all shadow-xs"
              >
                <option value="" disabled selected={!defaultProduct}>Pilih Solusi Produk *</option>
                <option value="nanonets" selected={defaultProduct === 'nanonets'}>Nanonets - AI OCR &amp; IDP</option>
                <option value="cyclone" selected={defaultProduct === 'cyclone'}>Cyclone - Robotic Process Automation</option>
                <option value="docuflo" selected={defaultProduct === 'docuflo'}>Docuflo - Document Management System</option>
                <option value="syclus" selected={defaultProduct === 'syclus'}>Syclus - IT Service &amp; Asset Management</option>
                <option value="spensify" selected={defaultProduct === 'spensify'}>Spensify - Corporate Expense Management</option>
                <option value="multi" selected={defaultProduct === 'multi'}>Konsultasi Solusi Multi-Platform</option>
              </select>
            </div>

            <div>
              <select
                name="industry"
                required
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-xs sm:text-sm text-slate-700 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all shadow-xs"
              >
                <option value="" disabled selected>Pilih Sektor Industri *</option>
                <option value="banking">Perbankan &amp; Lembaga Keuangan</option>
                <option value="insurance">Asuransi &amp; FinTech</option>
                <option value="logistics">Logistik &amp; Supply Chain</option>
                <option value="manufacturing">Manufaktur &amp; Distribusi</option>
                <option value="healthcare">Kesehatan &amp; Farmasi</option>
                <option value="retail">Ritel &amp; E-Commerce</option>
                <option value="government">Pemerintahan &amp; BUMN</option>
                <option value="other">Industri Lainnya</option>
              </select>
            </div>
          </div>

          <!-- Scale & Timeline Selects -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <select
                name="scale"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-xs sm:text-sm text-slate-700 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all shadow-xs"
              >
                <option value="" disabled selected>Skala Perusahaan / Pengguna</option>
                <option value="1-50">1 - 50 Karyawan</option>
                <option value="51-250">51 - 250 Karyawan</option>
                <option value="251-1000">251 - 1.000 Karyawan</option>
                <option value="1000+">&gt; 1.000 Karyawan (Enterprise)</option>
              </select>
            </div>

            <div>
              <select
                name="timeline"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-xs sm:text-sm text-slate-700 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all shadow-xs"
              >
                <option value="" disabled selected>Target Waktu Implementasi</option>
                <option value="urgent">Segera (&lt; 1 Bulan)</option>
                <option value="medium">1 - 3 Bulan</option>
                <option value="long">3 - 6 Bulan</option>
                <option value="explore">Riset / Eksplorasi Tahap Awal</option>
              </select>
            </div>
          </div>

          <!-- Needs / Message -->
          <div>
            <textarea
              name="message"
              rows="3"
              placeholder="Ceritakan kebutuhan otomatisasi atau integrasi sistem yang ingin dicapai perusahaan Anda..."
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all shadow-xs resize-y"
            ></textarea>
          </div>

          <!-- Submission Feedback Status -->
          <div data-cta-status class="hidden p-3 rounded-lg text-xs leading-relaxed" role="alert"></div>

          <!-- Dual Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
            <button
              type="submit"
              data-cta-submit
              class="w-full sm:flex-1 py-3 px-5 rounded-lg bg-[#0084d1] hover:bg-[#0074b8] active:bg-[#00639e] text-white font-bold text-xs sm:text-sm shadow-xs transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>{primaryButtonText}</span>
            </button>

            <button
              type="button"
              data-cta-wa
              data-wa-number={whatsappNumber}
              data-wa-default-msg={whatsappMessage}
              class="w-full sm:flex-1 py-3 px-5 rounded-lg bg-[#f95700] hover:bg-[#e04f00] active:bg-[#c74600] text-white font-bold text-xs sm:text-sm shadow-xs transition-all flex items-center justify-center gap-2 cursor-pointer text-center"
            >
              <span>{whatsappButtonText}</span>
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</section>

<!-- Reusable Client Script for Consultation CTA Instances -->
<script is:inline>
  if (!window.__consultationCtaInitialized) {
    window.__consultationCtaInitialized = true;

    document.addEventListener('DOMContentLoaded', function () {
      const forms = document.querySelectorAll('form[data-cta-form]');

      forms.forEach(function (form) {
        const statusBox = form.querySelector('[data-cta-status]');
        const submitBtn = form.querySelector('[data-cta-submit]');
        const waBtn = form.querySelector('[data-cta-wa]');

        // Direct WhatsApp Click Handler
        if (waBtn) {
          waBtn.addEventListener('click', function () {
            const nameInput = form.querySelector('input[name="name"]');
            const productSelect = form.querySelector('select[name="product"]');
            const messageText = form.querySelector('textarea[name="message"]');

            const name = nameInput ? nameInput.value.trim() : '';
            const product = productSelect && productSelect.value ? productSelect.options[productSelect.selectedIndex].text : '';
            const msg = messageText ? messageText.value.trim() : '';

            let waText = waBtn.getAttribute('data-wa-default-msg') || 'Halo PT Solusi Aplikasi Integrasi (SAI), saya tertarik dengan solusi IT dan layanan Anda. Mohon info lebih lanjut.';
            if (name) waText += `\n\nNama: ${name}`;
            if (product) waText += `\nProduk: ${product}`;
            if (msg) waText += `\nKebutuhan: ${msg}`;

            const phoneNum = waBtn.getAttribute('data-wa-number') || '6282110009519';
            const waUrl = `https://wa.me/${phoneNum}?text=${encodeURIComponent(waText)}`;
            window.open(waUrl, '_blank', 'noopener,noreferrer');
          });
        }

        // Form Submit Handler
        form.addEventListener('submit', async function (e) {
          e.preventDefault();

          const name = form.querySelector('input[name="name"]')?.value.trim();
          const phone = form.querySelector('input[name="phone"]')?.value.trim();
          const email = form.querySelector('input[name="email"]')?.value.trim();
          const productSelect = form.querySelector('select[name="product"]');
          const product = productSelect ? productSelect.value : '';
          const productLabel = productSelect && productSelect.selectedIndex >= 0 ? productSelect.options[productSelect.selectedIndex].text : '';
          const industrySelect = form.querySelector('select[name="industry"]');
          const industry = industrySelect ? industrySelect.value : '';
          const industryLabel = industrySelect && industrySelect.selectedIndex >= 0 ? industrySelect.options[industrySelect.selectedIndex].text : '';
          const messageText = form.querySelector('textarea[name="message"]')?.value.trim() || '';

          if (!name || !phone || !email || !product || !industry) {
            if (statusBox) {
              statusBox.className = 'p-3 rounded-lg text-xs leading-relaxed bg-amber-50 border border-amber-200 text-amber-800 block';
              statusBox.textContent = 'Mohon lengkapi semua kolom yang bertanda bintang (*).';
            }
            return;
          }

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = `
              <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span>Memproses Permintaan...</span>
            `;
          }

          // Save to localStorage for Admin Dashboard
          try {
            const stored = localStorage.getItem('solusi_leads_data');
            const leads = stored ? JSON.parse(stored) : [];
            leads.unshift({
              id: `lead-${Date.now()}`,
              name: name,
              email: email,
              phone: phone,
              company: industryLabel || 'Enterprise',
              position: 'Lead Web CTA',
              requirements: `[Produk: ${productLabel}] ${messageText}`,
              message: `[Industri: ${industryLabel}] [Produk: ${productLabel}] ${messageText}`,
              sourceUrl: window.location.href,
              createdAt: new Date().toISOString(),
              status: 'Baru',
            });
            localStorage.setItem('solusi_leads_data', JSON.stringify(leads));
          } catch (err) {
            console.warn('Failed to store lead in localStorage:', err);
          }

          // Send Lead Notification to sales@solusiaplikasi.id
          try {
            const restEndpoint = 'https://solusiaplikasi.id/solution/wp-json/solusi/v1/lead';
            const wpRes = await fetch(restEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: name,
                email: email,
                phone: phone,
                company: industryLabel,
                position: 'Lead Web CTA',
                requirements: `[Produk: ${productLabel}] ${messageText}`,
                sourceUrl: window.location.href,
              }),
            });
            if (!wpRes.ok) throw new Error('WP REST fallback');
          } catch {
            // Fallback delivery via FormSubmit to sales@solusiaplikasi.id
            try {
              await fetch('https://formsubmit.co/ajax/sales@solusiaplikasi.id', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                  _subject: `[Lead CTA Baru] ${name} - ${productLabel}`,
                  _template: 'table',
                  _captcha: 'false',
                  Nama: name,
                  Email: email,
                  'No. WhatsApp': phone,
                  Produk: productLabel,
                  Industri: industryLabel,
                  Pesan: messageText || '-',
                  'Halaman Sumber': window.location.href,
                }),
              });
            } catch (fallbackErr) {
              console.warn('Fallback error:', fallbackErr);
            }
          }

          if (statusBox) {
            statusBox.className = 'p-3.5 rounded-lg text-xs leading-relaxed bg-emerald-50 border border-emerald-200 text-emerald-800 block';
            statusBox.innerHTML = `
              <strong>Terima kasih, ${name}!</strong> Terima kasih, tim konsultan kami akan menghubungi Anda 1x24 jam.
            `;
          }

          form.reset();

          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = `<span>Request Demo Gratis</span>`;
          }
        });
      });
    });
  }
</script>
