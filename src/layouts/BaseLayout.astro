---
import SeoHead from '@/components/seo/SeoHead.astro';
import CookieConsent from '@/components/common/CookieConsent';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown> | null | undefined>;
  htmlClass?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex,
  schema,
  htmlClass = '',
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="id" class={htmlClass || undefined}>
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      schema={schema}
    />
    <!-- Google Fonts: Plus Jakarta Sans for crisp enterprise typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Cloudflare Turnstile explicit script -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <!-- Astro ClientRouter for Instant Zero-Reload Transitions -->
    <ClientRouter />
    <!-- Background Image Preloader for Instant Page Switching -->
    <script is:inline>
      (function() {
        const criticalImages = [
          '/images/LogoHeader.png',
          '/images/home/Banner_Home.webp',
          '/images/product/nanonets/Hasil_Ekstraksi.webp',
          '/images/product/cyclone/cyclone-dashboard-real.webp',
          '/images/product/cyclone/Bg-Cyclone.webp',
          '/images/product/docuflo/docuflo-dashboard.webp',
          '/images/product/syclus/Syclus-Dashboard.webp',
          '/images/product/syclus/syclus-hero-stat.webp',
          '/images/product/spensify/spensify-dashboard.webp',
          '/images/product/spensify/feature-shot.webp',
          '/images/product/spensify/cegar-overstanding.webp',
          '/images/product/spensify/deteksi-struck-duplikat.webp',
          '/images/product/spensify/showcase-media-klaim-terpusat.webp',
          '/images/about-us/Solution-About.webp',
          '/images/articles/sai-insights-hero.jpg'
        ];

        function preloadKeyImages() {
          if (window.__keyImagesPreloaded) return;
          window.__keyImagesPreloaded = true;
          criticalImages.forEach(function(src) {
            const img = new Image();
            img.decoding = 'async';
            img.src = src;
          });
        }

        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(preloadKeyImages, { timeout: 1500 });
        } else {
          window.addEventListener('load', function() {
            setTimeout(preloadKeyImages, 400);
          });
        }
      })();
    </script>
  </head>
  <body class={`bg-white text-slate-900 min-h-screen flex flex-col font-sans ${bodyClass}`.trim()}>
    <slot />
    <!-- Lightweight Cookie Consent Island (client:idle) -->
    <CookieConsent client:idle />
    <script>
      function getStickyHeaderHeight(): number {
        const header = document.querySelector('header.site-header');
        if (!header) return 0;
        const pos = getComputedStyle(header).position;
        if (pos !== 'sticky' && pos !== 'fixed') return 0;
        return Math.round(header.getBoundingClientRect().height);
      }

      function computeAlignedScrollY(targetEl: HTMLElement): number {
        const headerHeight = getStickyHeaderHeight();
        const alignMode =
          targetEl.getAttribute('data-scroll-align') ||
          (targetEl.hasAttribute('data-cta-section') ? 'center' : 'section-top');
        const focusEl =
          (targetEl.querySelector('[data-scroll-target], [data-cta-card]') as HTMLElement | null) ||
          targetEl;

        if (alignMode === 'center') {
          const rect = focusEl.getBoundingClientRect();
          const usableHeight = Math.max(200, window.innerHeight - headerHeight);
          const topOffset = Math.max(24, (usableHeight - rect.height) / 2);
          return Math.max(0, Math.round(window.scrollY + rect.top - headerHeight - topOffset));
        }

        if (alignMode === 'content-top') {
          const rect = focusEl.getBoundingClientRect();
          const contentGap = window.innerWidth < 640 ? 20 : 28;
          return Math.max(0, Math.round(window.scrollY + rect.top - headerHeight - contentGap));
        }

        const secRect = targetEl.getBoundingClientRect();
        const padTop = parseFloat(getComputedStyle(targetEl).paddingTop) || 0;
        const minVisualGap = padTop < 24 ? Math.max(0, 28 - padTop) : 0;
        return Math.max(0, Math.round(window.scrollY + secRect.top - headerHeight - minVisualGap));
      }

      function scrollToHashTarget(targetId: string): boolean {
        if (!targetId) return false;
        const targetEl = document.getElementById(targetId);
        if (!targetEl) return false;
        const targetY = computeAlignedScrollY(targetEl);
        window.scrollTo({
          top: targetY,
          behavior: 'smooth',
        });
        return true;
      }

      function normalizePath(p: string): string {
        return p.replace(/\/+$/, '') || '/';
      }

      function bindGlobalAnchorScrolling() {
        const w = window as unknown as { __globalAnchorScrollBound?: boolean };
        if (!w.__globalAnchorScrollBound) {
          w.__globalAnchorScrollBound = true;
          document.addEventListener('click', (e) => {
            const anchor = e.target instanceof Element ? e.target.closest('a[href]') : null;
            if (!anchor) return;
            const href = anchor.getAttribute('href') || '';
            if (!href.includes('#')) return;
            let url: URL;
            try {
              url = new URL(href, window.location.href);
            } catch {
              return;
            }
            if (
              normalizePath(url.pathname) !== normalizePath(window.location.pathname) ||
              !url.hash
            ) {
              return;
            }
            const targetId = decodeURIComponent(url.hash.slice(1));
            if (scrollToHashTarget(targetId)) {
              e.preventDefault();
              if (window.location.hash !== url.hash) {
                history.pushState(null, '', url.hash);
              }
            }
          });

          window.addEventListener('hashchange', () => {
            const idFromHash = decodeURIComponent(window.location.hash.slice(1));
            if (idFromHash) scrollToHashTarget(idFromHash);
          });
        }

        const initialHash = decodeURIComponent(window.location.hash.slice(1));
        if (initialHash) {
          requestAnimationFrame(() => {
            setTimeout(() => {
              scrollToHashTarget(initialHash);
            }, 60);
          });
        }
      }

      document.addEventListener('DOMContentLoaded', bindGlobalAnchorScrolling);
      document.addEventListener('astro:page-load', bindGlobalAnchorScrolling);
      bindGlobalAnchorScrolling();
    </script>
  </body>
</html>
